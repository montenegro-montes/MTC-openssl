#!/usr/bin/env bash
# Manual coordinator only: scientific source, fixtures and outputs remain immutable.
set -euo pipefail
REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$REPO"
source "$REPO/bin/lib/docker-preflight.sh"
STATE=${MT_CERT_SCALING_STATE:-"$REPO/.mt-state/cert-scaling"}
CONFIG="$STATE/paths.env"
CHAIN=campaigns/scaling/cert_chain_scaling
MTC=campaigns/scaling/mtc_profile_scaling/workflow.py
STEPS=(10.environment 20.x509-generate 30.x509-validate 40.mtc-build 50.mtc-n16 60.mtc-validate 80.crossover 85.crossover-html 90.audit 95.mtc-all-sizes 100.cross-advanced 102.crossover-boundary-audit 105.advanced-crossover-html 110.tls-depth-validation 120.mutual-auth-crossover 122.mutual-crossover-exact 124.mutual-boundary-audit 125.mutual-crossover-html)
DEFAULT_STEPS=(10.environment 20.x509-generate 30.x509-validate 40.mtc-build 50.mtc-n16 60.mtc-validate 80.crossover 85.crossover-html 90.audit)
fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
configure_kem() { case "${1:-1}" in 1|x25519) KEM=x25519;KEM_LABEL=X25519;KEM_GROUP=X25519;KEM_SLUG=x25519;; 2|x25519-mlkem512) KEM=x25519-mlkem512;KEM_LABEL=X25519+ML-KEM512;KEM_GROUP=x25519_mlkem512;KEM_SLUG=x25519-mlkem512;; 3|mlkem512) KEM=mlkem512;KEM_LABEL=ML-KEM-512;KEM_GROUP=mlkem512;KEM_SLUG=mlkem512;; *) fail 'KEM must be 1/x25519, 2/x25519-mlkem512 or 3/mlkem512.';; esac; export KEM KEM_LABEL KEM_GROUP KEM_SLUG MTC_KEM_ID="$KEM" MTC_KEM_LABEL="$KEM_LABEL" MTC_TLS_GROUP="$KEM_GROUP"; }
select_kem() { local value; printf 'Key establishment:\n  1 X25519 (default)\n  2 X25519+ML-KEM512\n  3 ML-KEM-512\n' >&2; read -r -p '> ' value || value=1; configure_kem "${value:-1}"; }
usage() {
 cat <<'HELP'
Usage: bin/cryptographic_scaling/mt-cert-scaling [COMMAND]
  menu                      interactive menu (default)
  prepare                   open the independent prerequisites menu
  init [NAME]              save paths without running or generating fixtures
  new [NAME]               archive current configuration and select fresh paths
  status                    paths, stages and certificate progress
  list                      available stages (95, 100, 102, 105, 110 and 120–125 are optional)
  show STAGE                print a command without executing it
  run STAGE                 execute one stage and save its log
  run --count X             execute the next X pending N=16 workflow stages
  run ALL                   execute pending stages 10–60, 80 and 90; stop on failure
  set VARIABLE PATH         select an input path or a fresh output path

Variables: CHAIN_FIXTURES CHAIN_VALID ENVIRONMENT SUPPORT MTC16 MTC_VALID
           MTC_ALL STATIC_ROOT AUDIT ADVANCED_ROOT TLS_ROOT
           MUTUAL_SERVER_FIXTURES MUTUAL_FIXTURES MUTUAL_RESULTS MUTUAL_ANALYSIS MUTUAL_EXACT MUTUAL_BOUNDARY BOUNDARY_ROOT
Stages accept a number (80) or full name (80.crossover).
  cross                     N=16 crossover + plots (stage 80)
  cross-advanced            crossover for N=1, 4, 16, 64 and 256 + plots
  html-report               render existing advanced crossover evidence as offline HTML
  tls-depth-validation      execute D=2–5 TLS scaling, analysis, plots and HTML
  mutual-crossover          compare simple and mutual crossover for all nine profiles
  tls-full --execute        compatibility alias for tls-depth-validation
The N=16 default workflow is 10, 20, 30, 40, 50, 60, 80, 85 and 90.
It skips optional stages 95, 100, 102, 105, 110 and 120.
run ALL does not execute the TLS performance matrix.
TLS depth validation is manual: run 110 or tls-depth-validation.
For a previous manual campaign, use init with its name and set its paths.
HELP
}
load() { [[ -f "$CONFIG" ]] || fail 'Run init [NAME] first.'; source "$CONFIG"; configure_kem "${KEM:-x25519}"; ADVANCED_ROOT=${ADVANCED_ROOT:-${STATIC_ROOT}-advanced}; TLS_ROOT=${TLS_ROOT:-artifacts/results/cert-chain-tls-$STAMP}; MUTUAL_SERVER_FIXTURES=${MUTUAL_SERVER_FIXTURES:-artifacts/scaling/mutual-auth-crossover/server-x509-$STAMP}; MUTUAL_FIXTURES=${MUTUAL_FIXTURES:-artifacts/scaling/mutual-auth-crossover/fixtures-$STAMP}; MUTUAL_RESULTS=${MUTUAL_RESULTS:-artifacts/results/mutual-auth-crossover-$STAMP}; MUTUAL_ANALYSIS=${MUTUAL_ANALYSIS:-artifacts/results/mutual-auth-crossover-analysis-$STAMP}; MUTUAL_EXACT=${MUTUAL_EXACT:-artifacts/results/mutual-auth-crossover-exact-$STAMP}; MUTUAL_BOUNDARY=${MUTUAL_BOUNDARY:-artifacts/results/mutual-auth-crossover-boundary-audit-$STAMP}; BOUNDARY_ROOT=${BOUNDARY_ROOT:-artifacts/results/mtc-crossover-boundary-audit-$STAMP}; }
save() {
 local key
 (umask 077; : > "$CONFIG.tmp"
 for key in STAMP KEM CHAIN_FIXTURES CHAIN_VALID ENVIRONMENT SUPPORT MTC16 MTC_VALID MTC_ALL STATIC_ROOT AUDIT ADVANCED_ROOT TLS_ROOT MUTUAL_SERVER_FIXTURES MUTUAL_FIXTURES MUTUAL_RESULTS MUTUAL_ANALYSIS MUTUAL_EXACT MUTUAL_BOUNDARY BOUNDARY_ROOT; do
  printf '%s=%q\n' "$key" "${!key}" >> "$CONFIG.tmp"
 done
 mv "$CONFIG.tmp" "$CONFIG")
}
init() {
 [[ ! -e "$CONFIG" ]] || fail 'Configuration already exists. Use status and set; it will not be overwritten.'
 STAMP=${1:-$(date -u +%Y%m%dT%H%M%SZ)}
 if [[ -n "${2:-}" ]]; then configure_kem "$2"; else select_kem; fi
 TAG="$KEM_SLUG-$STAMP"
 [[ "$TAG" =~ ^[a-zA-Z0-9_-]+$ ]] || fail 'Invalid date/name.'
 CHAIN_FIXTURES="artifacts/cert-chain-scaling/fixtures-$TAG"
 CHAIN_VALID="artifacts/results/cert-chain-validation-$TAG.json"
 ENVIRONMENT="artifacts/cert-chain-scaling/environment-$TAG.json"
 SUPPORT="artifacts/cert-chain-scaling/algorithm_support-$TAG.csv"
 MTC16="artifacts/mtc/n16-$TAG"
 MTC_VALID="artifacts/results/mtc-n16-$TAG"
 MTC_ALL="artifacts/mtc/all-$TAG"
 STATIC_ROOT="artifacts/results/mtc-crossover-n16-$TAG"
 ADVANCED_ROOT="artifacts/results/mtc-crossover-advanced-$TAG"
 TLS_ROOT="artifacts/results/cert-chain-tls-$TAG"
 AUDIT="artifacts/results/mtc-crossover-audit-$TAG.json"
 MUTUAL_SERVER_FIXTURES="artifacts/scaling/mutual-auth-crossover/server-x509-$TAG"
 MUTUAL_FIXTURES="artifacts/scaling/mutual-auth-crossover/fixtures-$TAG"
 MUTUAL_RESULTS="artifacts/results/mutual-auth-crossover-$TAG"
 MUTUAL_ANALYSIS="artifacts/results/mutual-auth-crossover-analysis-$TAG"
 MUTUAL_EXACT="artifacts/results/mutual-auth-crossover-exact-$TAG"
 MUTUAL_BOUNDARY="artifacts/results/mutual-auth-crossover-boundary-audit-$TAG"
 BOUNDARY_ROOT="artifacts/results/mtc-crossover-boundary-audit-$TAG"
 mkdir -p "$STATE"; save
 printf 'Paths saved. No campaign has been executed.\n'
}
new_campaign() {
 local name=${1:-$(date -u +%Y%m%dT%H%M%SZ)} archive file
 [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || fail 'Invalid date/name.'
 mkdir -p "$STATE"
 archive=$(date -u +%Y%m%dT%H%M%SZ)-$$
 [[ ! -e "$CONFIG" ]] || mv "$CONFIG" "$CONFIG.previous-$archive"
 for file in "$STATE"/*.status; do
  [[ ! -f "$file" ]] || mv "$file" "$file.previous-$archive"
 done
 init "$name" "${2:-}"
 printf 'Previous configuration and stage status were archived. Existing artifacts were not changed.\n'
}
select_step() {
 local entry
 if [[ "$1" == 70 || "$1" == 70.mtc-all || "$1" == 95.mtc-all ]]; then set -- 95.mtc-all-sizes; fi
 for entry in "${STEPS[@]}"; do
  if [[ "$1" == "$entry" || "$1" == "${entry%%.*}" ]]; then STEP=$entry; return; fi
 done
 fail "Unknown stage: $1"
}
step_note() {
 case "$1" in
  50.*) printf '(N=16 fixture set)' ;;
  60.*) printf '(N=16 functional validation)' ;;
  80.*) printf '(N=16 crossover)' ;;
  85.*) printf '(N=16 crossover tables and plots in HTML)' ;;
  90.*) printf '(N=16 crossover audit)' ;;
  95.*) printf '(N=1, 4, 16, 64, 256; D=2 crossover range)' ;;
  100.*) printf '(exact analytical crossover)' ;;
  102.*) printf '(empirical N-1/N confirmation for D=2 cuts within N≤256; includes HTML)' ;;
  105.*) printf '(advanced crossover report)' ;;
  110.*) printf '(X.509 D=2–5; depends on 10, 20, 30 and 80; includes HTML)' ;;
  120.*) printf '(9-profile sampled mutual crossover)' ;;
  122.*) printf '(exact client+server Certificate-size crossover)' ;;
  124.*) printf '(empirical mutual N-1/N boundary confirmation)' ;;
  125.*) printf '(combined sampled, exact and audited mutual HTML)' ;;
 esac
}
print_steps() {
 local entry
 for entry in "${STEPS[@]}"; do printf '%-24s %s\n' "$entry" "$(step_note "$entry")"; done
}
plan() {
 select_step "$1"
 case "$STEP" in
  10.*) OUT=$ENVIRONMENT; CMD=(python3 "$CHAIN/inspect_environment.py" --output "$ENVIRONMENT" --support-output "$SUPPORT");;
  20.*) OUT=$CHAIN_FIXTURES; CMD=(python3 "$CHAIN/generate_fixtures.py" --output "$CHAIN_FIXTURES");;
  30.*) OUT=$CHAIN_VALID; CMD=(python3 "$CHAIN/validate.py" "$CHAIN_FIXTURES" --output "$CHAIN_VALID");;
  40.*) OUT=''; CMD=(bin/base/mt-prepare run 2);;
  50.*) OUT=$MTC16; CMD=(python3 "$MTC" generate --output "$MTC16" --execute);;
  60.*) OUT=$MTC_VALID; CMD=(python3 "$MTC" validate --fixtures "$MTC16" --output "$MTC_VALID" --execute);;
  95.*) OUT=$MTC_ALL; CMD=(python3 "$MTC" generate --sizes 1 4 16 64 256 --seed-fixtures "$MTC16" --validated-n16 "$MTC_VALID/validation.json" --output "$MTC_ALL" --execute);;
  80.*) OUT=$STATIC_ROOT
   CMD=(bash -c 'python3 "$1/size_analysis.py" "$2" --mtc-fixtures "$3" --output "$4" && python3 "$1/plots.py" "$4" --output "$4/plots"' _ "$CHAIN" "$CHAIN_FIXTURES" "$MTC16" "$STATIC_ROOT");;
  85.*) OUT="artifacts/reports/${STATIC_ROOT##*/}/report.html"; CMD=(python3 bin/renders/crossover.py "$STATIC_ROOT" --output "$OUT");;
  #100.*) OUT=$ADVANCED_ROOT
  # CMD=(bash -c 'python3 "$1/size_analysis.py" "$2" --mtc-fixtures "$3" --output "$4" && python3 "$1/plots.py" "$4" --output "$4/plots"' _ "$CHAIN" "$CHAIN_FIXTURES" "$MTC_ALL" "$ADVANCED_ROOT");;
  100.*) OUT=$ADVANCED_ROOT
   CMD=(python3 "$CHAIN/crossover_extended.py"
     --fixtures "$CHAIN_FIXTURES"
     --mtc-fixtures "$MTC16"
     --mtc-validation "$MTC_VALID/validation.json"
     --baseline "$STATIC_ROOT"
     --measurements "$TLS_ROOT"
     --output "$ADVANCED_ROOT");;
  110.*) OUT=$TLS_ROOT
   CMD=(bash -c 'set -euo pipefail
python3 "$1/run.py" --fixtures "$2" --output "$3" --campaigns 5 --repetitions 30 --warmups 5 --full-matrix --environment "$4" --dry-run
python3 "$1/run.py" --fixtures "$2" --output "$3" --campaigns 5 --repetitions 30 --warmups 5 --full-matrix --environment "$4" --execute
python3 "$1/analyze.py" "$3"
python3 "$1/plots.py" "$5" --measurements "$3" --output "$3/plots"
"$6" "$3" --output "$7"' _ "$CHAIN" "$CHAIN_FIXTURES" "$TLS_ROOT" "$ENVIRONMENT" "$STATIC_ROOT" "$REPO/bin/artifacts/mt-report" "artifacts/reports/${TLS_ROOT##*/}/report.html");;
  102.*) OUT=$BOUNDARY_ROOT; CMD=(python3 campaigns/scaling/crossover_n_server_only/boundary_audit.py --analysis "$ADVANCED_ROOT" --source-fixtures "$MTC_ALL" --output "$BOUNDARY_ROOT" --execute);;
  105.*) OUT="artifacts/reports/${ADVANCED_ROOT##*/}/report.html"
   CMD=(python3 bin/renders/crossover-advanced.py --analysis "$ADVANCED_ROOT" --audit "$BOUNDARY_ROOT" --output "$OUT");;
  90.*) OUT=$AUDIT; CMD=(python3 "$CHAIN/validate.py" "$CHAIN_FIXTURES" --analysis "$STATIC_ROOT" --output "$AUDIT");;
  120.*) OUT=$MUTUAL_RESULTS; CMD=(python3 campaigns/scaling/mutual_authentication_crossover/workflow.py --server-fixtures "$MUTUAL_SERVER_FIXTURES" --fixtures "$MUTUAL_FIXTURES" --results "$MUTUAL_RESULTS" --analysis "$MUTUAL_ANALYSIS" --simple-crossover "$STATIC_ROOT" --report "artifacts/reports/${MUTUAL_ANALYSIS##*/}/sampled.html" --execute);;
  122.*) OUT=$MUTUAL_EXACT; CMD=(python3 campaigns/scaling/mutual_authentication_crossover/exact_crossover.py --fixtures "$MUTUAL_FIXTURES" --analysis "$MUTUAL_ANALYSIS" --output "$MUTUAL_EXACT");;
  124.*) OUT=$MUTUAL_BOUNDARY; CMD=(python3 campaigns/scaling/mutual_authentication_crossover/boundary_audit.py --exact "$MUTUAL_EXACT" --source-fixtures "$MUTUAL_FIXTURES" --output "$MUTUAL_BOUNDARY" --execute);;
  125.*) OUT="artifacts/reports/${MUTUAL_ANALYSIS##*/}/report.html"; CMD=(python3 bin/renders/mutual-crossover.py --analysis "$MUTUAL_ANALYSIS" --exact "$MUTUAL_EXACT" --audit "$MUTUAL_BOUNDARY" --output "$OUT");;
 esac
}
show_command() { printf 'env MTC_KEM_ID=%q MTC_KEM_LABEL=%q MTC_TLS_GROUP=%q ' "$KEM" "$KEM_LABEL" "$KEM_GROUP"; printf '%q ' "${CMD[@]}"; printf '\n'; }
progress() {
 local root=$1 dir count
 [[ -d "$root/population" ]] || return 0
 printf '\nPopulation %s (target per profile: %s):\n' "$root" "$2"
 for dir in "$root"/population/*; do
  [[ -d "$dir" ]] || continue
  count=$(find "$dir" -maxdepth 1 -type f -name '*.pem' ! -name ca.pem | wc -l | tr -d ' ')
  printf '  %-16s %s certificates\n' "${dir##*/}" "$count"
 done
 printf 'Reaching the target does not mean the MTC objects are complete.\n'
}
status() {
 load
 local key step state display_state
 printf 'Key establishment: %s (%s)\n' "$KEM_LABEL" "$KEM_GROUP"
 for key in CHAIN_FIXTURES CHAIN_VALID ENVIRONMENT SUPPORT MTC16 MTC_VALID MTC_ALL STATIC_ROOT AUDIT ADVANCED_ROOT BOUNDARY_ROOT TLS_ROOT MUTUAL_SERVER_FIXTURES MUTUAL_FIXTURES MUTUAL_RESULTS MUTUAL_ANALYSIS MUTUAL_EXACT MUTUAL_BOUNDARY; do
  printf '%-16s %s\n' "$key" "${!key}"
 done
 printf '\nStages (existing output does not imply validation):\n'
 for step in "${STEPS[@]}"; do
  plan "$step"; state='pending/not executed by this launcher'
  [[ ! -f "$STATE/$STEP.status" ]] || state=$(cat "$STATE/$STEP.status")
  display_state=${state%%; log=*}
  [[ -z "$OUT" || ! -e "$OUT" ]] || display_state="$display_state; output exists"
  printf '  %-20s %-52s %s\n' "$STEP" "$(step_note "$STEP")" "$display_state"
 done
 progress "$MTC16" 16
 progress "$MTC_ALL" 256
 [[ ! -d "$STATE/lock" ]] || printf '\nAn execution lock exists. Inspect the process and its log before intervening.\n'
}
require_path() { [[ -e "$1" ]] || fail "Missing input: $1"; }
require_static_baseline() {
 local name
 for name in chain_sizes.csv mtc_sizes.csv; do
  [[ -f "$STATIC_ROOT/$name" ]] || fail "Missing N=16 baseline: $STATIC_ROOT/$name. Run bin/cryptographic_scaling/mt-cert-scaling run 80 before stage 100. If STATIC_ROOT is incomplete, preserve it and select a fresh STATIC_ROOT first."
 done
}
preflight() {
 case "$STEP" in
  10.*|20.*|30.*|90.*) mt_images_required mt-tls-mtc:local || return 1;;
  40.*) mt_compose_ready || return 1;;
  102.*|110.*|120.*) mt_compose_ready && mt_image_required mt-tls-mtc:local || return 1;;
  124.*) mt_compose_ready && mt_images_required mt-tls-mtc:local mt-tls-mtc-mutual:local || return 1;;
  50.*|60.*|95.*) mt_images_required mt-tls-mtc:local || return 1;;
 esac
 [[ -z "$OUT" || ! -e "$OUT" ]] || fail "Output already exists: $OUT. It will not be overwritten or resumed. Check status or use set with a fresh path."
 case "$STEP" in
  102.*) require_path "$ADVANCED_ROOT/crossover_extended.csv"; require_path "$MTC_ALL/manifest.json";;
  122.*) require_path "$MUTUAL_ANALYSIS/x509-baselines.csv"; require_path "$MUTUAL_FIXTURES/server-mtc/batch16"; require_path "$MUTUAL_FIXTURES/client-mtc/batch16";;
  124.*) require_path "$MUTUAL_EXACT/mutual-crossover-exact.csv"; require_path "$MUTUAL_FIXTURES";;
  125.*) require_path "$MUTUAL_ANALYSIS/crossover-n.csv"; require_path "$MUTUAL_EXACT/mutual-crossover-exact.csv"; require_path "$MUTUAL_BOUNDARY/mutual-boundary-audit.csv";;
  120.*)
    require_path "$STATIC_ROOT/crossover.csv"
    require_path "campaigns/scaling/mutual_authentication_crossover/Dockerfile.mutual_metrics"
    [[ ! -e "$MUTUAL_SERVER_FIXTURES" ]] || fail "Output already exists: $MUTUAL_SERVER_FIXTURES"
    [[ ! -e "$MUTUAL_FIXTURES" ]] || fail "Output already exists: $MUTUAL_FIXTURES"
    [[ ! -e "$MUTUAL_ANALYSIS" ]] || fail "Output already exists: $MUTUAL_ANALYSIS"
    [[ ! -e "artifacts/reports/${MUTUAL_ANALYSIS##*/}/sampled.html" ]] || fail 'Mutual crossover HTML output already exists.'
    ;;
  85.*) require_path "$STATIC_ROOT/analysis.json"; require_path "$STATIC_ROOT/crossover.csv"; require_path "$STATIC_ROOT/plots";;
  110.*)
    require_path "$ENVIRONMENT"; require_path "$CHAIN_FIXTURES"; require_path "$CHAIN_VALID"
    require_path "$STATIC_ROOT/analysis.json"
    [[ ! -e "artifacts/reports/${TLS_ROOT##*/}/report.html" ]] || fail 'TLS depth-validation HTML output already exists.'
    python3 -c 'import matplotlib' || fail 'matplotlib is required for TLS plots.'
    python3 -c 'import json,sys; sys.exit(0 if json.load(open(sys.argv[1])).get("passed") is True else "ERROR: X.509 fixture validation did not pass.")' "$CHAIN_VALID" || return 1
    ;;
  105.*)
    require_path "$ADVANCED_ROOT/analysis_extended.json"
    require_path "$ADVANCED_ROOT/crossover_extended.csv"
    require_path "$ADVANCED_ROOT/x509_reference_validation.csv"
    require_path "$ADVANCED_ROOT/serialization_breakdown.csv"
    require_path "$ADVANCED_ROOT/mtc_size_model.csv"
    require_path "$ADVANCED_ROOT/crossover-by-depth.png"
    require_path "$ADVANCED_ROOT/crossover-curves.png"
    require_path "$BOUNDARY_ROOT/crossover-boundary-audit.csv"
    ;;
  10.*) [[ ! -e "$SUPPORT" ]] || fail "Output already exists: $SUPPORT";;
  30.*) require_path "$CHAIN_FIXTURES";;
  60.*) require_path "$MTC16/manifest.json";;
  95.*) require_path "$MTC_VALID/validation.json"; require_path "$MTC16/manifest.json";;
  80.*|100.*)
    python3 -c 'import importlib.util,sys; sys.exit(0 if importlib.util.find_spec("matplotlib") else "ERROR: matplotlib is required to generate crossover plots. Install it in the Python environment used by this launcher.")' || return 1
    require_path "$CHAIN_VALID"; require_path "$MTC16/manifest.json"; require_path "$MTC_VALID/validation.json"
    if [[ "$STEP" == 100.* ]]; then require_static_baseline; require_path "$MTC_ALL/manifest.json"; fi
    python3 - "$CHAIN_VALID" "$MTC_VALID/validation.json" "$MTC16" "$STEP" "$MTC_ALL" <<'PY'
import json,sys
for path in sys.argv[1:3]:
    data=json.load(open(path))
    if data.get('passed') is not True:
        raise SystemExit('Validation does not report passed=true: '+path)
from pathlib import Path
import hashlib
root=Path(sys.argv[3]);gate=json.loads(Path(sys.argv[2]).read_text())
profiles={'ecdsa-p256','ecdsa-p384','ecdsa-p521','mldsa44','mldsa65','mldsa87','slhdsa128s','slhdsa192s','slhdsa256s'}
expected={(name,mode) for name in profiles for mode in ('landmark','standalone')}
cells=gate.get('cells',[])
if len(cells)!=18 or {(r.get('profile'),r.get('mtc_mode')) for r in cells}!=expected or any(r.get('tree_size')!=16 or r.get('success') is not True for r in cells):
    raise SystemExit('The N=16 gate must pass all nine profiles and both modes.')
actual={str(p.relative_to(root)):hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(root.rglob('*')) if p.is_file()}
if actual!=gate.get('fixture_hashes'):raise SystemExit('N=16 fixtures differ from the validation gate.')
if sys.argv[4].startswith('100.'):
    m=json.loads((Path(sys.argv[5])/'manifest.json').read_text())
    if set(m.get('sizes',[]))!={1,4,16,64,256} or set(m.get('profiles',[]))!=profiles:
        raise SystemExit('Advanced analysis requires all six populations and all nine profiles.')
    for n in m['sizes']:
        for profile in profiles:
            if not (Path(sys.argv[5])/f'batch{n}'/'mtc'/profile/'manifest.json').is_file():
                raise SystemExit(f'Missing advanced fixture: {profile}, N={n}')
PY
    ;;
  90.*) require_path "$STATIC_ROOT/analysis.json"; require_path "$CHAIN_FIXTURES";;
 esac
}
run() (
 load; plan "$1"; preflight
 mkdir "$STATE/lock" 2>/dev/null || fail 'Another stage is running, or a lock remains after interruption.'
 trap 'rmdir "$STATE/lock" 2>/dev/null || true' EXIT
 local log rc monitor
 log="$STATE/$STEP-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
 printf 'running; log=%s\n' "$log" > "$STATE/$STEP.status"
 printf 'Stage: %s\nLog: %s\n' "$STEP" "$log"; show_command
 # Monitor only new output: no edits to the running scientific implementation.
 (
  while sleep 30; do
   printf '[%s] Still running: %s\n' "$(date +%H:%M:%S)" "$STEP"
   case "$STEP" in 50.*) progress "$MTC16" 16;; 95.*) progress "$MTC_ALL" 256;; esac
  done
 ) & monitor=$!
 trap 'kill "$monitor" 2>/dev/null || true; rmdir "$STATE/lock" 2>/dev/null || true' EXIT
 trap 'printf "interrupted; log=%s\n" "$log" > "$STATE/$STEP.status"; exit 130' INT TERM
 set +e
 env PYTHONUNBUFFERED=1 MTC_KEM_ID="$KEM" MTC_KEM_LABEL="$KEM_LABEL" MTC_TLS_GROUP="$KEM_GROUP" "${CMD[@]}" 2>&1 | tee "$log"
 rc=${PIPESTATUS[0]}
 set -e
 kill "$monitor" 2>/dev/null || true
 if [[ "$rc" == 0 ]]; then
  printf 'completed; log=%s\n' "$log" > "$STATE/$STEP.status"
  printf 'COMPLETED %s\n' "$STEP"
 else
  printf 'failed (exit %s); log=%s\n' "$rc" "$log" > "$STATE/$STEP.status"
  printf 'FAILED %s (exit %s). All output is preserved.\n' "$STEP" "$rc"
 fi
 exit "$rc"
)
run_batch() (
 load
 local limit=$1 step state count=0
 if [[ "$limit" != ALL ]]; then [[ "$limit" =~ ^[1-9][0-9]{0,5}$ ]] || fail 'Valid count: 1..999999.'; fi
 mkdir "$STATE/batch.lock" 2>/dev/null || fail 'A batch is active or a lock needs inspection.'
 trap 'rmdir "$STATE/batch.lock" 2>/dev/null || true' EXIT
 [[ ! -d "$STATE/lock" ]] || fail 'A stage is active or a lock needs inspection.'
 for step in "${DEFAULT_STEPS[@]}"; do
  state=''
  [[ ! -f "$STATE/$step.status" ]] || state=$(cat "$STATE/$step.status")
  case "$state" in running*) fail "Stage marked running: $step. Inspect its state before continuing.";; esac
 done
 for step in "${DEFAULT_STEPS[@]}"; do
  state=''
  [[ ! -f "$STATE/$step.status" ]] || state=$(cat "$STATE/$step.status")
  case "$state" in completed*) continue;; esac
  printf 'Batch: %s (%s of %s)\n' "$step" "$((count+1))" "$limit"
  "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run "$step" || exit "$?"
  count=$((count+1))
  if [[ "$limit" != ALL && "$count" -ge "$limit" ]]; then break; fi
 done
 printf 'Batch completed: %s stages.\n' "$count"
)

cross_advanced() (
 load
 [[ ! -d "$STATE/lock" && ! -d "$STATE/batch.lock" ]] || fail 'Another stage or batch is active.'
 mkdir "$STATE/batch.lock" || exit 1
 trap 'rmdir "$STATE/batch.lock" 2>/dev/null || true' EXIT
 [[ ! -e "$ADVANCED_ROOT" ]] || fail "Advanced output already exists: $ADVANCED_ROOT. Select a new ADVANCED_ROOT."
 # Check the cheap dependencies before starting potentially expensive generation.
 require_static_baseline
 require_path "$CHAIN_VALID"; require_path "$MTC_VALID/validation.json"
 python3 -c 'import json,sys; sys.exit(0 if all(json.load(open(p)).get("passed") is True for p in sys.argv[1:]) else "ERROR: prerequisite validation failed.")' "$CHAIN_VALID" "$MTC_VALID/validation.json"
 python3 -c 'import importlib.util,sys; sys.exit(0 if importlib.util.find_spec("matplotlib") else "ERROR: matplotlib is required.")'
 if [[ -e "$MTC_ALL" ]]; then
  require_path "$MTC_ALL/manifest.json"
  echo "Reusing existing complete fixture root: $MTC_ALL (validated before analysis)."
 else
  "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 95 || exit "$?"
 fi
 "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 100 || exit "$?"
)

boundary_audit() (
 "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 102 || exit "$?"
 "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 105
)

mutual_crossover() (
 "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 120 || exit "$?"
 "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 122
)

mutual_boundary_audit() (
 "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 124 || exit "$?"
 "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 125
)

set_path() {
 load
 [[ ! -d "$STATE/lock" && ! -d "$STATE/batch.lock" ]] || fail 'Do not change paths while a stage or batch is running.'
 case "$1" in CHAIN_FIXTURES|CHAIN_VALID|ENVIRONMENT|SUPPORT|MTC16|MTC_VALID|MTC_ALL|STATIC_ROOT|AUDIT|ADVANCED_ROOT|TLS_ROOT|MUTUAL_SERVER_FIXTURES|MUTUAL_FIXTURES|MUTUAL_RESULTS|MUTUAL_ANALYSIS|MUTUAL_EXACT|MUTUAL_BOUNDARY|BOUNDARY_ROOT) ;;
  *) fail 'Unknown path variable.';;
 esac
 [[ -n "$2" ]] || fail 'Empty path.'
 printf -v "$1" '%s' "$2"; save
 # Recorded exits belong to the previous path configuration, not the new one.
 local file
 for file in "$STATE"/*.status; do
  [[ ! -f "$file" ]] || mv "$file" "$file.previous-$(date -u +%Y%m%dT%H%M%SZ)-$$"
 done
 printf 'Path saved. Previous logs preserved.\n'
}
suggest_path() {
 local key=$1 stamp
 stamp=$(date -u +%Y%m%dT%H%M%SZ)
 case "$key" in
  CHAIN_FIXTURES) printf 'artifacts/cert-chain-scaling/fixtures-%s' "$stamp";;
  CHAIN_VALID) printf 'artifacts/results/cert-chain-validation-%s.json' "$stamp";;
  ENVIRONMENT) printf 'artifacts/cert-chain-scaling/environment-%s.json' "$stamp";;
  SUPPORT) printf 'artifacts/cert-chain-scaling/algorithm-support-%s.csv' "$stamp";;
  MTC16) printf 'artifacts/mtc/n16-%s' "$stamp";;
  MTC_VALID) printf 'artifacts/results/mtc-n16-%s' "$stamp";;
  MTC_ALL) printf 'artifacts/mtc/all-%s' "$stamp";;
  STATIC_ROOT) printf 'artifacts/results/mtc-crossover-n16-%s' "$stamp";;
  AUDIT) printf 'artifacts/results/mtc-crossover-audit-%s.json' "$stamp";;
  ADVANCED_ROOT) printf 'artifacts/results/mtc-crossover-advanced-%s' "$stamp";;
  TLS_ROOT) printf 'artifacts/results/cert-chain-tls-%s' "$stamp";;
  MUTUAL_SERVER_FIXTURES) printf 'artifacts/scaling/mutual-auth-crossover/server-x509-%s' "$stamp";;
  MUTUAL_FIXTURES) printf 'artifacts/scaling/mutual-auth-crossover/fixtures-%s' "$stamp";;
  MUTUAL_RESULTS) printf 'artifacts/results/mutual-auth-crossover-%s' "$stamp";;
  MUTUAL_ANALYSIS) printf 'artifacts/results/mutual-auth-crossover-analysis-%s' "$stamp";;
  MUTUAL_EXACT) printf 'artifacts/results/mutual-auth-crossover-exact-%s' "$stamp";;
  MUTUAL_BOUNDARY) printf 'artifacts/results/mutual-auth-crossover-boundary-audit-%s' "$stamp";;
  BOUNDARY_ROOT) printf 'artifacts/results/mtc-crossover-boundary-audit-%s' "$stamp";;
  *) fail 'Unknown path variable.';;
 esac
}
menu() {
 local choice value key suggested path_choice path_number index
 local -a path_keys=(CHAIN_FIXTURES CHAIN_VALID ENVIRONMENT SUPPORT MTC16 MTC_VALID MTC_ALL STATIC_ROOT AUDIT ADVANCED_ROOT BOUNDARY_ROOT TLS_ROOT MUTUAL_SERVER_FIXTURES MUTUAL_FIXTURES MUTUAL_RESULTS MUTUAL_ANALYSIS MUTUAL_EXACT MUTUAL_BOUNDARY)
 while true; do
  printf '\nCert scaling: 1 New campaign paths  2 Status/progress  3 Show command\n              4 Run stage  5 Change one path\n              6 Run next X pending N=16 stages\n              7 Run complete N=16 workflow (10–60, 80, 85, 90)\n              8 Advanced crossover (N=1, 4, 16, 64, 256)\n              9 Audit calculated crossover boundaries (N-1/N, includes HTML)
             10 TLS depth validation (X.509 D=2–5, includes HTML)
             11 Mutual-auth crossover and exact calculation (9 profiles)
             12 Audit mutual crossover boundaries (N-1/N, includes HTML)  0 Exit\n'
  read -r -p '> ' choice || return 0
  case "$choice" in
   1) read -r -p 'Campaign name (empty = date and time): ' value; "$0" new "${value:-$(date -u +%Y%m%dT%H%M%SZ)}" || true;;
   2) "$0" status || true;;
   3|4) print_steps; read -r -p 'Stage number: ' value
    if [[ "$choice" == 3 ]]; then "$0" show "$value" || true; else "$0" run "$value" || true; fi;;
   5) load
    printf '\nSelect the path to change:\n'
    for index in "${!path_keys[@]}"; do
     key=${path_keys[$index]}
     printf ' %2d  %-24s %s\n' "$((index+1))" "$key" "${!key}"
    done
    read -r -p 'Number (0 = cancel): ' path_choice
    [[ "$path_choice" == 0 ]] && continue
    if [[ ! "$path_choice" =~ ^[0-9]+$ ]]; then
     printf 'Invalid selection.\n'; continue
    fi
    path_number=$((10#$path_choice))
    if ((path_number < 1 || path_number > ${#path_keys[@]})); then
     printf 'Invalid selection.\n'; continue
    fi
    key=${path_keys[$((path_number-1))]}
    suggested=$(suggest_path "$key")
    read -r -p "Path (empty = $suggested): " value
    "$0" set "$key" "${value:-$suggested}" || true;;
   6) read -r -p 'Number of pending stages: ' value; "$0" run --count "$value" || true;;
   7) "$0" run ALL || true;;
   8) "$0" cross-advanced || true;;
   9) "$0" crossover-boundary-audit || true;;
   10) "$0" tls-depth-validation || true;;
   11) "$0" mutual-crossover || true;;
   12) "$0" mutual-crossover-boundary-audit || true;;
   0) return 0;;
  esac
 done
}
case "${1:-menu}" in
 init) init "${2:-$(date -u +%Y%m%dT%H%M%SZ)}" "${3:-}";;
 new) new_campaign "${2:-$(date -u +%Y%m%dT%H%M%SZ)}" "${3:-}";;
 status) status;;
 list) print_steps;;
 show) load; plan "${2:?Stage required}"; show_command;;
 run)
  if [[ "$#" == 3 && "$2" == --count ]]; then run_batch "$3"
  elif [[ "$#" == 2 && "$2" == ALL ]]; then run_batch ALL
  elif [[ "$#" == 2 ]]; then run "$2"
  else usage; exit 2; fi;;
 set) set_path "${2:?Variable required}" "${3:?Path required}";;
 tls-depth-validation) [[ "$#" == 1 ]] || fail 'Usage: tls-depth-validation'; run 110;;
 tls-full) [[ "$#" == 2 && "$2" == --execute ]] || fail 'Usage: tls-full --execute'; run 110;;
 cross) run 80;;
 cross-advanced) cross_advanced;;
 html-report) run 105;;
 crossover-boundary-audit) [[ "$#" == 1 ]] || fail 'Usage: crossover-boundary-audit'; boundary_audit;;
 mutual-crossover) [[ "$#" == 1 ]] || fail 'Usage: mutual-crossover'; mutual_crossover;;
 mutual-crossover-boundary-audit) [[ "$#" == 1 ]] || fail 'Usage: mutual-crossover-boundary-audit'; mutual_boundary_audit;;
 prepare) exec "$REPO/bin/base/mt-prepare" menu;;
 menu) menu;;
 help|--help|-h) usage;;
 *) usage; exit 2;;
esac
