menu() {
 local choice value key
 while true; do
  printf '\nProtocol validation: 1 Initialize  2 Status  3 Show command\n                     4 Run stage  5 Change path  6 New campaign\n                     7 Run ALL pending stages (includes captures and stress checks)\n                     8 Run ALL PROFILES × ALL LEAVES (9 × 16 identities)  0 Back\n'
  read -r -p '> ' choice || return 0
  case "$choice" in
   1) read -r -p 'Date/name (empty=new): ' value; "$SELF" init "${value:-$(date -u +%Y%m%dT%H%M%SZ)}" || true;;
   2) "$SELF" status || true;;
   3|4) printf '%s\n' "${STEPS[@]}"; read -r -p 'Number: ' value
     if [[ "$choice" == 3 ]]; then "$SELF" show "$value" || true; else "$SELF" run "$value" || true; fi;;
   5) read -r -p 'Variable FIX, KEY, CAP, PROFILE or LEAF: ' key; read -r -p 'Relative path: ' value; "$SELF" set "$key" "$value" || true;;
   6) read -r -p 'New date/name (empty=new): ' value; "$SELF" new "${value:-$(date -u +%Y%m%dT%H%M%SZ)}" || true;;
   7) "$SELF" run ALL || true;;
   8) read -r -p 'Matrix date/name (empty=new): ' value; "$SELF" run ALL-PROFILES "${value:-$(date -u +%Y%m%dT%H%M%SZ)}" || true;;
   0) return 0;;
  esac
 done
}
case "${1:-menu}" in
 init) init "${2:-$(date -u +%Y%m%dT%H%M%SZ)}";;
 init-profile) init_profile "${2:?Campaign name required}" "${3:?Profile required}" "${4:-0}";;
 init-legacy) init "${2:-$(date -u +%Y%m%dT%H%M%SZ)}" legacy;;
 new) new_campaign "${2:-$(date -u +%Y%m%dT%H%M%SZ)}";;
 status) status;;
 list) printf '%s\n' "${STEPS[@]}";;
 profiles) printf '%s\n' "${PROFILE_MATRIX[@]}";;
 show) load; plan "${2:?Stage required}"; show;;
 run)
  case "${2:-}" in
   ALL) [[ "$#" == 2 ]] || fail 'Usage: run ALL'; run_all;;
   LEAF-ALL) [[ "$#" == 2 ]] || fail 'Usage: run LEAF-ALL'; run_leaf_pipeline;;
   ALL-PROFILES) [[ "$#" -le 3 ]] || fail 'Usage: run ALL-PROFILES [NAME]'; run_all_profiles "${3:-$(date -u +%Y%m%dT%H%M%SZ)}";;
   '') fail 'Usage: run STAGE|ALL|ALL-PROFILES [NAME]';;
   *) [[ "$#" == 2 ]] || fail 'Usage: run STAGE'; run_step "$2";;
  esac;;
 set) set_path "${2:?Variable required}" "${3:?Path required}";;
 menu) menu;;
 help|--help|-h) printf 'Usage: %s [menu|init [NAME]|init-profile NAME PROFILE [LEAF]|init-legacy [NAME]|new [NAME]|status|list|profiles|show STAGE|run STAGE|run ALL|run ALL-PROFILES [NAME]|set FIX/KEY/CAP/PROFILE/LEAF VALUE]\nSTAGE accepts a number (10) or full name (10.offline-existing).\nrun ALL executes all pending stages for the configured profile/leaf.\nrun ALL-PROFILES [NAME] validates all nine Paper-1 profiles across all 16 N=16 leaves (144 identities, landmark + standalone), with independent TLS transcript verification for every capture; invalid-input stress runs once per profile. A final matrix summary is attempted on success, failure or interruption and written to artifacts/protocol-validation/NAME/matrix-summary.json; a compatibility copy is written to artifacts/protocol-review/NAME/summary.json.\nManual workflow: init/status/show do not invoke Docker. No builds or deletion.\n' "$SELF";;
 *) fail 'Unknown command; use help.';;
esac
