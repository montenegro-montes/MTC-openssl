run_leaf_pipeline() (
 load
 mkdir "$STATE/batch.lock" 2>/dev/null || fail 'A batch is active or a lock needs inspection.'
 trap 'rmdir "$STATE/batch.lock" 2>/dev/null || true' EXIT
 [[ ! -d "$STATE/lock" ]] || fail 'A stage is active or a lock needs inspection.'
 local step state count=0
 for step in "${STEPS[@]}"; do
  [[ "$step" == 120.* ]] && continue
  state=''
  [[ ! -f "$STATE/$step.status" ]] || state=$(cat "$STATE/$step.status")
  case "$state" in running*) fail "Stage marked running: $step. Inspect its process and log before continuing.";; esac
 done
 for step in "${STEPS[@]}"; do
  [[ "$step" == 120.* ]] && continue
  state=''
  [[ ! -f "$STATE/$step.status" ]] || state=$(cat "$STATE/$step.status")
  case "$state" in completed*) printf 'SKIP completed: %s\n' "$step"; continue;; esac
  printf 'Leaf batch stage: %s\n' "$step"
  run_step "$step" batch || exit "$?"
  count=$((count+1))
 done
 printf 'Leaf pipeline completed: %s stages.\n' "$count"
)
run_all_profiles() (
 local name=${1:-$(date -u +%Y%m%dT%H%M%SZ)}
 local profile leaf leaf4 leaf_state stress_state
 [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || fail 'Invalid matrix campaign name.'
 [[ -f "$REPO/.mt-state/cert-scaling/paths.env" ]] || fail 'Initialize mt-cert-scaling before starting the profile/leaf matrix.'
 mkdir -p "$MATRIX_STATE_ROOT/$name"

 finalize_matrix() {
  local rc=$?
  local summary_rc=0 overall
  trap - EXIT INT TERM
  set +e
  write_matrix_summary "$name" "$rc"
  summary_rc=$?
  if [[ "$summary_rc" == 0 ]]; then
   print_matrix_summary "$name"
   overall=$(python3 - "artifacts/protocol-validation/$name/matrix-summary.json" <<'PYOVERALL'
import json,sys
print(json.load(open(sys.argv[1]))['status'])
PYOVERALL
)
   if [[ "$rc" == 0 && "$overall" != PASS ]]; then rc=1; fi
  else
   printf 'ERROR: matrix summary generation failed for campaign %s.\n' "$name" >&2
   if [[ "$rc" == 0 ]]; then rc=1; fi
  fi
  set -e
  exit "$rc"
 }

 trap finalize_matrix EXIT
 trap 'exit 130' INT TERM

 printf 'Protocol-validation matrix: %s\n' "$name"
 printf 'Profiles: %s\n' "${PROFILE_MATRIX[*]}"
 printf 'Leaves per profile: 0..%s (N=16).\n' "$((LEAF_COUNT-1))"
 printf 'TLS identities to validate: %s.\n' "$(( ${#PROFILE_MATRIX[@]} * LEAF_COUNT ))"

 for profile in "${PROFILE_MATRIX[@]}"; do
  printf '\n############################################################\n'
  printf 'Profile: %s\n' "$profile"
  printf '############################################################\n'
  for ((leaf=0; leaf<LEAF_COUNT; leaf++)); do
   printf -v leaf4 '%04d' "$leaf"
   leaf_state="$MATRIX_STATE_ROOT/$name/$profile/leaf-$leaf4"
   printf '\n============================================================\n'
   printf 'Profile: %s  leaf/key: %d/%s\n' "$profile" "$leaf" "$leaf"
   printf '============================================================\n'
   if [[ ! -f "$leaf_state/paths.env" ]]; then
    MT_PROTOCOL_STATE="$leaf_state" "$SELF" init-profile "$name" "$profile" "$leaf"
   fi
   MT_PROTOCOL_STATE="$leaf_state" "$SELF" run LEAF-ALL
  done
  # Invalid-input stress is fixture/profile-wide, not leaf-specific: run it once per profile.
  stress_state="$MATRIX_STATE_ROOT/$name/$profile/leaf-0000"
  printf '\nProfile-wide invalid-input stress: %s (executed once, using leaf 0 state)\n' "$profile"
  MT_PROTOCOL_STATE="$stress_state" "$SELF" run ALL
 done

 printf '\nAll profile/leaf validation executions completed.\n'
)

new_campaign() {
