#!/usr/bin/env bash
set -euo pipefail

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SELF="$REPO/bin/performance/mt-handshake-performance"
source "$REPO/bin/lib/docker-preflight.sh"
IMAGE=${IMAGE:-mt-tls-mtc:local}
CAPTURE_IMAGE=${CAPTURE_IMAGE:-mt-tls-capture:local}
REPORTER="$REPO/bin/renders/handshake-performance.py"
RETRY_REPORTER="$REPO/bin/renders/protocol-validation.py"
RETRY_MATRIX_REPORTER="$REPO/bin/renders/handshake-retry-matrix.py"
NETWORK=mt-handshake-performance
SERVER=mt-handshake-performance-server
DEFAULT_CONFIG="$REPO/.mt-state/handshake-performance.env"
ACTIVE_CONFIG_FILE=${MT_HANDSHAKE_ACTIVE_CONFIG:-"$REPO/.mt-state/handshake-performance.active"}
PROFILES=(ecdsa-p256 ecdsa-p384 ecdsa-p521 mldsa44 mldsa65 mldsa87 slhdsa128s slhdsa192s slhdsa256s)
CASES=(x509-simple mtc-simple-landmark mtc-simple-standalone x509-mutual mtc-mutual-landmark mtc-mutual-standalone)
SINGLE_CASES=(x509-simple mtc-simple-landmark mtc-simple-standalone)
MUTUAL_CASES=(x509-mutual mtc-mutual-landmark mtc-mutual-standalone)
ACTIVE_CASES=("${CASES[@]}")

fail() { echo "ERROR: $*" >&2; exit 1; }
usage() {
  cat <<EOF
Usage:
  $SELF menu
  $SELF init [CONFIG] [KEM] [DEPTH=2|3|4|5|all]
  $SELF new [CONFIG] [KEM] [DEPTH=2|3|4|5|all]
  $SELF status [CONFIG]
  $SELF plan [CONFIG] [OUTPUT]
  $SELF run-native [CONFIG] [OUTPUT]
  $SELF run-native-single [CONFIG] [OUTPUT]
  $SELF run-native-mutual [CONFIG] [OUTPUT]
  $SELF run-pcap [CONFIG] [OUTPUT]
  $SELF run-pcap-single [CONFIG] [OUTPUT]
  $SELF run-pcap-mutual [CONFIG] [OUTPUT]
  $SELF run-native-pcap [CONFIG] [OUTPUT]
  $SELF run-single [CONFIG] [OUTPUT]
  $SELF run-mutual [CONFIG] [OUTPUT]
  $SELF run-all [CONFIG] [OUTPUT]  # compatibility alias
  $SELF run-retry [CONFIG] [OUTPUT]

CONFIG defaults to .mt-state/handshake-performance.env. When OUTPUT is omitted,
a new timestamped directory is selected below artifacts/results/. Nothing is
executed by init or plan.
MTC_ROOT/MTC_VALIDATION may both be empty: reuse the newest valid paired N=16/X25519
generation, or generate/validate one at run time. Set both paths to pin an override.
X509_DEPTH defaults to 2 (including the local root; 1 certificate transmitted).
D=3..5/all resolve or prepare chains lazily. X509_CHAIN_FIXTURES pins server chains.
Mutual X.509 uses depth D on both sides; MTC remains N=16.
EOF
}

active_config() {
  local selected
  if [[ -f "$ACTIVE_CONFIG_FILE" ]]; then
    selected=$(cat "$ACTIVE_CONFIG_FILE")
    [[ -n "$selected" && -f "$selected" ]] && { printf '%s\n' "$selected"; return; }
  fi
  printf '%s\n' "$DEFAULT_CONFIG"
}

select_active_config() {
  local config=$1 temporary="$ACTIVE_CONFIG_FILE.tmp"
  config=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$config")
  mkdir -p "$(dirname "$ACTIVE_CONFIG_FILE")"
  printf '%s\n' "$config" > "$temporary"
  mv "$temporary" "$ACTIVE_CONFIG_FILE"
}

configure_kem() {
  case "${1:-x25519}" in
    1|x25519|X25519)
      KEM=x25519; KEM_LABEL=X25519; KEM_GROUP=X25519; KEM_SLUG=x25519;;
    2|x25519-mlkem768|x25519_mlkem768|X25519+ML-KEM768)
      KEM=x25519-mlkem768; KEM_LABEL=X25519+ML-KEM768; KEM_GROUP=X25519MLKEM768; KEM_SLUG=x25519-mlkem768;;
    3|mlkem768|ML-KEM-768)
      KEM=mlkem768; KEM_LABEL=ML-KEM-768; KEM_GROUP=mlkem768; KEM_SLUG=mlkem768;;
    *) fail 'KEM must be 1/x25519, 2/x25519-mlkem768, or 3/mlkem768.';;
  esac
  export KEM KEM_LABEL KEM_GROUP KEM_SLUG
  common=( -tls1_3 -groups "$KEM_GROUP" -ciphersuites TLS_AES_256_GCM_SHA384 )
}

select_kem() {
  local selection
  printf 'Key establishment:\n  1 X25519 (default)\n  2 X25519+ML-KEM768\n  3 ML-KEM-768\n' >&2
  read -r -p '> ' selection || selection=1
  configure_kem "${selection:-1}"
}

configure_depth() {
  X509_DEPTH=${1:-2}
  case "$X509_DEPTH" in
    2|3|4|5) X509_DEPTHS=("$X509_DEPTH");;
    all) X509_DEPTHS=(2 3 4 5);;
    *) fail 'X509_DEPTH must be 2, 3, 4, 5, or all (root included).';;
  esac
}

select_depth() {
  local selection
  printf '%s\n' 'Select X.509 trust-path depth:' \
    '  1) D=2  root -> server; 1 certificate transmitted; current/default baseline' \
    '  2) D=3  root -> intermediate -> server; 2 certificates transmitted; representative PKI' \
    '  3) D=4  root -> intermediate -> intermediate -> server; 3 certificates transmitted; deep-chain sensitivity' \
    '  4) D=5  root -> intermediate -> intermediate -> intermediate -> server; 4 certificates transmitted; stress case' \
    '  5) All D=2..5' >&2
  read -r -p 'Choice [1]: ' selection || selection=1
  case "${selection:-1}" in
    1) configure_depth 2;; 2) configure_depth 3;; 3) configure_depth 4;;
    4) configure_depth 5;; 5) configure_depth all;; *) fail 'Choice must be 1..5.';;
  esac
}

depth_output() {
  if [[ "$X509_DEPTH" == 2 ]]; then printf '%s\n' "$1"
  else printf '%s/d%s\n' "$1" "$2"; fi
}

depth_plan() {
  local depth
  for depth in "${X509_DEPTHS[@]}"; do
    printf 'X.509 trust-path depth D=%s (local root included): %s certificate(s) transmitted; root not transmitted\n' "$depth" "$((depth-1))"
    printf '  Scenario: x509-simple-d%s; output: %s\n' "$depth" "$(depth_output "$1" "$depth")"
  done
  printf 'Mutual: D includes root on BOTH server and client; MTC credentials remain unchanged.\n'
}

# Dependency resolution is shared by Native/PCAP: never prepare twice for both.
needs_mutual() {
  [[ " ${ACTIVE_CASES[*]} " == *mtc-mutual-* ]]
}

resolve_mutual_inputs() {
  local mode=$1 candidate stamp
  if [[ -n "${MUTUAL_CLIENT_ROOT:-}" ]]; then
    (validate_mutual_fixtures) || fail 'Explicit mutual fixture override invalid; preserved. No measurements started.'
    echo "Mutual clients: FOUND ($MUTUAL_CLIENT_ROOT)"
    return
  fi
  while IFS= read -r candidate; do
    MUTUAL_CLIENT_ROOT=$candidate
    if (validate_mutual_fixtures) >/dev/null 2>&1; then
      echo "Mutual clients: FOUND ($MUTUAL_CLIENT_ROOT)"
      return
    fi
  done < <(python3 - "$REPO" <<'PYM'
from pathlib import Path
import sys
repo=Path(sys.argv[1])
for p in sorted((repo/'artifacts/validation').glob('*/manifest.json'),reverse=True):
 print(p.parent.relative_to(repo))
PYM
  )
  MUTUAL_CLIENT_ROOT=
  echo 'Mutual clients: MISSING (run prepares matching nine-profile clients)'
  [[ "$mode" == run ]] || return 0
  stamp=$(date -u +%Y%m%dT%H%M%SZ)-$$
  MUTUAL_CLIENT_ROOT="artifacts/validation/handshake-performance-mutual-$stamp"
  python3 "$REPO/campaigns/validation/protocol_validation/mutual_authentication/generate_fixtures.py" \
    --performance-clients --image "$IMAGE" --output "$REPO/$MUTUAL_CLIENT_ROOT" --execute \
    || fail 'Dependency preparation failed: mutual clients. No measurements started.'
  (validate_mutual_fixtures) || fail 'Dependency validation failed: mutual clients. No measurements started.'
}

chain_path() {
  local profile depth role path
  while IFS='|' read -r profile depth role path; do
    if [[ "$profile|$depth|$role" == "$1|$2|$3" ]]; then printf '%s\n' "$path"; return; fi
  done <<< "$CHAIN_BINDINGS"
  fail "Missing resolved chain: $1 D=$2 $3"
}

resolve_dependencies() {
  local mode=${1:-inspect} chain_args=()
  printf 'Resolving dependencies: KEM=%s, depths=%s\n' "$KEM_GROUP" "${X509_DEPTHS[*]}"
  if [[ "$mode" == run ]]; then
    preflight_mtc_generation
    case "$command" in
      run-pcap*|run-native-pcap|run-single|run-mutual)
        docker image inspect "$CAPTURE_IMAGE" >/dev/null 2>&1 \
          || fail "Capture image missing: $CAPTURE_IMAGE. Run bin/base/mt-prepare rebuild 3. No measurements started.";;
    esac
  fi
  resolve_mtc_inputs "$mode"
  if [[ "$command" != run-retry ]]; then
    if needs_mutual; then
      resolve_mutual_inputs "$mode"
      chain_args+=(--mutual)
    fi
    [[ -z "${X509_CHAIN_FIXTURES:-}" ]] || chain_args+=(--preferred "$X509_CHAIN_FIXTURES")
    [[ "$mode" != run ]] || chain_args+=(--execute)
    CHAIN_BINDINGS=$(python3 -B "$REPO/campaigns/performance/handshake_performance/handshake_dependencies.py" \
      --profile "${PROFILES[@]}" --depth "${X509_DEPTHS[@]}" --image "$IMAGE" "${chain_args[@]}") \
      || fail 'Dependency preparation failed: X.509 chains. No measurements started.'
  fi
}

show_dependencies() (
  load_config "$1"
  configure_depth "${X509_DEPTH:-2}"
  resolve_dependencies inspect
  echo 'Functional readiness for the selected KEM/cases is checked only on run; no generation in status/plan.'
)

validate_selected_dependencies() (
  # Separate, unmeasured functional gate: same commands as measurements, with
  # the selected group. Existing X25519 MTC reports are NOT hybrid evidence.
  local profile case_name log server_log depth stamp output
  stamp=$(date -u +%Y%m%dT%H%M%SZ)-$$
  output="$REPO/artifacts/results/handshake-dependencies-$stamp"
  mkdir -p "$output" || fail 'Cannot create dependency validation output.'
  trap cleanup EXIT
  docker network create "$NETWORK" >/dev/null || fail 'Cannot create dependency validation network. No measurements started.'
  for depth in "${X509_DEPTHS[@]}"; do
    CURRENT_X509_DEPTH=$depth
    for profile in "${PROFILES[@]}"; do
      for case_name in "${ACTIVE_CASES[@]}"; do
        # MTC credentials do not vary with X.509 depth.
        [[ "$case_name" == x509-* || "$depth" == "${X509_DEPTHS[0]}" ]] || continue
        log="$output/$profile-$case_name-d$depth.log"
        server_log="$output/$profile-$case_name-d$depth-server.log"
        printf '  VALIDATING %s %s D=%s %s...\n' "$profile" "$case_name" "$depth" "$KEM_GROUP"
        start_server "$profile" "$case_name"
        printf 'GET / HTTP/1.0\r\n\r\n' | client_command -ign_eof >"$log" 2>&1 \
          || fail "Dependency validation failed: $profile $case_name D=$depth. Inspect $log. No measurements started."
        docker logs "$SERVER" >"$server_log" 2>&1
        grep -q 'Verify return code: 0 (ok)' "$log" &&
          grep -q 'New, TLSv1.3, Cipher is TLS_AES_256_GCM_SHA384' "$log" &&
          grep -q 'HTTP/1.0 200' "$log" \
          || fail "Dependency TLS gate failed: $log. No measurements started."
        if [[ "$case_name" == mtc-* ]]; then
          grep -q 'MTC verification: OK' "$log" || fail "MTC authentication missing: $log. No measurements started."
        fi
        if [[ "$case_name" == *-mutual* ]]; then
          grep -q 'read client certificate' "$server_log" && grep -q 'read certificate verify' "$server_log" && grep -q 'read finished' "$server_log" \
            || fail "Mutual authentication missing: $server_log. No measurements started."
        fi
        printf '  PASS %s %s D=%s %s\n' "$profile" "$case_name" "$depth" "$KEM_GROUP"
      done
    done
  done
  printf '{"passed":true,"openssl_group":"%s","depths":"%s","cases":"%s","mtc_root":"%s","mutual_root":"%s"}\n' \
    "$KEM_GROUP" "${X509_DEPTHS[*]}" "${ACTIVE_CASES[*]}" "$MTC_ROOT" "${MUTUAL_CLIENT_ROOT:-}" > "$output/validation.json"
  printf '%s\n' "$CHAIN_BINDINGS" > "$output/chains.txt"
)

default_performance_output() {
  printf 'artifacts/results/handshake-performance-%s-%s-%s\n' "$KEM_SLUG" "$(date -u +%Y%m%dT%H%M%SZ)" "$$"
}

default_retry_output() {
  printf 'artifacts/results/handshake-retry-matrix-%s-%s-%s\n' "$KEM_SLUG" "$(date -u +%Y%m%dT%H%M%SZ)" "$$"
}

config_template() {
  cat <<'EOF'
# Paths are relative to the repository and must remain below artifacts/.
KEM=x25519
X509_DEPTH=2
# Optional server-chain root override; empty discovers compatible existing cells.
X509_CHAIN_FIXTURES=
RUNS=30
WARMUPS=5
PCAP_RUNS=30

# Optional reproducible override: set both, or leave both empty for automatic resolution.
MTC_ROOT=
MTC_VALIDATION=
MUTUAL_CLIENT_ROOT=
EOF
}

create_configuration() {
  local config=$1 selected=${2:-} depth=${3:-}
  [[ ! -e "$config" ]] || fail "Configuration exists: $config"
  if [[ -n "$selected" ]]; then configure_kem "$selected"; else select_kem; fi
  if [[ -n "$depth" ]]; then configure_depth "$depth"; else select_depth; fi
  mkdir -p "$(dirname "$config")"
  config_template | sed -e "s/^KEM=x25519$/KEM=$KEM/" -e "s/^X509_DEPTH=2$/X509_DEPTH=$X509_DEPTH/" > "$config"
  select_active_config "$config"
  echo "Created $config with key establishment $KEM_LABEL ($KEM_GROUP). A run resolves or prepares and validates the required dependencies lazily before measurements start."
}

load_config() {
  local file=$1 name value
  [[ -f "$file" ]] || fail "Missing configuration: $file"

  # The file is user-controlled shell assignments. Refuse commands and expansions.
  while IFS='=' read -r name value; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    [[ "$name" =~ ^[A-Z0-9_]+$ ]] || fail "Invalid configuration key: $name"
    [[ "$value" != *'`'* && "$value" != *'$('* && "$value" != *';'* ]] || fail "Unsafe configuration value for $name"
    printf -v "$name" '%s' "$value"
    export "$name"
  done < "$file"

  : "${RUNS:?}" "${WARMUPS:?}" "${PCAP_RUNS:?}"
  [[ "$RUNS" =~ ^[1-9][0-9]*$ && "$WARMUPS" =~ ^[0-9]+$ && "$PCAP_RUNS" =~ ^[1-9][0-9]*$ ]] \
    || fail 'RUNS/WARMUPS/PCAP_RUNS must be integers.'

  configure_kem "${KEM:-x25519}"
}

# Shared integrity gate for explicit overrides, discovered pairs and new outputs.
validate_mtc_inputs() (

  [[ "${MTC_ROOT:-}" == artifacts/* ]] \
    || fail 'MTC_ROOT must be an explicit path below artifacts/.'
  [[ -f "$REPO/$MTC_ROOT/manifest.json" ]] \
    || fail "MTC_ROOT does not contain manifest.json: $MTC_ROOT"

  [[ "${MTC_VALIDATION:-}" == artifacts/* ]] \
    || fail 'MTC_VALIDATION must be an explicit path below artifacts/.'
  [[ -f "$REPO/$MTC_VALIDATION" ]] \
    || fail "Missing MTC functional validation: $MTC_VALIDATION"

  python3 - "$REPO/$MTC_ROOT" "$REPO/$MTC_VALIDATION" <<'PYVALID'
import hashlib
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
validation_path = Path(sys.argv[2])

with validation_path.open() as f:
    data = json.load(f)

if data.get("passed") is not True:
    raise SystemExit(
        "ERROR: MTC functional validation does not report passed=true: "
        + str(validation_path)
    )

fixture_hashes = data.get("fixture_hashes")
if not isinstance(fixture_hashes, dict) or not fixture_hashes:
    raise SystemExit(
        "ERROR: MTC functional validation does not contain fixture_hashes: "
        + str(validation_path)
    )

root = root.resolve()

for relative, expected in fixture_hashes.items():
    relative_path = Path(relative)

    if relative_path.is_absolute() or ".." in relative_path.parts:
        raise SystemExit(
            "ERROR: invalid fixture_hashes path: " + relative
        )

    path = (root / relative_path).resolve()

    if root not in path.parents:
        raise SystemExit(
            "ERROR: validated MTC fixture escapes MTC_ROOT: " + relative
        )

    if not path.is_file():
        raise SystemExit(
            "ERROR: validated MTC fixture is missing: " + str(path)
        )

    actual = hashlib.sha256(path.read_bytes()).hexdigest()
    if actual != expected:
        raise SystemExit(
            "ERROR: MTC fixture hash mismatch: " + str(path)
        )

print(
    f"Validated MTC fixture binding: {len(fixture_hashes)} SHA-256 hashes match."
)
PYVALID
)

preflight_mtc_generation() {
  [[ ${DEPENDENCY_DOCKER_READY:-0} == 0 ]] || return 0
  local reason rebuild='bin/base/mt-prepare rebuild 2'
  command -v docker >/dev/null 2>&1 \
    || fail 'Docker command not found. No dependencies or measurements started.'
  docker info >/dev/null 2>&1 \
    || fail 'Docker daemon is not running or is not accessible. Start Docker and retry.'
  docker image inspect "$IMAGE" >/dev/null 2>&1 \
    || fail "MTC Docker image is missing: $IMAGE. Run: $rebuild (builds mt-tls-mtc:local)."
  # Invoke the authoritative check, without entering generation/validation or
  # maintaining a second list of image-controlled source files in this driver.
  if ! reason=$(docker run --rm --network none --read-only \
      -v "$REPO:/repo:ro" --entrypoint python3 "$IMAGE" -B -c '
import sys
sys.path.insert(0, "/repo/campaigns/scaling/mtc_profile_scaling")
from workflow import require_current_mtc_image
try:
    require_current_mtc_image()
except (ValueError, OSError) as error:
    print(str(error), file=sys.stderr)
    sys.exit(1)
' 2>&1); then
    fail "MTC image preflight failed for $IMAGE. Reason: $reason. Run: $rebuild (builds mt-tls-mtc:local)."
  fi
  DEPENDENCY_DOCKER_READY=1
}

resolve_mtc_inputs() {
  local mode=${1:-inspect} candidates candidate_root candidate_validation stamp workflow
  if [[ -n "${MTC_ROOT:-}" || -n "${MTC_VALIDATION:-}" ]]; then
    [[ -n "${MTC_ROOT:-}" && -n "${MTC_VALIDATION:-}" ]] \
      || fail 'Set both MTC_ROOT and MTC_VALIDATION, or leave both empty for automatic resolution.'
    validate_mtc_inputs || fail 'Explicit MTC fixture override failed validation; no automatic fallback.'
    return
  fi
  candidates=$(python3 - "$REPO" "${PROFILES[@]}" <<'PYPAIRS'
import json
import sys
from datetime import datetime
from pathlib import Path
repo = Path(sys.argv[1])
pairs = []
for root in (repo/'artifacts/mtc').glob('n16-*'):
    # Credential bytes are KEM-independent; historical path labels are not
    # negotiated-group evidence. The selected-group gate runs separately.
    stamp = None
    for prefix in ('n16-x25519-', 'n16-x25519-mlkem768-', 'n16-x25519_mlkem768-', 'n16-mlkem768-', 'n16-x25519-mlkem512-', 'n16-x25519_mlkem512-', 'n16-mlkem512-'):
        if root.name.startswith(prefix):
            candidate = root.name[len(prefix):]
            if candidate[:4].isdigit():
                stamp = candidate
                break
    if stamp is None:
        continue
    validation = repo/'artifacts/results'/('mtc-'+root.name)/'validation.json'
    if not (root/'manifest.json').is_file() or not validation.is_file():
        continue
    try:
        date = datetime.strptime(stamp, '%Y%m%dT%H%M%SZ')
    except ValueError:
        try:
            date = datetime.strptime(stamp, '%Y%m%dT%H%M%S.%fZ')
        except ValueError:
            continue
    try:
        manifest = json.loads((root/'manifest.json').read_text())
        if 16 not in manifest.get('sizes', []) or not set(sys.argv[2:]) <= set(manifest.get('profiles', [])):
            continue
        if not all(
            (root/'batch16/mtc'/profile/'trust.bin').read_bytes()[:4] == b'MTB2'
            and (root/'batch16/mtc'/profile/'authority.bin').read_bytes()[:4] == b'MCA2'
            for profile in sys.argv[2:]
        ):
            continue
    except (OSError, ValueError, TypeError, AttributeError):
        continue
    pairs.append((date, root.relative_to(repo), validation.relative_to(repo)))
for _, root, validation in sorted(pairs, reverse=True):
    print(str(root)+'|'+str(validation))
PYPAIRS
  ) || fail 'Unable to discover existing N=16/X25519 fixture pairs.'
  while IFS='|' read -r candidate_root candidate_validation; do
    [[ -n "$candidate_root" ]] || continue
    MTC_ROOT=$candidate_root MTC_VALIDATION=$candidate_validation
    if validate_mtc_inputs >/dev/null 2>&1; then
      printf 'MTC inputs: AUTO READY (%s; %s)\n' "$MTC_ROOT" "$MTC_VALIDATION"
      return
    fi
    printf 'Skipping invalid MTC fixture pair: %s\n' "$candidate_root" >&2
  done <<< "$candidates"
  MTC_ROOT= MTC_VALIDATION=
  if [[ "$mode" != run ]]; then
    echo 'MTC inputs: AUTO PENDING (run will generate and functionally validate N=16/X25519).'
    return
  fi
  preflight_mtc_generation
  stamp=$(python3 -c 'from datetime import datetime, timezone; print(datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ"))')
  MTC_ROOT="artifacts/mtc/n16-x25519-$stamp"
  MTC_VALIDATION="artifacts/results/mtc-n16-x25519-$stamp/validation.json"
  workflow="$REPO/campaigns/scaling/mtc_profile_scaling/workflow.py"
  [[ ! -e "$REPO/$MTC_ROOT" && ! -e "$REPO/${MTC_VALIDATION%/*}" ]] \
    || fail 'New MTC dependency paths already exist; preserving them.'
  printf 'Preparing N=16/X25519 dependencies: %s\n' "$MTC_ROOT"
  python3 "$workflow" generate --sizes 16 --image "$IMAGE" --output "$REPO/$MTC_ROOT" --execute \
    || fail "Unable to generate N=16/X25519 dependency: $MTC_ROOT. Partial outputs preserved; no measurements started."
  printf 'Validating N=16/X25519 dependencies...\n'
  python3 "$workflow" validate --fixtures "$REPO/$MTC_ROOT" --image "$IMAGE" --output "$REPO/${MTC_VALIDATION%/*}" --execute \
    || fail "Functional validation failed for N=16/X25519: $MTC_VALIDATION. Outputs preserved; no measurements started."
  validate_mtc_inputs || fail 'Generated MTC dependencies failed the integrity/PASS gate; no measurements started.'
  printf 'Validation PASS\nMTC dependencies ready:\n  MTC_ROOT=%s\n  MTC_VALIDATION=%s\n' "$MTC_ROOT" "$MTC_VALIDATION"
}

show_mtc_inputs() (
  local MTC_ROOT MTC_VALIDATION
  MTC_ROOT=$(sed -nE 's/^MTC_ROOT=//p' "$1" | tail -1)
  MTC_VALIDATION=$(sed -nE 's/^MTC_VALIDATION=//p' "$1" | tail -1)
  resolve_mtc_inputs inspect
  if [[ -n "$MTC_ROOT" ]]; then
    printf 'Server fixtures: READY (%s)\nMTC functional validation: READY (%s)\n' "$MTC_ROOT" "$MTC_VALIDATION"
  fi
)

load_plan_counts() {
  local file=$1 name value

  KEM=x25519
  X509_DEPTH=2
  X509_CHAIN_FIXTURES=
  RUNS=
  WARMUPS=
  PCAP_RUNS=

  while IFS='=' read -r name value; do
    case "$name" in
      KEM|RUNS|WARMUPS|PCAP_RUNS|X509_DEPTH|X509_CHAIN_FIXTURES)
        printf -v "$name" '%s' "$value"
        ;;
    esac
  done < "$file"

  : "${RUNS:?Missing RUNS in $file}"
  : "${WARMUPS:?Missing WARMUPS in $file}"
  : "${PCAP_RUNS:?Missing PCAP_RUNS in $file}"

  [[ "$RUNS" =~ ^[1-9][0-9]*$ &&
     "$WARMUPS" =~ ^[0-9]+$ &&
     "$PCAP_RUNS" =~ ^[1-9][0-9]*$ ]] ||
    fail 'RUNS/WARMUPS/PCAP_RUNS must be integers.'
  configure_kem "$KEM"
  configure_depth "$X509_DEPTH"
}

# Fixture provenance must not replace the performance KEM selection. Bash
# locals isolate same-named assignments while keeping fixture paths available.
load_fixture_paths() {
  local KEM="${KEM:-}" KEM_LABEL="${KEM_LABEL:-}" KEM_GROUP="${KEM_GROUP:-}" KEM_SLUG="${KEM_SLUG:-}"
  source "$REPO/.mt-state/cert-scaling/paths.env"
}

ensure_dependencies() {
  resolve_dependencies run
  MTC16=$MTC_ROOT
  MTC_VALID=${MTC_VALIDATION%/*}
  (ACTIVE_CASES=(mtc-simple-landmark); X509_DEPTHS=(2); validate_selected_dependencies)     || fail 'Retry dependency validation failed. No measurements started.'
  echo 'ALL REQUIRED DEPENDENCIES READY'
}

ensure_kem_supported() {
  # OpenSSL 3.4 does not expose `openssl list -tls-groups` consistently.
  # Every client/server command receives -groups explicitly, so OpenSSL itself
  # performs the authoritative capability check when that scenario starts.
  case "$KEM_GROUP" in
    X25519|X25519MLKEM768|mlkem768) ;;
    *) fail "Unsupported configured TLS group: $KEM_GROUP";;
  esac
  printf 'Key establishment: %s (OpenSSL group %s)\n' "$KEM_LABEL" "$KEM_GROUP"
}

ensure_retry_group_support() {
  local help
  help=$(docker run --rm --network none --entrypoint /opt/mtc/retry-peer "$IMAGE" --help 2>&1 || true)
  [[ "$help" == *MTC_TLS_GROUP* ]] || fail 'Retry peer lacks configurable TLS-group support. Run bin/base/mt-prepare rebuild 2 explicitly, then retry.'
}

inside() { printf '/work/%s' "${1#artifacts/}"; }
common=()
configure_kem x25519

validate_mutual_fixtures() {
  local profile relative

  [[ "${MUTUAL_CLIENT_ROOT:-}" == artifacts/* ]] \
    || fail 'MUTUAL_CLIENT_ROOT must be configured for mutual authentication.'

  [[ -f "$REPO/$MUTUAL_CLIENT_ROOT/manifest.json" ]] \
    || fail "Missing mutual fixture manifest: $MUTUAL_CLIENT_ROOT/manifest.json"

  python3 - "$REPO/$MUTUAL_CLIENT_ROOT" <<'PYMUTUAL' || return
import hashlib
import json
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
manifest_path = root / "manifest.json"

with manifest_path.open() as f:
    data = json.load(f)

if data.get("schema") != 1:
    raise SystemExit(
        "ERROR: unsupported mutual fixture manifest schema: "
        + repr(data.get("schema"))
    )

if data.get("purpose") != "nine-profile matching mutual-authentication clients":
    raise SystemExit(
        "ERROR: unexpected mutual fixture manifest purpose: "
        + repr(data.get("purpose"))
    )

if data.get("status") != "PREPARED_NOT_VALIDATED":
    raise SystemExit(
        "ERROR: unexpected mutual fixture manifest status: "
        + repr(data.get("status"))
    )

expected_profiles = [
    "ecdsa-p256", "ecdsa-p384", "ecdsa-p521",
    "mldsa44", "mldsa65", "mldsa87",
    "slhdsa128s", "slhdsa192s", "slhdsa256s",
]

if data.get("profiles") != expected_profiles:
    raise SystemExit(
        "ERROR: mutual fixture manifest does not contain the expected profiles."
    )

if data.get("mtc_tree_size") != 16:
    raise SystemExit(
        "ERROR: mutual fixture manifest does not report mtc_tree_size=16."
    )

file_hashes = data.get("file_sha256")
if not isinstance(file_hashes, dict) or not file_hashes:
    raise SystemExit(
        "ERROR: mutual fixture manifest does not contain file_sha256."
    )

for relative, expected in file_hashes.items():
    relative_path = Path(relative)

    if relative_path.is_absolute() or ".." in relative_path.parts:
        raise SystemExit(
            "ERROR: invalid mutual file_sha256 path: " + relative
        )

    path = (root / relative_path).resolve()

    if root not in path.parents:
        raise SystemExit(
            "ERROR: mutual fixture escapes MUTUAL_CLIENT_ROOT: " + relative
        )

    if not path.is_file():
        raise SystemExit(
            "ERROR: mutual fixture is missing: " + str(path)
        )

    actual = hashlib.sha256(path.read_bytes()).hexdigest()
    if actual != expected:
        raise SystemExit(
            "ERROR: mutual fixture hash mismatch: " + str(path)
        )

print(
    f"Validated mutual-client fixture binding: "
    f"{len(file_hashes)} SHA-256 hashes match."
)
PYMUTUAL

  for profile in "${PROFILES[@]}"; do
    for relative in \
      x509/client.pem \
      x509/client.key \
      x509/client-ca.pem \
      mtc-source/client-0000.key \
      mtc-n16/landmark-0000.pem \
      mtc-n16/standalone-0000.pem \
      mtc-n16/trust.bin \
      mtc-n16/authority.bin \
      mtc-n16/manifest.json
    do
      [[ -f "$REPO/$MUTUAL_CLIENT_ROOT/profiles/$profile/$relative" ]] \
        || fail "Missing mutual client fixture: $MUTUAL_CLIENT_ROOT/profiles/$profile/$relative"
    done
  done
}

case_args() {
  local profile=$1 case_name=$2
  local population="$MTC_ROOT/population/$1"
  local mtc="$MTC_ROOT/batch16/mtc/$1"
  local ca_id client client_mtc client_id

  case_name=${case_name%-d[2-5]}
  ca_id=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["ca_id"])' "$REPO/$mtc/manifest.json")
  server_args=()
  client_args=()

  case "$case_name" in
    x509-simple)
      server_args=(-cert "$(inside "$population/0.pem")" -key "$(inside "$population/0.key")")
      client_args=(-CAfile "$(inside "$population/ca.pem")" -verify_hostname server)
      if [[ "${CURRENT_X509_DEPTH:-2}" != 2 ]]; then
        local chain
        chain=$(chain_path "$profile" "$CURRENT_X509_DEPTH" server)
        server_args=(-cert "$(inside "$chain/server.pem")" -key "$(inside "$chain/server.key")" -cert_chain "$(inside "$chain/intermediates.pem")")
        client_args=(-CAfile "$(inside "$chain/root.pem")" -verify_hostname server)
      fi
      ;;
    mtc-simple-landmark)
      server_args=(-cert "$(inside "$mtc/landmark-0000.pem")" -key "$(inside "$population/0.key")" -mtc_id "$ca_id.1.1.1" -mtc_landmark)
      client_args=(-mtc_trust "$(inside "$mtc/trust.bin")" -mtc_landmark)
      ;;
    mtc-simple-standalone)
      server_args=(-cert "$(inside "$mtc/standalone-0000.pem")" -key "$(inside "$population/0.key")" -mtc_id "$ca_id")
      client_args=(-mtc_trust "$(inside "$mtc/authority.bin")")
      ;;
    x509-mutual|mtc-mutual-landmark|mtc-mutual-standalone)
      [[ "${MUTUAL_CLIENT_ROOT:-}" == artifacts/* ]] \
        || fail 'MUTUAL_CLIENT_ROOT is required for mutual-authentication cases.'
      client="$MUTUAL_CLIENT_ROOT/profiles/$profile"
      client_mtc="$client/mtc-n16"

      [[ -f "$REPO/$client_mtc/manifest.json" ]] \
        || fail "Missing mutual client manifest: $client_mtc/manifest.json"

      client_id=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["ca_id"])' "$REPO/$client_mtc/manifest.json")

      case "$case_name" in
        x509-mutual)
          server_args=(-cert "$(inside "$population/0.pem")" -key "$(inside "$population/0.key")" -CAfile "$(inside "$client/x509/client-ca.pem")" -Verify 1 -verify_return_error)
          client_args=(-CAfile "$(inside "$population/ca.pem")" -verify_hostname server -cert "$(inside "$client/x509/client.pem")" -key "$(inside "$client/x509/client.key")")
          if [[ "${CURRENT_X509_DEPTH:-2}" != 2 ]]; then
            local chain client_chain
            chain=$(chain_path "$profile" "$CURRENT_X509_DEPTH" server)
            client_chain=$(chain_path "$profile" "$CURRENT_X509_DEPTH" client)
            server_args=(-cert "$(inside "$chain/server.pem")" -key "$(inside "$chain/server.key")" -cert_chain "$(inside "$chain/intermediates.pem")" -CAfile "$(inside "$client_chain/root.pem")" -Verify "$((CURRENT_X509_DEPTH-2))" -verify_return_error)
            client_args=(-CAfile "$(inside "$chain/root.pem")" -verify_hostname server -cert "$(inside "$client_chain/server.pem")" -key "$(inside "$client_chain/server.key")" -cert_chain "$(inside "$client_chain/intermediates.pem")")
          fi
          ;;
        mtc-mutual-landmark)
          server_args=(-cert "$(inside "$mtc/landmark-0000.pem")" -key "$(inside "$population/0.key")" -mtc_id "$ca_id.1.1.1" -mtc_client_trust "$(inside "$client_mtc/trust.bin")" -mtc_landmark -Verify 1 -verify_return_error)
          client_args=(-mtc_trust "$(inside "$mtc/trust.bin")" -mtc_landmark -cert "$(inside "$client_mtc/landmark-0000.pem")" -key "$(inside "$client/mtc-source/client-0000.key")" -mtc_client_id "$client_id.1.1.1")
          ;;
        mtc-mutual-standalone)
          server_args=(-cert "$(inside "$mtc/standalone-0000.pem")" -key "$(inside "$population/0.key")" -mtc_id "$ca_id" -mtc_client_trust "$(inside "$client_mtc/authority.bin")" -Verify 1 -verify_return_error)
          client_args=(-mtc_trust "$(inside "$mtc/authority.bin")" -cert "$(inside "$client_mtc/standalone-0000.pem")" -key "$(inside "$client/mtc-source/client-0000.key")" -mtc_client_id "$client_id")
          ;;
      esac
      ;;
    *) fail "Unknown case: $case_name";;
  esac
}

cleanup() {
  docker rm -f "$SERVER" "${SERVER}-capture" >/dev/null 2>&1 || true
  docker network rm "$NETWORK" >/dev/null 2>&1 || true
}

start_server() {
  local profile=$1 case_name=$2
  case_args "$profile" "$case_name"
  docker rm -f "$SERVER" >/dev/null 2>&1 || true
  docker run -d --name "$SERVER" --network "$NETWORK" -v "$REPO/artifacts:/work:ro" \
    --entrypoint /opt/mtc/openssl.sh "$IMAGE" s_server -accept 4433 \
    "${server_args[@]}" "${common[@]}" -num_tickets 0 -www -state >/dev/null
  # No probe connection: only wait for the server process to remain alive.
  sleep 1
  docker inspect "$SERVER" --format '{{.State.Running}}' | grep -qx true || fail "$case_name server did not remain running"
}

client_command() {
  docker run --rm -i --network "$NETWORK" -v "$REPO/artifacts:/work:ro" \
    --entrypoint /opt/mtc/openssl.sh "$IMAGE" s_client -connect "$SERVER:4433" -servername server \
    "${client_args[@]}" "${common[@]}" -no_ticket -verify_return_error -lab_metrics "$@"
}

prepare_run() {
  local output=$1 help_output
  [[ "$output" == "$REPO"/artifacts/results/* ]] || fail 'OUTPUT must be a new absolute path below artifacts/results/.'
  [[ ! -e "$output" ]] || fail "Output exists: $output"
  case "$command" in
    run-native|run-native-single|run-native-mutual) mt_images_required "$IMAGE" || return;;
    run-pcap|run-pcap-single|run-pcap-mutual|run-native-pcap|run-single|run-mutual) mt_images_required "$IMAGE" "$CAPTURE_IMAGE" || return;;
  esac
  ensure_kem_supported
  if [[ "$command" == run-native || "$command" == run-native-single || "$command" == run-native-mutual || "$command" == run-native-pcap || "$command" == run-single || "$command" == run-mutual ]]; then
    help_output=$(docker run --rm --network none --entrypoint /opt/mtc/openssl.sh "$IMAGE" \
      s_client -help 2>&1) \
      || fail 'Unable to inspect native TCP/TLS timing support in the active MTC image.'
    [[ "$help_output" == *lab_metrics* ]] \
      || fail 'The active MTC image lacks native TCP/TLS timing. Run bin/base/mt-prepare rebuild 2, then retry with a new output.'
  fi
  mkdir -p "$output/raw" "$output/pcap"
  docker network create "$NETWORK" >/dev/null
}

measure_native() {
  local output=$1 profile case_name phase count repetition log start end elapsed read written tcp_ms handshake_ms establishment_ms done_count=0 total_count started now eta
  total_count=$(( ${#PROFILES[@]} * ${#ACTIVE_CASES[@]} * (WARMUPS + RUNS) )); started=$(date +%s)
  printf 'profile,case,key_establishment,openssl_group,phase,repetition,tcp_connect_wall_ms_native,handshake_wall_ms,connection_establishment_wall_ms_native,process_wall_ms,tls_bytes_read,tls_bytes_written,tls_bytes_total\n' > "$output/native.csv"
  printf '\nNATIVE MEASUREMENTS — 9 profiles × %d authentication cases\n' "${#ACTIVE_CASES[@]}"
  for profile in "${PROFILES[@]}"; do
   for case_name in "${ACTIVE_CASES[@]}"; do
    printf '\n[NATIVE] profile=%s case=%s: starting server\n' "$profile" "$case_name"
    start_server "$profile" "$case_name"
    for phase in warmup measured; do
      [[ "$phase" == warmup ]] && count=$WARMUPS || count=$RUNS
      printf '[NATIVE] profile=%s case=%s phase=%s repetitions=%d\n' "$profile" "$case_name" "$phase" "$count"
      for ((repetition=1; repetition<=count; repetition++)); do
        log="$output/raw/native-${profile}-${case_name}-${phase}-${repetition}.log"
        start=$(python3 -c 'import time; print(time.monotonic_ns())')
        printf 'TLS_GROUP_CONFIGURED {"key_establishment":"%s","openssl_group":"%s"}\n' "$KEM_LABEL" "$KEM_GROUP" > "$log"
        printf 'GET / HTTP/1.0\r\n\r\n' | client_command >>"$log" 2>&1 || fail "$case_name $phase $repetition failed; inspect $log"
        printf 'TLS_GROUP_NEGOTIATED {"key_establishment":"%s","openssl_group":"%s","evidence":"successful TLS 1.3 handshake with a single configured group"}\n' "$KEM_LABEL" "$KEM_GROUP" >> "$log"
        end=$(python3 -c 'import time; print(time.monotonic_ns())')
        grep -q 'Verify return code: 0 (ok)' "$log" || fail "$case_name did not verify"
        read=$(sed -nE 's/.*SSL handshake has read ([0-9]+) bytes and written ([0-9]+) bytes.*/\1/p' "$log" | tail -1)
        written=$(sed -nE 's/.*SSL handshake has read ([0-9]+) bytes and written ([0-9]+) bytes.*/\2/p' "$log" | tail -1)
        [[ -n "$read" && -n "$written" ]] || fail "$case_name byte counters missing"
        read -r tcp_ms handshake_ms establishment_ms < <(python3 - "$log" <<'PYMETRICS'
import json,re,sys
text=open(sys.argv[1],errors='replace').read(); matches=re.findall(r'NATIVE_METRICS\s+(\{[^\n]+\})',text)
valid=[]
for match in matches:
 try: valid.append(json.loads(match))
 except json.JSONDecodeError: pass
if valid:
 d=valid[-1]
else:
 # Docker may interleave stderr metrics with buffered stdout from s_client.
 broken=re.search(r'NATIVE_METRICS\s+\{\"tcp_connect_wall_ms_native\":.*?([0-9]+(?:\.[0-9]+)?),\"handshake_wall_ms\":([0-9]+(?:\.[0-9]+)?),\"connection_establishment_wall_ms_native\":([0-9]+(?:\.[0-9]+)?)\}',text,re.S)
 if not broken: raise SystemExit('ERROR: NATIVE_METRICS record missing')
 d=dict(zip(('tcp_connect_wall_ms_native','handshake_wall_ms','connection_establishment_wall_ms_native'),map(float,broken.groups())))
values=[d.get(k) for k in ('tcp_connect_wall_ms_native','handshake_wall_ms','connection_establishment_wall_ms_native')]
if any(v is None for v in values): raise SystemExit('ERROR: native TCP/TLS metric is unavailable')
print(*values)
PYMETRICS
)
        [[ -n "$tcp_ms" && -n "$handshake_ms" && -n "$establishment_ms" ]] || fail "$profile $case_name native TCP/TLS metrics missing; inspect $log"
        elapsed=$(python3 -c "print(($end-$start)/1000000)")
        printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' "$profile" "$case_name" "$KEM_LABEL" "$KEM_GROUP" "$phase" "$repetition" "$tcp_ms" "$handshake_ms" "$establishment_ms" "$elapsed" "$read" "$written" "$((read+written))" >> "$output/native.csv"
        done_count=$((done_count+1)); now=$(date +%s); eta=$(( done_count ? (now-started)*(total_count-done_count)/done_count : 0 ))
        printf '[NATIVE] %d/%d profile=%s case=%s %s=%d tcp=%sms tls=%sms complete=%sms process=%sms tls_bytes=%d elapsed=%ds eta=%ds\n' "$done_count" "$total_count" "$profile" "$case_name" "$phase" "$repetition" "$tcp_ms" "$handshake_ms" "$establishment_ms" "$elapsed" "$((read+written))" "$((now-started))" "$eta"
      done
    done
   done
  done
}

measure_pcap() {
  local output=$1 profile case_name phase count repetition directory pcap keylog log capture_log analysis_log analysis_values analysis_status ready attempt done_count=0 total_count started now eta
  local -a analyzer_args
  total_count=$(( ${#PROFILES[@]} * ${#ACTIVE_CASES[@]} * (WARMUPS + PCAP_RUNS) )); started=$(date +%s)
  printf 'profile,case,key_establishment,openssl_group,phase,repetition,tcp_handshake_ms,tcp_syn_to_clienthello_ms,tls_clienthello_to_client_finished_ms,tcp_syn_to_first_application_request_ms,tls_client_handshake_bytes,tls_server_handshake_bytes,tls_handshake_bytes,tls_client_handshake_wire_bytes,tls_server_handshake_wire_bytes,tls_handshake_wire_bytes,tcp_handshake_wire_bytes,connection_handshake_wire_bytes,tls_client_handshake_packets,tls_server_handshake_packets,tls_handshake_packets,tls_client_certificate_bytes,tls_server_certificate_bytes,tcp_stream,client_random,analysis_status,analysis_error,tcp_retransmission_packets\n' > "$output/pcap.csv"
  printf '\nPCAP MEASUREMENTS — 9 profiles × %d authentication cases\n' "${#ACTIVE_CASES[@]}"
  for profile in "${PROFILES[@]}"; do
   for case_name in "${ACTIVE_CASES[@]}"; do
    printf '\n[PCAP] profile=%s case=%s: %d warmups + %d measured captures\n' "$profile" "$case_name" "$WARMUPS" "$PCAP_RUNS"
    for phase in warmup measured; do
     [[ "$phase" == warmup ]] && count=$WARMUPS || count=$PCAP_RUNS
     printf '[PCAP] profile=%s case=%s phase=%s repetitions=%d\n' "$profile" "$case_name" "$phase" "$count"
     for ((repetition=1; repetition<=count; repetition++)); do
      start_server "$profile" "$case_name"
      directory="$output/pcap/${profile}-${case_name}-${phase}-${repetition}"; mkdir "$directory"
      pcap="$directory/handshake.pcap"; keylog="$directory/keylog.txt"; log="$directory/client.log"; capture_log="$directory/tcpdump.log"
      docker run -d --name "${SERVER}-capture" --network "container:$SERVER" --cap-add NET_RAW --cap-add NET_ADMIN \
        -v "$directory:/capture" --entrypoint tcpdump "$CAPTURE_IMAGE" \
        -i eth0 -s 0 -U -w /capture/handshake.pcap 'tcp port 4433' >/dev/null
      ready=no
      for ((attempt=1; attempt<=100; attempt++)); do
        docker logs "${SERVER}-capture" > "$capture_log" 2>&1 || true
        if grep -q 'listening on eth0' "$capture_log"; then ready=yes; break; fi
        if [[ "$(docker inspect -f '{{.State.Running}}' "${SERVER}-capture" 2>/dev/null || true)" != true ]]; then break; fi
        sleep 0.1
      done
      [[ "$ready" == yes ]] || fail "$case_name PCAP capture did not become ready; inspect $capture_log"
      client_args+=( -keylogfile /out/keylog.txt )
      printf 'TLS_GROUP_CONFIGURED {"key_establishment":"%s","openssl_group":"%s"}\n' "$KEM_LABEL" "$KEM_GROUP" > "$log"
      printf 'GET / HTTP/1.0\r\n\r\n' | docker run --rm -i --network "$NETWORK" -v "$REPO/artifacts:/work:ro" -v "$directory:/out" \
        --entrypoint /opt/mtc/openssl.sh "$IMAGE" s_client -connect "$SERVER:4433" -servername server \
        "${client_args[@]}" "${common[@]}" -no_ticket -verify_return_error >>"$log" 2>&1 || fail "$case_name PCAP run failed"
      printf 'TLS_GROUP_NEGOTIATED {"key_establishment":"%s","openssl_group":"%s","evidence":"successful TLS 1.3 handshake with a single configured group"}\n' "$KEM_LABEL" "$KEM_GROUP" >> "$log"
      # Let libpcap drain accepted packets, then request tcpdump's clean flush.
      sleep 1.2
      docker kill --signal=SIGINT "${SERVER}-capture" >/dev/null
      docker wait "${SERVER}-capture" >/dev/null || true
      docker logs "${SERVER}-capture" > "$capture_log" 2>&1 || true
      docker rm "${SERVER}-capture" >/dev/null
      [[ -s "$pcap" && "$(wc -c < "$pcap")" -gt 24 ]] || fail "$case_name PCAP contains no packet records; inspect $capture_log"
      grep -Eq '[1-9][0-9]* packets captured' "$capture_log" || fail "$case_name tcpdump reported zero captured packets; inspect $capture_log"
      analysis_log="$directory/tshark.tsv"
      docker run --rm --network none -v "$directory:/capture:ro" --entrypoint tshark "$CAPTURE_IMAGE" \
        -o tls.keylog_file:/capture/keylog.txt -r /capture/handshake.pcap -Y 'tcp.port == 4433' \
        -T fields -E separator=/t -E occurrence=a -E aggregator=, \
        -e frame.time_epoch -e frame.number -e frame.len -e tcp.stream \
        -e ip.src -e ip.dst -e ipv6.src -e ipv6.dst -e tcp.srcport -e tcp.dstport \
        -e tcp.flags.syn -e tcp.flags.ack -e tcp.seq -e tcp.ack -e tcp.len -e tcp.payload \
        -e tls.handshake.type -e tls.handshake.length -e tls.handshake.random \
        -e tls.record.length -e http.request.method \
        -e tcp.analysis.retransmission -e tcp.analysis.fast_retransmission -e tcp.analysis.spurious_retransmission \
        >"$analysis_log" 2>"$directory/tshark.stderr" \
        || fail "$profile $case_name tshark analysis failed; inspect $directory/tshark.stderr"
      analyzer_args=()
      [[ "$case_name" != *-mutual ]] || analyzer_args+=(--expect-client-certificate)
      if analysis_values=$(python3 "$REPO/campaigns/performance/handshake_performance/pcap_handshake.py" "$analysis_log" --format csv "${analyzer_args[@]}" 2>>"$directory/tshark.stderr"); then
        analysis_status=OK
      else
        analysis_status=ERROR
      fi
      printf '%s,%s,%s,%s,%s,%s,%s\n' "$profile" "$case_name" "$KEM_LABEL" "$KEM_GROUP" "$phase" "$repetition" "$analysis_values" >> "$output/pcap.csv"
      done_count=$((done_count+1)); now=$(date +%s); eta=$(( done_count ? (now-started)*(total_count-done_count)/done_count : 0 ))
      printf '[PCAP] %d/%d profile=%s case=%s %s=%d analysis=%s elapsed=%ds eta=%ds\n' "$done_count" "$total_count" "$profile" "$case_name" "$phase" "$repetition" "$analysis_status" "$((now-started))" "$eta"
     done
    done
   done
  done
}

write_summary() {
  local output=$1
  CHAIN_BINDINGS="${CHAIN_BINDINGS:-}" python3 - "$output" "$KEM" "$KEM_LABEL" "$KEM_GROUP" "$CURRENT_X509_DEPTH" "${X509_CHAIN_FIXTURES:-}" <<'PY'
import csv,json,math,os,statistics,sys
from pathlib import Path

depth=int(sys.argv[5])
override=sys.argv[6]
bindings=[]
for line in os.environ.get('CHAIN_BINDINGS','').splitlines():
 parts=line.split('|',3)
 if len(parts)==4:
  profile,binding_depth,role,path=parts
  if binding_depth==str(depth):
   bindings.append({
    'profile':profile,
    'depth_including_root':int(binding_depth),
    'role':role,
    'path':path,
   })

if depth <= 2:
 fixture_provenance={
  'source':'baseline',
  'description':'original MTC population X.509 baseline',
 }
elif bindings:
 fixture_provenance={
  'source':'override' if override else 'resolved',
  'configured_override':override or None,
  'bindings':bindings,
 }
else:
 fixture_provenance={
  'source':'override' if override else 'unresolved',
  'configured_override':override or None,
  'bindings':[],
 }

root=Path(sys.argv[1]); result={
 'key_establishment':{'id':sys.argv[2],'label':sys.argv[3],'openssl_group':sys.argv[4]},
 'x509_trust_path':{'depth_including_root':depth,'transmitted_certificates':depth-1,'root_transmitted':False,
                    'fixtures':fixture_provenance,
                    'scope':'X.509 only; MTC credentials unchanged; mutual uses D on both sides'},
 'mutual_authentication':{'signature_pairing':'client_and_server_use_the_same_profile'},
 'definitions':{
 'process_wall_ms':'host monotonic time around one Docker client process; includes process/container overhead',
 'tcp_connect_wall_ms_native':'native client connection entry through successful TCP connect return',
 'handshake_wall_ms':'native TLS handshake start through handshake completion',
 'connection_establishment_wall_ms_native':'native connection entry through TLS handshake completion',
 'tls_bytes_total':'OpenSSL TLS handshake bytes read plus written; excludes IP/TCP headers',
 'tcp_handshake_ms':'PCAP time from initial client TCP SYN to the corresponding client ACK completing the three-way handshake',
 'tcp_syn_to_clienthello_ms':'PCAP time from initial client TCP SYN to the first client ClientHello',
 'tls_clienthello_to_client_finished_ms':'PCAP time from the first client ClientHello to the client Finished',
