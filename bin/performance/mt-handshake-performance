run_retry_profile_inner() {
  local profile=$1 requested=$2 progress_offset=${3:-0} progress_total=${4:-70}
  local output mtc trust cert key
  mtc="$MTC16/batch16/mtc/$profile"; trust="$mtc/trust.bin"; cert="$mtc/landmark-0000.pem"; key="$MTC16/population/$profile/0.key"
  output=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$requested")
  [[ ! -e "$output" ]] || fail "Output exists: $output"
  printf '\n[RETRY] profile=%s mode=full output=%s\n' "$profile" "$requested"
  docker run --rm --network none -e PYTHONDONTWRITEBYTECODE=1 \
    -v "$REPO:/repo:ro" -v "$REPO/artifacts:/repo/artifacts" -w /repo \
    --entrypoint python3 "$IMAGE" \
    campaigns/validation/protocol_validation/mtc_retry/run.py full \
    --root "/repo/$requested" --peer /opt/mtc/retry-peer \
    --trust "/repo/$trust" --cert "/repo/$cert" --key "/repo/$key" --profile "$profile" \
    --progress-offset "$progress_offset" --progress-total "$progress_total"
}

validate_retry_profile() {
  local profile=$1 item found=no
  for item in "${PROFILES[@]}"; do [[ "$item" != "$profile" ]] || found=yes; done
  [[ "$found" == yes ]] || fail "Unsupported retry profile: $profile"
}

run_retry_profile() {
  local profile=$1 requested=${2:-artifacts/results/handshake-retry-${1}-$(date -u +%Y%m%dT%H%M%SZ)-$$}
  local output report
  validate_retry_profile "$profile"
  [[ "$requested" == artifacts/results/* ]] || fail 'Retry OUTPUT must be a new directory below artifacts/results/.'
  ensure_dependencies
  mt_images_required "$IMAGE" || return
  source "$REPO/.mt-state/cert-scaling/paths.env"
  run_retry_profile_inner "$profile" "$requested" 0 70
  output=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$requested")
  report="$REPO/artifacts/reports/$(basename "$requested")/report.html"
  python3 "$RETRY_REPORTER" retry \
    "$output" --output "$report" --replace
  printf 'Completed Trust Anchor Retry performance.\nJSON report: %s\nHTML report: %s\n' "$output/summary.json" "$report"
}

run_retry_matrix() {
  local requested=${1:-artifacts/results/handshake-retry-matrix-$(date -u +%Y%m%dT%H%M%SZ)-$$}
  local output report report_root profile profile_output profile_report index=0
  local started_epoch ended_epoch total_profiles=${#PROFILES[@]} total_transactions=$(( ${#PROFILES[@]} * 70 ))
  [[ "$requested" == artifacts/results/* ]] || fail 'Retry OUTPUT must be a new directory below artifacts/results/.'
  output=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$requested")
  [[ ! -e "$output" ]] || fail "Output exists: $output"
  ensure_dependencies
  mt_images_required "$IMAGE" || return
  source "$REPO/.mt-state/cert-scaling/paths.env"
  mkdir -p "$output"
  report_root="$REPO/artifacts/reports/$(basename "$requested")"
  started_epoch=$(date +%s)
  printf '\nMTC TRUST ANCHOR RETRY PERFORMANCE — 9 PROFILES\nMode: simple server authentication\nTransactions: %d (70 per profile)\nOutput: %s\n\n' "$total_transactions" "$requested"
  for profile in "${PROFILES[@]}"; do
    index=$((index + 1))
    profile_output="$requested/$profile"
    printf '\n[RETRY PROFILE %d/%d] %s\n' "$index" "$total_profiles" "$profile"
    run_retry_profile_inner "$profile" "$profile_output" "$(( (index - 1) * 70 ))" "$total_transactions"
    profile_report="$report_root/$profile/report.html"
    python3 "$RETRY_REPORTER" retry \
      "$output/$profile" --output "$profile_report" --replace
  done
  ended_epoch=$(date +%s)
  report="$report_root/report.html"
  python3 "$RETRY_MATRIX_REPORTER" "$output" --output "$report" \
    --started-epoch "$started_epoch" --ended-epoch "$ended_epoch"
  printf '\nCompleted nine-profile Trust Anchor Retry performance.\nJSON report: %s\nHTML report: %s\nProfile reports: %s\n' \
    "$output/matrix-summary.json" "$report" "$report_root"
}

status_config() {
  local config=${1:-$DEFAULT_CONFIG}
  if [[ ! -f "$config" ]]; then
    printf 'Configuration: MISSING (%s)\nRun init or select initialization from the menu.\n' "$config"
    return 1
  fi
  printf 'Configuration: %s\n' "$config"
  if grep -q REPLACE "$config" || ! grep -q '^MTC_ROOT=' "$config"; then
    echo 'Status: INCOMPLETE (the first measurement will prepare dependencies and configure it automatically).'
  else
    echo 'Status: CONFIGURED'
  fi
  sed -nE 's/^(RUNS|WARMUPS|PCAP_RUNS|MTC_ROOT)=/  \1=/p' "$config"
  printf 'Profiles: %s\nCases: %s\n' "${PROFILES[*]}" "${CASES[*]}"
}

menu() {
  local choice profile
  while true; do
    printf '\nHandshake performance\n'
    printf ' 1 Initialize configuration\n'
    printf ' 2 Status\n'
    printf ' 3 Plan\n'
    printf ' 4 Run Native — single authentication (9 profiles × 3 cases)\n'
    printf ' 5 Run Native — mutual authentication (9 profiles × 3 cases)\n'
    printf ' 6 Run PCAP — single authentication (9 profiles × 3 cases)\n'
    printf ' 7 Run PCAP — mutual authentication (9 profiles × 3 cases)\n'
    printf ' 8 Run Native + PCAP — single authentication\n'
    printf ' 9 Run Native + PCAP — mutual authentication\n'
    printf '10 Run Native + PCAP — all 6 cases\n'
    printf '11 Run Trust Anchor Retry performance (all 9 profiles)\n'
    printf ' 0 Back\n'
    read -r -p '> ' choice || return 0
    case "$choice" in
      1) "$SELF" init || true;;
      2) "$SELF" status || true;;
      3) "$SELF" plan || true;;
      4) "$SELF" run-native-single || true;;
      5) "$SELF" run-native-mutual || true;;
      6) "$SELF" run-pcap-single || true;;
      7) "$SELF" run-pcap-mutual || true;;
      8) "$SELF" run-single || true;;
      9) "$SELF" run-mutual || true;;
      10) "$SELF" run-native-pcap || true;;
      11) "$SELF" run-retry || true;;
      0) return 0;;
      *) echo 'Unknown option.';;
    esac
  done
}

command=${1:-menu}
case "$command" in
  menu) menu;;
  init)
    [[ $# -le 2 ]] || fail 'Usage: init [CONFIG]'
    config=${2:-$DEFAULT_CONFIG}
    [[ ! -e "$config" ]] || fail "Configuration exists: $config"
    mkdir -p "$(dirname "$config")"; config_template > "$config"
    echo "Created $config. A run will replace the placeholders automatically from the active validated fixtures."
    ;;
  status)
    [[ $# -le 2 ]] || fail 'Usage: status [CONFIG]'
    status_config "${2:-$DEFAULT_CONFIG}"
    ;;
  plan)
    [[ $# -le 3 ]] || fail 'Usage: plan [CONFIG] [OUTPUT]'
    config=${2:-$DEFAULT_CONFIG}
    output=${3:-artifacts/results/handshake-performance-$(date -u +%Y%m%dT%H%M%SZ)-$$}

    [[ -f "$config" ]] || fail "Missing configuration: $config. Run $SELF init first."

    load_plan_counts "$config"

    echo "Cases: ${CASES[*]}"
    echo "Profiles (9): ${PROFILES[*]}"
    echo "Matrix: $(( ${#PROFILES[@]} * ${#CASES[@]} )) profile/authentication scenarios"
    echo "Single subset: $(( ${#PROFILES[@]} * ${#SINGLE_CASES[@]} )) scenarios (${SINGLE_CASES[*]})"
    echo "Mutual subset: $(( ${#PROFILES[@]} * ${#MUTUAL_CASES[@]} )) scenarios (${MUTUAL_CASES[*]})"
    echo "Native observations: $(( ${#PROFILES[@]} * ${#CASES[@]} * (RUNS + WARMUPS) )) (warmups included)"
    echo "PCAP observations: $(( ${#PROFILES[@]} * ${#CASES[@]} * PCAP_RUNS ))"
    echo "Native: $RUNS measured repetitions + $WARMUPS warmups per scenario; OpenSSL handshake bytes"
    echo "PCAP: $PCAP_RUNS independent captures per scenario; ClientHello-to-Finished duration and wire bytes"
    echo "Retry: 9-profile simple-authentication matrix; 70 transactions/profile, 630 total"
    echo "Config: $config"
    echo "Output: $output"

    if grep -q REPLACE "$config" || ! grep -q '^MTC_ROOT=' "$config"; then
      echo 'Configuration status: INCOMPLETE; run-native/run-pcap/run-native-pcap will prepare or reuse dependencies and configure it automatically.'
    else
      echo 'Configuration status: no REPLACE placeholders found; file and credential checks occur before execution.'
    fi
    ;;
  run-retry)
    [[ $# -le 2 ]] || fail 'Usage: run-retry [OUTPUT]'
    run_retry_matrix "${2:-}"
    ;;
  run-native|run-native-single|run-native-mutual|run-pcap|run-pcap-single|run-pcap-mutual|run-native-pcap|run-single|run-mutual|run-all)
    if [[ "$command" == run-all ]]; then
      echo 'Compatibility alias: run-all means run-native-pcap.'
      command=run-native-pcap
    fi
    case "$command" in
      *-single|run-single) ACTIVE_CASES=("${SINGLE_CASES[@]}");;
      *-mutual|run-mutual) ACTIVE_CASES=("${MUTUAL_CASES[@]}");;
      *) ACTIVE_CASES=("${CASES[@]}");;
    esac
    started_epoch=$(date +%s)
    [[ $# -le 3 ]] || fail "Usage: $command [CONFIG] [OUTPUT]"
    config=${2:-$DEFAULT_CONFIG}
    requested_output=${3:-artifacts/results/handshake-performance-$(date -u +%Y%m%dT%H%M%SZ)-$$}
    if [[ ! -f "$config" ]]; then
      mkdir -p "$(dirname "$config")"; config_template > "$config"
    fi
    if grep -q REPLACE "$config" || ! grep -q '^MTC_ROOT=' "$config"; then
      ensure_dependencies
      write_automatic_config "$config"
    fi
    load_config "$config"; output=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$requested_output")
    trap cleanup EXIT INT TERM
    prepare_run "$output"
    case "$command" in
      run-native|run-native-single|run-native-mutual) measure_native "$output";;
      run-pcap|run-pcap-single|run-pcap-mutual) measure_pcap "$output";;
      run-native-pcap|run-single|run-mutual) measure_native "$output"; measure_pcap "$output";;
    esac
    write_summary "$output"
    report="$REPO/artifacts/reports/$(basename "$output")/report.html"
    python3 "$REPORTER" "$output/summary.json" --output "$report" \
      --mode "$command" --started-epoch "$started_epoch" --ended-epoch "$(date +%s)"
    cleanup; trap - EXIT INT TERM
    printf 'Completed: %s\nJSON report: %s\nHTML report: %s\n' "$output" "$output/summary.json" "$report"
    ;;
  help|-h|--help) usage;;
  *) usage; exit 2;;
esac
