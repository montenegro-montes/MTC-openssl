#!/usr/bin/env bash
set -euo pipefail

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$REPO"
source "$REPO/bin/lib/docker-preflight.sh"

COMPOSE_FILES="
base:docker/historical_campaigns/compose.yaml
compact:docker/historical_campaigns/compose.compact.yaml
profile:docker/historical_campaigns/compose.profile.yaml
mtc:docker/historical_campaigns/compose.mtc.yaml
measurement:docker/historical_campaigns/compose.measurement.yaml
scaling:docker/historical_campaigns/compose.scaling.yaml
latency:docker/network/compose.latency.yaml
bandwidth:docker/network/compose.bandwidth.yaml
loss:docker/network/compose.loss.yaml
combined:docker/network/compose.combined.yaml
capture:docker/historical_campaigns/compose.capture.yaml
"

usage() {
  cat <<'EOF'
Usage: bin/containers/mt-containers COMMAND [TARGET] [OPTIONS]

Active images are built by bin/containers/mt-install or bin/base/mt-prepare.
The TARGET commands below operate on frozen historical Compose definitions.

Commands:
  list                         list active images and historical Compose targets
  doctor                       check Docker, Compose, disk and project images
  ps [all|TARGET]              show project containers
  build TARGET                 build one Compose target
  build-chain [network-measurement|network]  repair the current network image chain
  up TARGET [SERVICE]          start a project or one service
  down [all|TARGET]            stop containers and remove project networks
  restart TARGET [SERVICE]     recreate a project or service
  logs TARGET [SERVICE]        follow logs
  shell TARGET SERVICE [CMD]   open a shell or run CMD in a running container
  run TARGET SERVICE [ARGS...] run an ephemeral service container
  images                       list mt-tls-* images
  inspect-image IMAGE          show image identity and creation metadata
  remove-images [--yes]        remove project images after stopping projects
  reset-images [--yes|--dry-run] remove project containers/images and unused <none> images
  clean [--yes]                stop every project and remove orphan containers
  menu                         interactive menu

Current network targets: latency bandwidth loss combined
Historical targets: base compact profile mtc measurement scaling capture

This tool does not delete artifacts or campaign results. Use
bin/artifacts/mt-archive --clean-artifacts only after archiving results.
EOF
}

compose_file() {
  case "${1:-}" in
    base) echo docker/historical_campaigns/compose.yaml ;;
    compact) echo docker/historical_campaigns/compose.compact.yaml ;;
    profile) echo docker/historical_campaigns/compose.profile.yaml ;;
    mtc) echo docker/historical_campaigns/compose.mtc.yaml ;;
    measurement) echo docker/historical_campaigns/compose.measurement.yaml ;;
    scaling) echo docker/historical_campaigns/compose.scaling.yaml ;;
    latency) echo docker/network/compose.latency.yaml ;;
    bandwidth) echo docker/network/compose.bandwidth.yaml ;;
    loss) echo docker/network/compose.loss.yaml ;;
    combined) echo docker/network/compose.combined.yaml ;;
    capture) echo docker/historical_campaigns/compose.capture.yaml ;;
    *) echo "Unknown target: ${1:-<empty>}" >&2; return 2 ;;
  esac
}

project_name() {
  case "${1:-}" in
    base) echo mt ;;
    compact) echo mtcompact ;;
    profile) echo mtprofile ;;
    mtc) echo mtclab ;;
    measurement) echo controlledn16 ;;
    scaling) echo mtscaling ;;
    latency) echo mtlatency ;;
    bandwidth) echo mtbandwidth ;;
    loss) echo mtloss ;;
    combined) echo mtcombined ;;
    capture) echo mtcapture ;;
    *) echo "Unknown target: ${1:-<empty>}" >&2; return 2 ;;
  esac
}

targets() { printf '%s\n' base compact profile mtc measurement scaling latency bandwidth loss combined capture; }
compose() {
 local f target=$1 action=$2 parent=''
 f=$(compose_file "$target") || return; shift 2
 mt_compose_inputs "$f" "$action" "$@" || return
 if [[ "$action" == build ]]; then
  case "$target" in
   compact) parent=mt-tls-lab:local;; profile) parent=mt-tls-compact:local;; mtc) parent=mt-tls-profile:local;;
   measurement) parent=mt-tls-mtc:local;; capture) parent=mt-tls-measurement:local;; latency|bandwidth|loss|combined) parent=mt-tls-network:local;;
  esac
  [[ -z "$parent" ]] || mt_image_required "$parent" || return
 fi
 docker compose -f "$f" "$action" "$@"
}
confirm() {
  [ "${1:-}" = "--yes" ] && return 0
  printf 'Continue? [y/N] '
  read -r answer || return 1
  case "$answer" in y|Y|yes|YES) return 0;; *) echo "Cancelled"; return 1;; esac
}

list_targets() {
  cat <<'EOF'
ACTIVE IMAGE CHAIN (use mt-install or mt-prepare)
mt-tls-lab:local      base TLS/X.509 environment
mt-tls-mtc:local      experimental MTC implementation
mt-tls-capture:local  packet capture and protocol inspection

CURRENT NETWORK COMPOSE TARGETS
latency      fixed-delay campaign
bandwidth    bandwidth-limited campaign
loss         packet-loss campaign
combined     combined network profiles

FROZEN HISTORICAL COMPOSE TARGETS
base         original OpenSSL/PQ/Merkle laboratory
compact      Compact Merkle fixtures and benchmark
profile      former detailed timing instrumentation
mtc          former MTC Compose implementation
measurement  former controlled N=16 measurement image
scaling      former Merkle population scaling
capture      former TLS handshake packet capture
EOF
}

doctor() {
  mt_compose_ready || return
  local failed=0
  command -v docker >/dev/null || { echo "FAIL docker command missing"; failed=1; }
  if command -v docker >/dev/null; then
    docker version >/dev/null 2>&1 && echo "PASS Docker daemon" || { echo "FAIL Docker daemon"; failed=1; }
    docker compose version >/dev/null 2>&1 && echo "PASS Docker Compose" || { echo "FAIL Docker Compose"; failed=1; }
    echo
    docker image ls --filter reference='mt-tls-*' --format 'IMAGE {{.Repository}}:{{.Tag}}  {{.ID}}  {{.Size}}' || true
    echo
    docker system df || true
  fi
  [ "$failed" -eq 0 ]
}

project_ps() {
  local project
  project=$(project_name "$1")
  docker ps -a --filter "label=com.docker.compose.project=$project" \
    --format 'table {{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Image}}'
}

project_down() {
  local project containers networks
  project=$(project_name "$1")
  containers=$(docker ps -aq --filter "label=com.docker.compose.project=$project")
  if [ -n "$containers" ]; then
    # Deliberate word splitting passes each Docker ID as one argument.
    docker rm -f $containers || return
  else
    echo "No containers for Compose project $project"
  fi
  networks=$(docker network ls -q --filter "label=com.docker.compose.project=$project")
  if [ -n "$networks" ]; then
    docker network rm $networks || return
  else
    echo "No networks for Compose project $project"
  fi
}

all_down() {
  local target
  for target in $(targets); do
    echo "==> down $target"
    project_down "$target" || true
  done
}

reset_images() {
  local option=${1:-} tags ids containers='' id image target remaining
  case "$option" in ''|--yes|--dry-run) ;; *) echo 'ERROR: Usage: reset-images [--yes|--dry-run]' >&2; return 2;; esac
  tags=$(docker image ls --filter reference='mt-tls-*' --format '{{.Repository}}:{{.Tag}}') || return
  ids=$(docker image ls --no-trunc --filter reference='mt-tls-*' -q | sort -u) || return
  local inventory
  inventory=$(docker ps -a --no-trunc --format '{{.ID}} {{.Image}}') || return
  while read -r id image; do
    [[ -n "$id" ]] || continue
    case "$image" in
      mt-tls-*) containers="$containers $id";;
      *) if [[ -n "$ids" ]] && printf '%s\n' "$ids" | grep -Fxq "$image"; then containers="$containers $id"; fi;;
    esac
  done <<< "$inventory"
  echo 'Project image tags selected:'
  printf '%s\n' "${tags:-<none found>}"
  echo 'Unused untagged images currently selected by Docker:'
  docker image ls --filter dangling=true || return
  echo 'WARNING: This stops/removes project containers and their writable layers, removes mt-tls-* image tags, and prunes ALL unused untagged (<none>) images on the active Docker daemon, including images from other projects.'
  echo 'Campaign files and results on the host are preserved. Images must be rebuilt before running campaigns again.'
  [[ "$option" != --dry-run ]] || return 0
  confirm "$option" || return 1
  # Stop known Compose projects plus ephemeral/dynamic project-image containers.
  for target in $(targets); do project_down "$target" || return; done
  if [[ -n "$containers" ]]; then
    # Some containers were already removed by project_down.
    for id in $containers; do
      if docker container inspect "$id" >/dev/null 2>&1; then docker rm -f "$id" || return; fi
    done
  fi
  # Remove tags, not image IDs: preserve unrelated aliases of a shared image.
  # Retry parents after child images have been removed; stop if no progress.
  while [[ -n "$tags" ]]; do
    remaining=''
    for image in $tags; do
      if ! docker image rm "$image"; then remaining="$remaining $image"; fi
    done
    if [[ -n "$remaining" ]]; then
      local before_count after_count
      before_count=$(printf '%s\n' $tags | wc -l)
      after_count=$(printf '%s\n' $remaining | wc -l)
      if [[ "$before_count" -eq "$after_count" ]]; then
        echo 'ERROR: Some project images remain in use or have dependent images. Inspect the Docker errors above; cleanup is incomplete.' >&2
        return 1
      fi
    fi
    tags=$remaining
  done
  docker image prune --force || return
  remaining=$(docker image ls --filter reference='mt-tls-*' -q) || return
  [[ -z "$remaining" ]] || { echo 'ERROR: Project images remain; another build may be active.' >&2; return 1; }
  echo 'Project image reset completed. Untagged images referenced by other containers and build cache are retained by Docker.'
}

menu() {
  while :; do
    cat <<'EOF'

Container manager (historical Compose targets)
  1) doctor       2) ps all       3) images
  4) build        5) up           6) logs
  7) shell        8) down         9) clean all
  10) reset project images + unused <none> images
  0) exit
EOF
    printf 'Selection: '; read -r choice
    case "$choice" in
      1) doctor || true;; 2) "$0" ps all;; 3) "$0" images;;
      4) printf 'Target: '; read -r t; "$0" build "$t";;
      5) printf 'Target: '; read -r t; "$0" up "$t";;
      6) printf 'Target: '; read -r t; "$0" logs "$t";;
      7) printf 'Target: '; read -r t; printf 'Service: '; read -r s; "$0" shell "$t" "$s";;
      8) printf 'Target: '; read -r t; "$0" down "$t";;
      9) "$0" clean;; 10) "$0" reset-images || true;; 0) return;; *) echo "Invalid selection";;
    esac
  done
}

cmd=${1:-help}; shift || true
case "$cmd" in
 ps|images|inspect-image|down|remove-images|reset-images|clean) mt_docker_ready || exit 1;;
 build-chain) mt_compose_ready || exit 1;;
esac
case "$cmd" in
  help|-h|--help) usage ;;
  list) list_targets ;;
  doctor) doctor ;;
  ps)
    target=${1:-all}
    if [ "$target" = all ]; then for t in $(targets); do echo "==> $t"; project_ps "$t" || true; done
    else project_ps "$target"; fi ;;
  build) [ "$#" -ge 1 ] || { usage; exit 2; }; compose "$1" build ;;
  build-chain) python3 -m campaigns.common.image_chain "${1:-network}" ;;
  up) [ "$#" -ge 1 ] || { usage; exit 2; }; t=$1; shift; compose "$t" up -d --force-recreate "$@" ;;
  down)
    target=${1:-all}; if [ "$target" = all ]; then all_down; else project_down "$target"; fi ;;
  restart) [ "$#" -ge 1 ] || { usage; exit 2; }; t=$1; shift; compose "$t" up -d --force-recreate "$@" ;;
  logs) [ "$#" -ge 1 ] || { usage; exit 2; }; t=$1; shift; compose "$t" logs "$@" -f --tail=200 ;;
  shell)
    [ "$#" -ge 2 ] || { usage; exit 2; }; t=$1; s=$2; shift 2
    if [ "$#" -gt 0 ]; then compose "$t" exec "$s" "$@"; else compose "$t" exec "$s" sh; fi ;;
  run) [ "$#" -ge 2 ] || { usage; exit 2; }; t=$1; s=$2; shift 2; compose "$t" run --rm "$s" "$@" ;;
  images) docker image ls --filter reference='mt-tls-*' ;;
  inspect-image) [ "$#" -eq 1 ] || { usage; exit 2; }; docker image inspect "$1" ;;
  reset-images) [[ "$#" -le 1 ]] || { usage; exit 2; }; reset_images "${1:-}";;
  remove-images)
    yes=${1:-}; echo "This stops projects and removes local mt-tls-* images."; confirm "$yes"
    all_down
    ids=$(docker image ls --filter reference='mt-tls-*' -q | sort -u)
    [ -z "$ids" ] || docker image rm $ids ;;
  clean)
    yes=${1:-}; echo "This stops every project and removes its containers and networks."; confirm "$yes"; all_down ;;
  menu) menu ;;
  *) echo "Unknown command: $cmd" >&2; usage; exit 2 ;;
esac
