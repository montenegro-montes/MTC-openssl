#!/usr/bin/env python3
"""Create a small, checksummed publication snapshot and optionally clean artifacts."""

from __future__ import annotations

import argparse
import datetime as dt
import errno
import hashlib
import json
import shutil
import subprocess
import tempfile
from pathlib import Path


REPO = Path(__file__).resolve().parents[2]
RESULTS = REPO / "artifacts" / "results"
ARCHIVES = REPO / "results"

# One final, validated directory per completed experiment. Update this registry
# when a new definitive campaign replaces one of these results.
CAMPAIGNS = {
    "controlled-n16": "paper-n16-20260910T050955152797Z",
    "scaling": "scaling-20260910T055410560403Z",
    "network-latency": "network-latency-final-20260910-135401",
    "network-bandwidth": "network-bandwidth-20260911-164832",
    "packet-loss": "network-loss-20260910-212643",
    "combined-network": "combined-network-20260911-001540",
    "pcma-stage-a": "pcma-stage-a-20260911-125123",
    "pcma-stage-a2": "pcma-stage-a2-20260911-164640",
    "pcma-stage-b1": "pcma-stage-b1-20260911-180725",
}

ALLOWED_SUFFIXES = {".csv", ".json", ".md", ".tex"}
EXCLUDED_NAMES = {
    "all-samples.csv", "all-warmups.csv", "components.csv", "observations.csv",
    "samples.csv", "sequences.json", "environment.json", "images.json",
    "complete.json",
    "detail-components.csv", "detail-samples.csv", "network-validation.csv",
    "fixture-sha256.json", "scaling-fixture-sha256.json", "result-sha256.json",
}
EXCLUDED_PARTS = {"logs", "server-metrics", "source", "captures"}
PUBLICATION_SUBDIRS = {"analysis", "analysis-reviewed", "decision", "tables"}
SECRET_SUFFIXES = {".key", ".pem", ".der", ".bin", ".pcap", ".pcapng", ".log"}


def digest(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def git(*args: str) -> str:
    return subprocess.check_output(["git", *args], cwd=REPO, text=True).strip()


def publishable(relative: Path) -> bool:
    return (
        relative.suffix.lower() in ALLOWED_SUFFIXES
        and relative.suffix.lower() not in SECRET_SUFFIXES
        and relative.name not in EXCLUDED_NAMES
        and not EXCLUDED_PARTS.intersection(relative.parts)
        and not relative.name.startswith(".")
        and (len(relative.parts) == 1 or relative.parts[0] in PUBLICATION_SUBDIRS)
    )


def copy_publication_file(source: Path, destination: Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    data = source.read_bytes()
    # Publication metadata must not expose operator-specific absolute paths.
    for original, replacement in (
        (str(REPO).encode(), b"<REPO>"),
        (str(Path.home()).encode(), b"<HOME>"),
    ):
        data = data.replace(original, replacement)
    destination.write_bytes(data)


def status_is_complete(source: Path) -> bool:
    markers = list(source.glob("*status.json"))
    campaign = source / "campaign-status.json"
    if campaign.exists():
        value = json.loads(campaign.read_text()).get("passed")
        if value is False:
            return False
    analysis = source / "analysis-status.json"
    if analysis.exists() and json.loads(analysis.read_text()).get("passed") is not True:
        return False
    if source.name.startswith("pcma-stage-a2-"):
        decision = source / "decision" / "go-no-go.json"
        return decision.exists() and json.loads(decision.read_text()).get("outcome") == "GO"
    if source.name.startswith("pcma-stage-b1-"):
        analysis = source / "analysis" / "analysis.json"
        return (source / "complete.json").exists() and analysis.exists() and json.loads(analysis.read_text()).get("audit", {}).get("status") == "PASS"
    return bool(markers or (source / "analysis.json").exists() or (source / "report.md").exists())


def build_snapshot(campaigns: dict[str, str]) -> Path:
    missing = [name for name in campaigns.values() if not (RESULTS / name).is_dir()]
    if missing:
        raise SystemExit("Missing definitive result directories: " + ", ".join(missing))
    invalid = [name for name in campaigns.values() if not status_is_complete(RESULTS / name)]
    if invalid:
        raise SystemExit("Results do not pass completion checks: " + ", ".join(invalid))

    ARCHIVES.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="result-snapshot-", dir=ARCHIVES) as temporary:
        stage = Path(temporary)
        entries = []
        for campaign, dirname in campaigns.items():
            source = RESULTS / dirname
            target = stage / "campaigns" / campaign
            copied = 0
            for item in sorted(source.rglob("*")):
                if not item.is_file():
                    continue
                relative = item.relative_to(source)
                if not publishable(relative):
                    continue
                destination = target / relative
                copy_publication_file(item, destination)
                entries.append({
                    "campaign": campaign,
                    "source": str(Path("artifacts/results") / dirname / relative),
                    "archive": str(Path("campaigns") / campaign / relative),
                    "bytes": destination.stat().st_size,
                    "sha256": digest(destination),
                })
                copied += 1
            if not copied:
                raise SystemExit(f"No publication files selected for {campaign}")

        payload = "\n".join(f'{x["sha256"]}  {x["archive"]}' for x in entries) + "\n"
        content_hash = hashlib.sha256(payload.encode()).hexdigest()
        timestamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        manifest = {
            "format": "mt-tls-result-snapshot-v1",
            "created_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
            "snapshot_content_sha256": content_hash,
            "repository_head": git("rev-parse", "HEAD"),
            "repository_status": git("status", "--short"),
            "campaigns": campaigns,
            "selection": {
                "allowed_suffixes": sorted(ALLOWED_SUFFIXES),
                "excluded_names": sorted(EXCLUDED_NAMES),
                "excluded_parts": sorted(EXCLUDED_PARTS),
                "raw_observations_included": False,
            },
            "files": entries,
        }
        (stage / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
        (stage / "SHA256SUMS").write_text(payload)
        final = ARCHIVES / f"campaign-snapshot-{timestamp}-{content_hash[:12]}"
        if final.exists():
            raise SystemExit(f"Snapshot already exists: {final}")
        shutil.move(str(stage), final)
    return final


def verify(snapshot: Path) -> None:
    manifest = json.loads((snapshot / "manifest.json").read_text())
    lines = []
    for entry in manifest["files"]:
        path = snapshot / entry["archive"]
        if not path.is_file() or path.stat().st_size != entry["bytes"] or digest(path) != entry["sha256"]:
            raise SystemExit("Snapshot verification failed: " + entry["archive"])
        lines.append(f'{entry["sha256"]}  {entry["archive"]}')
    payload = "\n".join(lines) + "\n"
    if hashlib.sha256(payload.encode()).hexdigest() != manifest["snapshot_content_sha256"]:
        raise SystemExit("Snapshot content hash mismatch")
    if (snapshot / "SHA256SUMS").read_text() != payload:
        raise SystemExit("SHA256SUMS mismatch")


def clean_artifacts() -> None:
    target = REPO / "artifacts"
    for attempt in range(3):
        if not target.exists():
            return
        try:
            shutil.rmtree(target)
            return
        except OSError as error:
            # Finder may recreate .DS_Store while a large tree is disappearing.
            # Retry only the final non-empty-directory race; propagate all other
            # errors instead of weakening the guarded cleanup.
            if error.errno != errno.ENOTEMPTY or attempt == 2:
                raise
    raise RuntimeError("artifacts cleanup did not complete")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--verify", type=Path, help="verify an existing snapshot")
    parser.add_argument("--campaign", action="append", default=[], metavar="NAME=PATH",
                        help="archive a named result directory; repeat to override the built-in registry")
    parser.add_argument("--clean-artifacts", action="store_true", help="delete artifacts only after creating and verifying a snapshot")
    args = parser.parse_args()
    if args.verify:
        snapshot = args.verify.resolve()
        verify(snapshot)
        print("PASS", snapshot)
        if args.clean_artifacts:
            clean_artifacts()
            print("CLEANED", REPO / "artifacts")
        return
    campaigns = CAMPAIGNS
    if args.campaign:
        campaigns = {}
        for value in args.campaign:
            if "=" not in value:
                raise SystemExit("--campaign requires NAME=PATH")
            name, path = value.split("=", 1)
            result = Path(path)
            try:
                relative = result.resolve().relative_to(RESULTS.resolve())
            except ValueError:
                raise SystemExit("Campaign path must be below artifacts/results: " + path)
            if not name or len(relative.parts) != 1:
                raise SystemExit("Campaign name/path must identify one result directory: " + value)
            campaigns[name] = relative.name
    snapshot = build_snapshot(campaigns)
    verify(snapshot)
    print("SNAPSHOT", snapshot)
    if args.clean_artifacts:
        clean_artifacts()
        print("CLEANED", REPO / "artifacts")


if __name__ == "__main__":
    main()
