#!/usr/bin/env bash
# Read-only dependency checks; never installs, builds or starts containers.
set -eu
case "${1:-}" in
  help|-h|--help)
    echo 'Usage: bin/base/mt-doctor [--offline] [--quiet] [--core]'
    echo '--offline: do not invoke Docker; --core: omit plotting dependencies.'
    exit 0;;
esac
if ! command -v python3 >/dev/null 2>&1; then
  echo 'ERROR: python3 is missing. Install Python >= 3.10 (Debian/Ubuntu: sudo apt-get install python3 python3-venv python3-pip). See docs/installation.md.' >&2
  exit 1
fi
exec python3 -B - "$@" <<'PY'
import argparse
import importlib
import shutil
import subprocess
import sys

parser = argparse.ArgumentParser(description='Read-only host dependency check')
parser.add_argument('--offline', action='store_true')
parser.add_argument('--quiet', action='store_true')
parser.add_argument('--core', action='store_true')
a = parser.parse_args()
errors = []

def check(ok, label, remedy):
    if not ok:
        errors.append(label)
        print('MISSING/UNAVAILABLE: ' + label + '\n  ' + remedy, file=sys.stderr)
    elif not a.quiet:
        print('OK: ' + label)

check(sys.version_info >= (3, 10), 'Python >= 3.10 (' + sys.executable + ')',
      'Install Python >= 3.10 and select it in PATH before creating the virtual environment.')
for tool in ('bash', 'git', 'docker', 'awk', 'sed', 'grep', 'sort', 'tee', 'date', 'mkdir', 'dirname'):
    check(shutil.which(tool) is not None, tool,
          'Install Docker Engine + Compose v2 (or Docker Desktop) and add docker to PATH.'
          if tool == 'docker' else
          'Install Git and add it to PATH (Debian/Ubuntu: sudo apt-get install git).'
          if tool == 'git' else 'Install the host shell/utilities; see docs/installation.md.')
if not a.core:
    try:
        # Import the rendering backend as well: find_spec alone misses broken installs.
        importlib.import_module('matplotlib.backends.backend_agg')
    except Exception as error:
        check(False, 'matplotlib/Agg (' + type(error).__name__ + ')',
              'From the repository root: python3 -m venv .venv; . .venv/bin/activate; '
              'python3 -m pip install -r requirements-host.txt. Keep this environment activated.')
    else:
        check(True, 'matplotlib/Agg', '')
if not a.offline and shutil.which('docker'):
    for command, label, remedy in (
        (['docker', 'compose', 'version'], 'Docker Compose v2',
         'Install the Docker Compose v2 plugin for your Docker installation.'),
        (['docker', 'info'], 'Docker daemon access',
         'Start Docker Engine/Desktop; check docker context show and socket permissions. '
         'On Linux, check sudo systemctl status docker. Do not make the socket world-writable.'),
    ):
        try:
            ok = subprocess.run(command, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, timeout=15).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            ok = False
        check(ok, label, remedy)
if errors:
    print('Dependency check failed before execution. See docs/installation.md.', file=sys.stderr)
    sys.exit(1)
if not a.quiet:
    print('Host dependencies OK. ' + ('Docker Compose/daemon NOT CHECKED (--offline). ' if a.offline else '')
          + 'Images, fixtures and scientific behavior are not validated by this check.')
PY
