#!/usr/bin/env bash
# Shared images and launcher configuration; no original campaign execution.
set -euo pipefail
REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SELF="$REPO/bin/base/mt-prepare"
cd "$REPO"
source "$REPO/bin/lib/docker-preflight.sh"
STATE="$REPO/.mt-state/cryptographic-setup"
REPORTER="$REPO/bin/renders/prepare.py"
source "$REPO/bin/lib/image-catalog.sh"
fail() { echo "ERROR: $*" >&2; exit 1; }
configure_paths() {
 local launcher config command
 for launcher in mt-cert-scaling mt-protocol-validation; do
  case "$launcher" in
   mt-cert-scaling) config=cert-scaling; command="$REPO/bin/cryptographic_scaling/$launcher";;
   *) config=protocol-validation; command="$REPO/bin/base/$launcher";;
  esac
  if [[ -f "$REPO/.mt-state/$config/paths.env" ]]; then
   printf 'KEEP existing configuration: %s\n' "$launcher"
  else
   "$command" init || return "$?"
  fi
 done
 echo 'Launcher paths are ready. N=16 fixtures still require mt-cert-scaling run 50 and run 60.'
}
prepare_fixtures() (
 source "$REPO/.mt-state/cert-scaling/paths.env"
 [[ ! -d "$REPO/.mt-state/cert-scaling/lock" && ! -d "$REPO/.mt-state/cert-scaling/batch.lock" ]] || fail 'A certification stage or batch is active.'
 echo 'Preparing X.509 chain fixtures D=2,3,4,5.'
 if [[ ! -e "$CHAIN_FIXTURES" && ! -L "$CHAIN_FIXTURES" ]]; then
  "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 20 || exit "$?"
 fi
 # Check every cell before validation; never repair an existing partial fixture root.
 python3 -B - "$CHAIN_FIXTURES" <<'PYCHAIN'
import json, sys
from pathlib import Path
sys.path.insert(0, 'campaigns/scaling/cert_chain_scaling')
from config import PROFILES, DEPTHS
from result_state import validate_fixture
root = Path(sys.argv[1])
for profile in PROFILES:
 for depth in DEPTHS:
  directory = root/profile/f'depth-{depth}'
  try:
   validate_fixture(directory, profile, depth)
   metadata = json.loads((directory/'manifest.json').read_text())
   for name in ('root.pem','root.key','server.pem','server.key','intermediates.pem','server-chain.pem'):
    if not (directory/name).is_file() or name not in metadata['files_sha256']: raise ValueError('Missing file/hash: '+name)
  except Exception as error:
   raise SystemExit(f'ERROR: {profile} D={depth}: {directory}: {error}. Fixtures preserved; inspect and select a fresh CHAIN_FIXTURES/CHAIN_VALID path.')
PYCHAIN
 [[ "$?" == 0 ]] || exit 1
 if [[ ! -e "$CHAIN_VALID" && ! -L "$CHAIN_VALID" ]]; then
  "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 30 || exit "$?"
 fi
 python3 -B - "$CHAIN_VALID" "$CHAIN_FIXTURES" <<'PYCHAIN'
import json, sys
from pathlib import Path
sys.path.insert(0, 'campaigns/scaling/cert_chain_scaling')
from config import PROFILES, DEPTHS
report = json.loads(Path(sys.argv[1]).read_text())
root = Path(sys.argv[2]).resolve()
expected = {(str(root/p/f'depth-{d}'), p, d) for p in PROFILES for d in DEPTHS}
checks = report.get('checks', [])
actual = {(str(Path(c['fixture']).resolve()), c['profile'], c['depth']) for c in checks if c.get('chain_valid') is True}
if report.get('passed') is not True or actual != expected or len(checks) != len(expected):
 raise SystemExit('ERROR: Existing CHAIN_VALID is failed/incomplete or belongs to other fixtures. Evidence preserved; select fresh paths after inspection.')
print('PASS X.509 D=2..5 fixtures and existing chain validation')
PYCHAIN
 [[ "$?" == 0 ]] || exit 1
 echo 'Preparing N=16 fixtures and functional TLS validation (nine profiles, both modes).'
 if [[ ! -e "$MTC16" ]]; then
  "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 50 || exit "$?"
 else
  [[ -f "$MTC16/manifest.json" ]] || fail "Incomplete fixtures preserved at $MTC16. Inspect them and select a fresh MTC16 path."
  echo "REUSE fixture root: $MTC16 (validation required)"
 fi
 if [[ ! -e "$MTC_VALID" ]]; then
  "$REPO/bin/cryptographic_scaling/mt-cert-scaling" run 60 || exit "$?"
 fi
 python3 - "$MTC_VALID/validation.json" "$MTC16" <<'PY'
import json, subprocess, sys
from pathlib import Path
from campaigns.scaling.mtc_profile_scaling.workflow import gate
try:
    image = json.loads(subprocess.check_output(['docker','image','inspect','mt-tls-mtc:local'],text=True))[0]['Id']
    gate(Path(sys.argv[1]), Path(sys.argv[2]), image)
except Exception as error:
    raise SystemExit('ERROR: Existing N=16 evidence cannot be reused: '+str(error)+'. Outputs are preserved; inspect them and select fresh MTC16/MTC_VALID paths as needed.')
print('PASS N=16 fixtures, image, source hashes and functional validation')
PY
 local performance_clients="$REPO/artifacts/validation/handshake-performance-mutual-v2"
 if [[ ! -e "$performance_clients" && ! -L "$performance_clients" ]]; then
  python3 "$REPO/campaigns/validation/protocol_validation/mutual_authentication/generate_fixtures.py" \
   --output "$performance_clients" --performance-clients --execute || exit "$?"
 fi
 python3 -B - "$performance_clients" <<'PYCLIENTS'
import hashlib, json, sys
from pathlib import Path
sys.path.insert(0, 'campaigns/scaling/cert_chain_scaling')
from config import PROFILES
root = Path(sys.argv[1])
try:
 manifest = json.loads((root/'manifest.json').read_text())
 assert set(manifest['profiles']) == set(PROFILES) and manifest['mtc_tree_size'] == 16
 files = manifest['file_sha256']
 for profile in PROFILES:
  for name in ('x509/client.pem','x509/client.key','x509/client-ca.pem','mtc-source/client-0000.key',
               'mtc-n16/landmark-0000.pem','mtc-n16/standalone-0000.pem','mtc-n16/trust.bin',
               'mtc-n16/authority.bin','mtc-n16/manifest.json'):
   assert f'profiles/{profile}/{name}' in files
 for name, digest in files.items():
  path = Path(name)
  assert not path.is_absolute() and '..' not in path.parts
  assert hashlib.sha256((root/path).read_bytes()).hexdigest() == digest, name
except Exception as error:
 raise SystemExit(f'ERROR: Incomplete/invalid mutual fixtures preserved at {root}: {error}. Inspect before preparing a fresh path.')
print('PASS mutual client fixture completeness/hashes; no TLS measurement executed')
PYCLIENTS
 [[ "$?" == 0 ]] || exit 1
 local FIX KEY PROFILE
 source "$REPO/.mt-state/protocol-validation/paths.env"
 [[ "${PROFILE:-pq}" == mldsa65 && "$FIX" == "$MTC16/batch16/mtc/mldsa65" && "$KEY" == "$MTC16/population/mldsa65/0.key" ]] || fail 'Existing protocol paths/profile differ from the prepared Paper-1 fixtures. They were preserved; inspect mt-protocol-validation status before changing them.'
 [[ -f "$FIX/manifest.json" && -f "$KEY" ]] || fail 'Prepared protocol fixtures or server key are missing.'
)
configure() (
 mkdir -p "$STATE"
 mkdir "$STATE/lock" 2>/dev/null || fail 'Setup is active or its lock needs inspection.'
 trap 'rmdir "$STATE/lock" 2>/dev/null || true' EXIT
 configure_paths
)
report_action() (
 local action=$1 selection=$2 start_epoch stamp result_root report_root rc
 shift 2
 start_epoch=$(date +%s)
 stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
 result_root="$REPO/artifacts/results/mt-prepare-$stamp"
 report_root="$REPO/artifacts/reports/mt-prepare-$stamp"
 mkdir -p "$result_root"
 : > "$result_root/stages.tsv"
 export MT_PREPARE_EVENTS="$result_root/stages.tsv"
 finish_report() {
  rc=$?
  trap - EXIT
  python3 "$REPORTER" \
   --repo "$REPO" --action "$action" --selection "$selection" \
   --started-epoch "$start_epoch" --ended-epoch "$(date +%s)" --exit-code "$rc" \
   --events "$MT_PREPARE_EVENTS" --result "$result_root/summary.json" \
   --output "$report_root/report.html" \
   || echo 'WARNING: mt-prepare finished, but its HTML report could not be generated.' >&2
  exit "$rc"
 }
 trap finish_report EXIT
 "$@"
)
list() {
 local i
 for i in "${!IMAGES[@]}"; do printf '%s  %-30s %s\n' "$((i+1))" "${IMAGES[i]}" "${FILES[i]}"; done
 echo 'ALL also prepares/validates X.509 D=2..5 chains and N=16 fixtures, and prepares mutual clients. Numbered stages prepare images only.'
}
python_ready() {
 bash "$REPO/bin/base/mt-doctor" --offline --quiet
}

prepare() (
 local selection=$1 rebuild=$2 last=6 start=0 i log rc parent
 [[ "$selection" == ALL || "$selection" =~ ^[1-7]$ ]] || fail 'Select stage 1..7 or ALL.'
 # run N prepares missing ancestors too; rebuild N rebuilds N after preparing ancestors.
 if [[ "$selection" != ALL ]]; then last=$((selection-1)); fi
 mt_compose_ready || exit 1
 python_ready
 mkdir -p "$STATE"
 mkdir "$STATE/lock" 2>/dev/null || fail 'Setup is active or its lock needs inspection.'
 trap 'rmdir "$STATE/lock" 2>/dev/null || true' EXIT
 for ((i=start;i<=last;i++)); do
  if [[ "$rebuild" == no || ( "$selection" != ALL && "$i" != "$last" ) ]]; then
   if docker image inspect "${IMAGES[i]}" >/dev/null 2>&1 && { (( PARENTS[i] < 0 )) || mt_image_matches_parent "${IMAGES[i]}" "${IMAGES[${PARENTS[i]}]}"; }; then
    printf 'REUSE %s\n' "${IMAGES[i]}"
    printf '%s\t%s\t%s\t%s\n' "$((i+1))" "${IMAGES[i]}" reused "${FILES[i]}" >> "${MT_PREPARE_EVENTS:-/dev/null}"
    continue
   fi
  fi
  if (( PARENTS[i] >= 0 )); then parent=${IMAGES[${PARENTS[i]}]}; mt_image_required "$parent" || exit 1; fi
  log="$STATE/stage-$((i+1))-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
  printf 'BUILD %s\nLog: %s\n' "${IMAGES[i]}" "$log"
  set +e
  docker build -f "${FILES[i]}" -t "${IMAGES[i]}" . 2>&1 | tee "$log"
  local codes=("${PIPESTATUS[@]}")
  set -e
  rc=${codes[0]}; [[ "$rc" != 0 ]] || rc=${codes[1]}
  if [[ "$rc" == 0 ]]; then
   printf '%s\t%s\t%s\t%s\n' "$((i+1))" "${IMAGES[i]}" built "${FILES[i]}" >> "${MT_PREPARE_EVENTS:-/dev/null}"
  else
   printf '%s\t%s\t%s\t%s\n' "$((i+1))" "${IMAGES[i]}" failed "${FILES[i]}" >> "${MT_PREPARE_EVENTS:-/dev/null}"
   exit "$rc"
  fi
 done
 configure_paths || exit "$?"
 if [[ "$selection" == ALL ]]; then
  prepare_fixtures || exit "$?"
  echo 'Prerequisites ready: images, configuration, X.509 D=2..5 chains, N=16 validation and mutual clients. Continue with mt-protocol-validation.'
 else
  echo 'Selected images and configuration prepared. Use run ALL to prepare X.509 D=2..5 chains, N=16 fixtures and mutual clients.'
 fi
)
menu() {
 local choice value
 while true; do
  printf '\nCryptographic scaling prerequisites\n1 List  2 Status  3 Prepare ALL missing  4 Prepare through stage\n5 Rebuild through ALL  6 Initialize missing launcher paths\n7 RESET ALL local laboratory data  0 Exit\n'
  read -r -p '> ' choice || return 0
  case "$choice" in
   1) list;; 2) "$SELF" status || true;; 3) "$SELF" run ALL || true;;
   4) list; read -r -p 'Stage number: ' value; "$SELF" run "$value" || true;;
   5) "$SELF" rebuild ALL || true;; 6) "$SELF" init || true;;
   7) "$SELF" reset-all || true;; 0) return 0;;
  esac
 done
}
case "${1:-menu}" in
 menu) menu;; list) list;; init) report_action init none configure;;
 run|rebuild) [[ "$#" == 2 ]] || fail 'Usage: run N|ALL or rebuild N|ALL'; action=$1; flag=no; [[ "$1" != rebuild ]] || flag=yes; report_action "$action" "$2" prepare "$2" "$flag";;
 show) [[ "${2:-}" =~ ^[1-7]$ ]] || fail 'Stage required: 1..7'; i=$(($2-1)); printf 'docker build -f %q -t %q .\n' "${FILES[i]}" "${IMAGES[i]}";;
 status) mt_compose_ready || exit 1; python_ready; for image in "${IMAGES[@]}"; do if docker image inspect "$image" >/dev/null 2>&1; then echo "AVAILABLE $image"; else echo "MISSING $image"; fi; done;;
 reset-all) [[ "$#" == 1 ]] || fail 'reset-all requires interactive confirmation; no options accepted.'; mt_docker_ready || exit 1; python3 "$REPO/scripts/maintenance/reset_lab.py";;
 help|--help|-h) echo 'Usage: mt-prepare [menu|init|list|status|show N|run N|run ALL|rebuild N|rebuild ALL|reset-all]'; echo 'Prepares base, MTC, capture, endpoint-profiling, mutual-profiling and network images. Existing images are reused; rebuild is explicit. run/rebuild initialize missing launcher paths after successful preparation; ALL also generates and validates X.509 D=2..5 chains and N=16 fixtures, and prepares mutual clients; init configures paths without Docker. init/run/rebuild write a specific JSON summary and an explained HTML report below artifacts/results and artifacts/reports. reset-all requires the literal confirmation RESET ALL and deletes artifacts, launcher state and laboratory Docker resources without creating a backup.';;
 *) fail 'Unknown command; use help.';;
esac
