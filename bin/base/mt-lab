#!/usr/bin/env bash
# Minimal lifecycle entry point for the functional MTC laboratory.
set -euo pipefail

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
STATE="$REPO/.mt-state/mt-lab"
CONFIG="$STATE/paths.env"
SERVICES="$STATE/services.env"
COMPOSE_PROJECT_NAME=mtc-lab
COMPOSE_FILE="$REPO/docker/compose.yaml"
COMPOSE_PREFLIGHT="$REPO/docker/compose.monitor-preflight.yaml"

fail() { echo "ERROR: $*" >&2; exit 1; }

usage() {
 echo 'Usage: mt-lab [init|prepare|up|status|down|gossip|cosigner-test|rp-test|split-view-test|--help]'
}

compose_base() {
 COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME \
  docker compose -f "$COMPOSE_FILE" "$@"
}

compose_lab() {
 MTC_MONITOR_PREFLIGHT_LOG=$MT_LAB_FIXTURE/transparency/ecdsa-p256/persistent-log \
 MTC_MONITOR_PREFLIGHT_SNAPSHOT=$MT_LAB_FIXTURE/transparency/ecdsa-p256/snapshot-n16.mcp2 \
 MTC_MONITOR_PREFLIGHT_AUTHORITY=$MT_LAB_FIXTURE/transparency/ecdsa-p256/trusted-authority.bin \
 MTC_MONITOR_PORT=8081 \
 COSIGNER_SECRETS_VOLUME=mtc-lab-cosigner-secrets \
 COSIGNER_STATE_VOLUME=mtc-lab-cosigner-state \
 COSIGNER_CLIENT_DIRECTORY=$STATE/cosigner-client \
 MTC_MONITOR_LOG_URL=$MTC_LOG_URL \
 MTC_GOSSIP_FIRST_URL=$GOSSIP_FIRST_URL \
 MTC_GOSSIP_SECOND_URL=$GOSSIP_SECOND_URL \
 MTC_GOSSIP_LOG_URL=$GOSSIP_LOG_URL \
 COSIGNER_SERVER_NAME=$COSIGNER_TLS_NAME COSIGNER_SERVER_SAN=$COSIGNER_TLS_SAN \
 COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME \
  docker compose -f "$COMPOSE_FILE" -f "$COMPOSE_PREFLIGHT" "$@"
}

load_services() {
 [[ -f "$SERVICES" ]] || fail 'Run mt-lab init first; services.env is missing.'
 local key value required
 while IFS='=' read -r key value || [[ -n "$key$value" ]]; do
  case "$key" in
   ''|'#'*) continue;;
   MTC_LOG_BIND_ADDRESS|MTC_LOG_PORT|MTC_LOG_URL|\
   COSIGNER_BIND_ADDRESS|COSIGNER_PORT|COSIGNER_TLS_NAME|\
   MONITOR_A_BIND_ADDRESS|MONITOR_A_PORT|MONITOR_A_URL|\
   MONITOR_B_BIND_ADDRESS|MONITOR_B_PORT|MONITOR_B_URL|\
   GOSSIP_FIRST_URL|GOSSIP_SECOND_URL|GOSSIP_LOG_URL)
    [[ -n "$value" ]] || fail "Empty service setting: $key"
    printf -v "$key" '%s' "$value"
    export "$key"
    ;;
   *) fail "Unknown service setting: $key";;
  esac
 done < "$SERVICES"
 for required in MTC_LOG_BIND_ADDRESS MTC_LOG_PORT MTC_LOG_URL \
  COSIGNER_BIND_ADDRESS COSIGNER_PORT COSIGNER_TLS_NAME \
  MONITOR_A_BIND_ADDRESS MONITOR_A_PORT MONITOR_A_URL \
  MONITOR_B_BIND_ADDRESS MONITOR_B_PORT MONITOR_B_URL \
  GOSSIP_FIRST_URL GOSSIP_SECOND_URL GOSSIP_LOG_URL
 do
  [[ -n "${!required:-}" ]] || fail "Missing service setting: $required"
 done
 if [[ "$COSIGNER_TLS_NAME" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  COSIGNER_TLS_SAN="IP:$COSIGNER_TLS_NAME"
 else
  COSIGNER_TLS_SAN="DNS:$COSIGNER_TLS_NAME"
 fi
}

docker_required() {
 command -v docker >/dev/null 2>&1 || fail 'Docker is not installed or not in PATH.'
 docker info >/dev/null 2>&1 || fail 'Docker daemon is not available.'
}

fixture_valid() {
 local root=$1 path
 for path in \
  manifest.json \
  transparency/ecdsa-p256/persistent-log \
  transparency/ecdsa-p256/snapshot-n8.mcp2 \
  transparency/ecdsa-p256/snapshot-n16.mcp2 \
  transparency/ecdsa-p256/trusted-authority.bin \
  batch16/mtc/ecdsa-p256/manifest.json \
  batch16/mtc/ecdsa-p256/landmarks.txt \
  batch16/mtc/ecdsa-p256/authority.bin \
  batch16/mtc/ecdsa-p256/trust.bin \
  population/ecdsa-p256/0.key
 do
  [[ -e "$root/$path" ]] || return 1
 done
}

init() {
 mkdir -p "$STATE"
 if [[ -f "$CONFIG" ]]; then
  echo "KEEP existing configuration: $CONFIG"
 else
  {
   printf 'MT_LAB_REPOSITORY=%q\n' "$REPO"
   printf 'MT_LAB_STATE=%q\n' "$STATE"
   printf 'MT_LAB_FIXTURE=%q\n' ''
  } > "$CONFIG"
  echo "MTC laboratory initialized: $CONFIG"
 fi
 if [[ -f "$SERVICES" ]]; then
  echo "KEEP existing service configuration: $SERVICES"
 else
  cat > "$SERVICES" <<'EOF'
# MTC laboratory service endpoints

# MTC Log
MTC_LOG_BIND_ADDRESS=127.0.0.1
MTC_LOG_PORT=18080
MTC_LOG_URL=http://mtc-log:8080

# External Cosigner
COSIGNER_BIND_ADDRESS=127.0.0.1
COSIGNER_PORT=8443
COSIGNER_TLS_NAME=localhost

# Monitor A
MONITOR_A_BIND_ADDRESS=127.0.0.1
MONITOR_A_PORT=18081
MONITOR_A_URL=http://monitor-a:8081

# Monitor B
MONITOR_B_BIND_ADDRESS=127.0.0.1
MONITOR_B_PORT=18082
MONITOR_B_URL=http://monitor-b:8081

# Gossip
GOSSIP_FIRST_URL=http://monitor-a:8081/checkpoint
GOSSIP_SECOND_URL=http://monitor-b:8081/checkpoint
GOSSIP_LOG_URL=http://mtc-log:8080
EOF
  echo "MTC laboratory service configuration initialized: $SERVICES"
 fi
}

prepare() (
 [[ -f "$CONFIG" ]] || fail 'Run mt-lab init first.'
 source "$CONFIG"
 [[ "${MT_LAB_REPOSITORY:-}" == "$REPO" && "${MT_LAB_STATE:-}" == "$STATE" ]] ||
  fail 'Laboratory configuration does not match this checkout.'
 if [[ -n "${MT_LAB_FIXTURE:-}" ]]; then
  fixture_valid "$MT_LAB_FIXTURE" ||
   fail "Selected fixture is incomplete; preserved at $MT_LAB_FIXTURE"
  echo "MTC laboratory already prepared: $MT_LAB_FIXTURE"
  return
 fi
 mkdir "$STATE/prepare.lock" 2>/dev/null || fail 'Laboratory preparation is already active.'
 trap 'rmdir "$STATE/prepare.lock" 2>/dev/null || true' EXIT
 local fixture temporary
 fixture="$REPO/artifacts/mt-lab/fixture-$(date -u +%Y%m%dT%H%M%SZ)-$$"
 [[ ! -e "$fixture" ]] || fail "Fixture path already exists: $fixture"
 "$REPO/bin/base/mt-prepare" run 2
 python3 "$REPO/campaigns/scaling/mtc_profile_scaling/workflow.py" generate \
  --output "$fixture" --profile ecdsa-p256 --sizes 16 --execute
 fixture_valid "$fixture" || fail "Generated fixture is incomplete; preserved at $fixture"
 temporary="$STATE/paths.env.tmp.$$"
 {
  printf 'MT_LAB_REPOSITORY=%q\n' "$REPO"
  printf 'MT_LAB_STATE=%q\n' "$STATE"
  printf 'MT_LAB_FIXTURE=%q\n' "$fixture"
 } > "$temporary"
 mv "$temporary" "$CONFIG"
 echo "MTC laboratory prepared: $fixture"
)

up() (
 [[ -f "$CONFIG" ]] || fail 'Run mt-lab init and mt-lab prepare first.'
 source "$CONFIG"
 [[ "${MT_LAB_REPOSITORY:-}" == "$REPO" && "${MT_LAB_STATE:-}" == "$STATE" ]] ||
  fail 'Laboratory configuration does not match this checkout.'
 [[ -n "${MT_LAB_FIXTURE:-}" ]] && fixture_valid "$MT_LAB_FIXTURE" ||
  fail 'Run mt-lab prepare before mt-lab up.'
 load_services
 docker_required
 local volume
 mkdir -p "$STATE/cosigner-client"
 for volume in mtc-log-data mtc-lab-cosigner-secrets mtc-lab-cosigner-state; do
  docker volume inspect "$volume" >/dev/null 2>&1 || docker volume create "$volume" >/dev/null
 done
 compose_lab --profile provision build \
  mtc-log monitor-a monitor-b external-cosigner provision
 if compose_lab --profile provision run --rm --no-deps --entrypoint /bin/sh provision -c '
  for path in /run/cosigner/external.key /run/cosigner/server.key \
   /run/cosigner/server.pem /run/cosigner/client-ca.pem /client/client.key \
   /client/client.pem /client/server-ca.pem /client/external.pub; do
   [ -s "$path" ] || exit 1
  done
 '; then
  echo 'REUSE existing External Cosigner credentials.'
 else
  compose_lab --profile provision run --rm --no-deps provision
 fi
 compose_lab up -d mtc-log external-cosigner monitor-a monitor-b
)

status() {
 local fixture='' preparation docker configuration='not initialized'
 if [[ -f "$CONFIG" ]]; then
  # This ignored local file is created and owned by the launcher user.
  source "$CONFIG"
  fixture=${MT_LAB_FIXTURE:-}
  state="initialized ($STATE)"
 else
  state="not initialized ($STATE)"
 fi
 if [[ -n "$fixture" ]] && fixture_valid "$fixture"; then
  preparation='prepared'
 elif [[ -n "$fixture" ]]; then
  preparation='selected fixture is incomplete'
 elif [[ -d "$REPO/.mt-state/cryptographic-setup" ]]; then
  preparation='mt-prepare state present; laboratory preparation not inferred'
 else
  preparation='not run'
 fi
 if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  docker='available'
  services=yes
 elif command -v docker >/dev/null 2>&1; then
  docker='command available; daemon unavailable'
  services=no
 else
  docker='command unavailable'
  services=no
 fi
 [[ -n "$fixture" ]] || fixture='not selected'
 if [[ -f "$SERVICES" ]]; then
  load_services
  configuration=$SERVICES
 fi
 printf 'MTC laboratory\n'
 printf 'repository: %s\n' "$REPO"
 printf 'state: %s\n' "$state"
 printf 'preparation: %s\n' "$preparation"
 printf 'fixture: %s\n' "$fixture"
 printf 'configuration: %s\n' "$configuration"
 if [[ -f "$SERVICES" ]]; then
  printf 'mtc-log host: %s:%s\n' "$MTC_LOG_BIND_ADDRESS" "$MTC_LOG_PORT"
  printf 'external-cosigner host: %s:%s\n' "$COSIGNER_BIND_ADDRESS" "$COSIGNER_PORT"
  printf 'external-cosigner TLS identity: %s\n' "$COSIGNER_TLS_NAME"
  printf 'monitor-a host: %s:%s\n' "$MONITOR_A_BIND_ADDRESS" "$MONITOR_A_PORT"
  printf 'monitor-b host: %s:%s\n' "$MONITOR_B_BIND_ADDRESS" "$MONITOR_B_PORT"
 fi
 printf 'docker: %s\n' "$docker"
 if [[ "$services" == yes ]]; then
  echo 'services:'
  compose_base ps --all mtc-log external-cosigner monitor-a monitor-b ||
   echo '  unable to inspect laboratory Compose project'
 fi
}

down() {
 docker_required
 compose_base down --remove-orphans
}

gossip() (
 [[ -f "$CONFIG" ]] || fail 'Run mt-lab init and mt-lab prepare first.'
 source "$CONFIG"
 [[ "${MT_LAB_REPOSITORY:-}" == "$REPO" && "${MT_LAB_STATE:-}" == "$STATE" ]] ||
  fail 'Laboratory configuration does not match this checkout.'
 [[ -n "${MT_LAB_FIXTURE:-}" ]] && fixture_valid "$MT_LAB_FIXTURE" ||
  fail 'Run mt-lab prepare before mt-lab gossip.'
 load_services
 docker_required
 local service
 for service in mtc-log external-cosigner monitor-a monitor-b; do
  [[ -n "$(compose_lab ps --status running --quiet "$service")" ]] ||
   fail "Laboratory service is not running: $service"
 done
 compose_lab --profile gossip build checkpoint-gossip
 compose_lab --profile gossip run --rm --no-deps checkpoint-gossip
)

cosigner_test() (
 [[ -f "$CONFIG" ]] || fail 'Run mt-lab init and mt-lab prepare first.'
 source "$CONFIG"
 [[ "${MT_LAB_REPOSITORY:-}" == "$REPO" && "${MT_LAB_STATE:-}" == "$STATE" ]] ||
  fail 'Laboratory configuration does not match this checkout.'
 [[ -n "${MT_LAB_FIXTURE:-}" ]] && fixture_valid "$MT_LAB_FIXTURE" ||
  fail 'Run mt-lab prepare before mt-lab cosigner-test.'
 load_services
 docker_required
 local service credential url
 for service in mtc-log external-cosigner monitor-a monitor-b; do
  [[ -n "$(compose_lab ps --status running --quiet "$service")" ]] ||
   fail "Laboratory service is not running: $service"
 done
 for credential in client.key client.pem server-ca.pem external.pub; do
  [[ -s "$STATE/cosigner-client/$credential" ]] ||
   fail "External Cosigner credential is missing: $credential"
 done
 url="https://$COSIGNER_TLS_NAME:$COSIGNER_PORT"
 cd "$REPO/docker/external_cosigner"
 PYTHONPATH="$REPO/src/mtc" python3 smoke.py accept --url "$url" \
  --ca "$STATE/cosigner-client/server-ca.pem" \
  --client-cert "$STATE/cosigner-client/client.pem" \
  --client-key "$STATE/cosigner-client/client.key"
 PYTHONPATH="$REPO/src/mtc" python3 smoke.py sign --url "$url" \
  --ca "$STATE/cosigner-client/server-ca.pem" \
  --client-cert "$STATE/cosigner-client/client.pem" \
  --client-key "$STATE/cosigner-client/client.key"
 PYTHONPATH="$REPO/src/mtc" python3 smoke.py no-cert --url "$url" \
  --ca "$STATE/cosigner-client/server-ca.pem"
)

rp_test() (
 [[ -f "$CONFIG" ]] || fail 'Run mt-lab init and mt-lab prepare first.'
 source "$CONFIG"
 [[ "${MT_LAB_REPOSITORY:-}" == "$REPO" && "${MT_LAB_STATE:-}" == "$STATE" ]] ||
  fail 'Laboratory configuration does not match this checkout.'
 [[ -n "${MT_LAB_FIXTURE:-}" ]] && fixture_valid "$MT_LAB_FIXTURE" ||
  fail 'Run mt-lab prepare before mt-lab rp-test.'
 load_services
 docker_required

 [[ -n "$(compose_lab ps --status running --quiet mtc-log)" ]] ||
  fail 'Laboratory service is not running: mtc-log'

 docker run --rm \
  -v "$REPO:/repo:ro" \
  -v "$MT_LAB_FIXTURE:/fixture:ro" \
  -w /repo \
  mt-tls-mtc:local \
  sh -eu -c '
   checker=/tmp/mt-lab-check_snapshot
   python3 src/mtc/build_check_snapshot.py \
    --openssl-prefix /opt/openssl \
    --output "$checker" >/dev/null

   PYTHONPATH=/repo/src/mtc \
    python3 src/mtc/mt_lab_rp_test.py \
     --base-url "$1" \
     --fixture /fixture \
     --checker "$checker"
  ' sh "http://host.docker.internal:$MTC_LOG_PORT"
)


split_view_test() (
 [[ -f "$CONFIG" ]] || fail 'Run mt-lab init and mt-lab prepare first.'
 source "$CONFIG"
 [[ "${MT_LAB_REPOSITORY:-}" == "$REPO" && "${MT_LAB_STATE:-}" == "$STATE" ]] ||
  fail 'Laboratory configuration does not match this checkout.'
 [[ -n "${MT_LAB_FIXTURE:-}" ]] && fixture_valid "$MT_LAB_FIXTURE" ||
  fail 'Run mt-lab prepare before mt-lab split-view-test.'
 load_services
 docker_required

 local network image first second output rc
 network="${COMPOSE_PROJECT_NAME}_default"
 image="${COMPOSE_PROJECT_NAME}-checkpoint-gossip"
 first="${COMPOSE_PROJECT_NAME}-split-a"
 second="${COMPOSE_PROJECT_NAME}-split-b"

 cleanup_split_view() {
  docker rm -f "$first" "$second" >/dev/null 2>&1 || true
 }
 trap cleanup_split_view EXIT

 compose_lab --profile gossip build checkpoint-gossip
 cleanup_split_view

 docker run -d --rm \
  --name "$first" \
  --network "$network" \
  --entrypoint python3 \
  "$image" \
  -c 'import json
from http.server import BaseHTTPRequestHandler, HTTPServer
checkpoint={"log_number":1,"tree_size":16,"hash":"11"*32}
class Handler(BaseHTTPRequestHandler):
 def do_GET(self):
  if self.path != "/checkpoint":
   self.send_response(404); self.end_headers(); return
  body=json.dumps(checkpoint).encode()
  self.send_response(200)
  self.send_header("Content-Type","application/json")
  self.send_header("Content-Length",str(len(body)))
  self.end_headers()
  self.wfile.write(body)
 def log_message(self,*args): pass
HTTPServer(("0.0.0.0",8081),Handler).serve_forever()' >/dev/null

 docker run -d --rm \
  --name "$second" \
  --network "$network" \
  --entrypoint python3 \
  "$image" \
  -c 'import json
from http.server import BaseHTTPRequestHandler, HTTPServer
checkpoint={"log_number":1,"tree_size":16,"hash":"22"*32}
class Handler(BaseHTTPRequestHandler):
 def do_GET(self):
  if self.path != "/checkpoint":
   self.send_response(404); self.end_headers(); return
  body=json.dumps(checkpoint).encode()
  self.send_response(200)
  self.send_header("Content-Type","application/json")
  self.send_header("Content-Length",str(len(body)))
  self.end_headers()
  self.wfile.write(body)
 def log_message(self,*args): pass
HTTPServer(("0.0.0.0",8081),Handler).serve_forever()' >/dev/null

 set +e
 output="$(
  docker run --rm \
   --network "$network" \
   "$image" \
   --first-url "http://$first:8081/checkpoint" \
   --second-url "http://$second:8081/checkpoint" \
   --log-url "$GOSSIP_LOG_URL"
 )"
 rc=$?
 set -e

 printf '%s\n' "$output"

 [[ "$rc" == 1 ]] ||
  fail "Split-view Gossip returned unexpected exit code: $rc"

 python3 -c '
import json, sys
value=json.loads(sys.stdin.read())
if value.get("result") != "SPLIT_VIEW":
    raise SystemExit("expected SPLIT_VIEW")
if value.get("severity") != "ALERT":
    raise SystemExit("expected ALERT")
' <<<"$output"

 echo 'PASS: isolated checkpoint split view detected'
)

case "${1:---help}" in
 init) [[ "$#" == 1 ]] || fail 'Usage: mt-lab init'; init;;
 prepare) [[ "$#" == 1 ]] || fail 'Usage: mt-lab prepare'; prepare;;
 up) [[ "$#" == 1 ]] || fail 'Usage: mt-lab up'; up;;
 status) [[ "$#" == 1 ]] || fail 'Usage: mt-lab status'; status;;
 down) [[ "$#" == 1 ]] || fail 'Usage: mt-lab down'; down;;
 gossip) [[ "$#" == 1 ]] || fail 'Usage: mt-lab gossip'; gossip;;
 cosigner-test) [[ "$#" == 1 ]] || fail 'Usage: mt-lab cosigner-test'; cosigner_test;;
 rp-test) [[ "$#" == 1 ]] || fail 'Usage: mt-lab rp-test'; rp_test;;
 split-view-test) [[ "$#" == 1 ]] || fail 'Usage: mt-lab split-view-test'; split_view_test;;
 help|--help|-h) [[ "$#" == 1 ]] || fail 'Usage: mt-lab --help'; usage;;
 *) fail 'Unknown command; use --help.';;
esac
