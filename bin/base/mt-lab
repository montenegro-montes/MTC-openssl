#!/usr/bin/env bash
# Minimal lifecycle entry point for the functional MTC laboratory.
set -euo pipefail

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
STATE="$REPO/.mt-state/mt-lab"
CONFIG="$STATE/paths.env"
COMPOSE_PROJECT_NAME=mtc-lab
COMPOSE_FILE="$REPO/docker/compose.yaml"
COMPOSE_PREFLIGHT="$REPO/docker/compose.monitor-preflight.yaml"

fail() { echo "ERROR: $*" >&2; exit 1; }

usage() {
 echo 'Usage: mt-lab [init|prepare|up|status|down|gossip|--help]'
}

compose_base() {
 COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME \
  docker compose -f "$COMPOSE_FILE" "$@"
}

compose_lab() {
 MTC_MONITOR_PREFLIGHT_LOG=$MT_LAB_FIXTURE/transparency/ecdsa-p256/persistent-log \
 MTC_MONITOR_PREFLIGHT_SNAPSHOT=$MT_LAB_FIXTURE/transparency/ecdsa-p256/snapshot-n16.mcp2 \
 MTC_MONITOR_PREFLIGHT_AUTHORITY=$MT_LAB_FIXTURE/transparency/ecdsa-p256/trusted-authority.bin \
 COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME \
  docker compose -f "$COMPOSE_FILE" -f "$COMPOSE_PREFLIGHT" "$@"
}

docker_required() {
 command -v docker >/dev/null 2>&1 || fail 'Docker is not installed or not in PATH.'
 docker info >/dev/null 2>&1 || fail 'Docker daemon is not available.'
}

fixture_valid() {
 local root=$1 path
 for path in \
  manifest.json \
  transparency/ecdsa-p256/persistent-log \
  transparency/ecdsa-p256/snapshot-n8.mcp2 \
  transparency/ecdsa-p256/snapshot-n16.mcp2 \
  transparency/ecdsa-p256/trusted-authority.bin \
  batch16/mtc/ecdsa-p256/manifest.json \
  batch16/mtc/ecdsa-p256/landmarks.txt \
  batch16/mtc/ecdsa-p256/authority.bin \
  batch16/mtc/ecdsa-p256/trust.bin \
  population/ecdsa-p256/0.key
 do
  [[ -e "$root/$path" ]] || return 1
 done
}

init() {
 mkdir -p "$STATE"
 if [[ -f "$CONFIG" ]]; then
  echo "KEEP existing configuration: $CONFIG"
  return
 fi
 {
  printf 'MT_LAB_REPOSITORY=%q\n' "$REPO"
  printf 'MT_LAB_STATE=%q\n' "$STATE"
  printf 'MT_LAB_FIXTURE=%q\n' ''
 } > "$CONFIG"
 echo "MTC laboratory initialized: $CONFIG"
}

prepare() (
 [[ -f "$CONFIG" ]] || fail 'Run mt-lab init first.'
 source "$CONFIG"
 [[ "${MT_LAB_REPOSITORY:-}" == "$REPO" && "${MT_LAB_STATE:-}" == "$STATE" ]] ||
  fail 'Laboratory configuration does not match this checkout.'
 if [[ -n "${MT_LAB_FIXTURE:-}" ]]; then
  fixture_valid "$MT_LAB_FIXTURE" ||
   fail "Selected fixture is incomplete; preserved at $MT_LAB_FIXTURE"
  echo "MTC laboratory already prepared: $MT_LAB_FIXTURE"
  return
 fi
 mkdir "$STATE/prepare.lock" 2>/dev/null || fail 'Laboratory preparation is already active.'
 trap 'rmdir "$STATE/prepare.lock" 2>/dev/null || true' EXIT
 local fixture temporary
 fixture="$REPO/artifacts/mt-lab/fixture-$(date -u +%Y%m%dT%H%M%SZ)-$$"
 [[ ! -e "$fixture" ]] || fail "Fixture path already exists: $fixture"
 "$REPO/bin/base/mt-prepare" run 2
 python3 "$REPO/campaigns/scaling/mtc_profile_scaling/workflow.py" generate \
  --output "$fixture" --profile ecdsa-p256 --sizes 16 --execute
 fixture_valid "$fixture" || fail "Generated fixture is incomplete; preserved at $fixture"
 temporary="$STATE/paths.env.tmp.$$"
 {
  printf 'MT_LAB_REPOSITORY=%q\n' "$REPO"
  printf 'MT_LAB_STATE=%q\n' "$STATE"
  printf 'MT_LAB_FIXTURE=%q\n' "$fixture"
 } > "$temporary"
 mv "$temporary" "$CONFIG"
 echo "MTC laboratory prepared: $fixture"
)

up() (
 [[ -f "$CONFIG" ]] || fail 'Run mt-lab init and mt-lab prepare first.'
 source "$CONFIG"
 [[ "${MT_LAB_REPOSITORY:-}" == "$REPO" && "${MT_LAB_STATE:-}" == "$STATE" ]] ||
  fail 'Laboratory configuration does not match this checkout.'
 [[ -n "${MT_LAB_FIXTURE:-}" ]] && fixture_valid "$MT_LAB_FIXTURE" ||
  fail 'Run mt-lab prepare before mt-lab up.'
 docker_required
 local volume
 for volume in mtc-log-data mtc-external-cosigner_cosigner-secrets mtc-external-cosigner_cosigner-state; do
  docker volume inspect "$volume" >/dev/null 2>&1 || docker volume create "$volume" >/dev/null
 done
 compose_lab --profile provision build \
  mtc-log monitor-a monitor-b external-cosigner provision
 if compose_lab --profile provision run --rm --no-deps --entrypoint /bin/sh provision -c '
  for path in /run/cosigner/external.key /run/cosigner/server.key \
   /run/cosigner/server.pem /run/cosigner/client-ca.pem /client/client.key \
   /client/client.pem /client/server-ca.pem /client/external.pub; do
   [ -s "$path" ] || exit 1
  done
 '; then
  echo 'REUSE existing External Cosigner credentials.'
 else
  compose_lab --profile provision run --rm --no-deps provision
 fi
 compose_lab up -d mtc-log external-cosigner monitor-a monitor-b
)

status() {
 local fixture='' preparation docker
 if [[ -f "$CONFIG" ]]; then
  # This ignored local file is created and owned by the launcher user.
  source "$CONFIG"
  fixture=${MT_LAB_FIXTURE:-}
  state="initialized ($STATE)"
 else
  state="not initialized ($STATE)"
 fi
 if [[ -n "$fixture" ]] && fixture_valid "$fixture"; then
  preparation='prepared'
 elif [[ -n "$fixture" ]]; then
  preparation='selected fixture is incomplete'
 elif [[ -d "$REPO/.mt-state/cryptographic-setup" ]]; then
  preparation='mt-prepare state present; laboratory preparation not inferred'
 else
  preparation='not run'
 fi
 if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  docker='available'
  services=yes
 elif command -v docker >/dev/null 2>&1; then
  docker='command available; daemon unavailable'
  services=no
 else
  docker='command unavailable'
  services=no
 fi
 [[ -n "$fixture" ]] || fixture='not selected'
 printf 'MTC laboratory\n'
 printf 'repository: %s\n' "$REPO"
 printf 'state: %s\n' "$state"
 printf 'preparation: %s\n' "$preparation"
 printf 'fixture: %s\n' "$fixture"
 printf 'docker: %s\n' "$docker"
 if [[ "$services" == yes ]]; then
  echo 'services:'
  compose_base ps --all mtc-log external-cosigner monitor-a monitor-b ||
   echo '  unable to inspect laboratory Compose project'
 fi
}

down() {
 docker_required
 compose_base down --remove-orphans
}

gossip() (
 [[ -f "$CONFIG" ]] || fail 'Run mt-lab init and mt-lab prepare first.'
 source "$CONFIG"
 [[ "${MT_LAB_REPOSITORY:-}" == "$REPO" && "${MT_LAB_STATE:-}" == "$STATE" ]] ||
  fail 'Laboratory configuration does not match this checkout.'
 [[ -n "${MT_LAB_FIXTURE:-}" ]] && fixture_valid "$MT_LAB_FIXTURE" ||
  fail 'Run mt-lab prepare before mt-lab gossip.'
 docker_required
 local service monitor
 for service in mtc-log external-cosigner monitor-a monitor-b; do
  [[ -n "$(compose_lab ps --status running --quiet "$service")" ]] ||
   fail "Laboratory service is not running: $service"
 done
 for monitor in monitor-a monitor-b; do
  compose_lab exec -T "$monitor" test -s /var/lib/mtc-monitor/checkpoint.json >/dev/null 2>&1 ||
   fail "Checkpoint is not available yet: $monitor"
 done
 compose_lab --profile gossip run --rm --no-deps checkpoint-gossip
)

case "${1:---help}" in
 init) [[ "$#" == 1 ]] || fail 'Usage: mt-lab init'; init;;
 prepare) [[ "$#" == 1 ]] || fail 'Usage: mt-lab prepare'; prepare;;
 up) [[ "$#" == 1 ]] || fail 'Usage: mt-lab up'; up;;
 status) [[ "$#" == 1 ]] || fail 'Usage: mt-lab status'; status;;
 down) [[ "$#" == 1 ]] || fail 'Usage: mt-lab down'; down;;
 gossip) [[ "$#" == 1 ]] || fail 'Usage: mt-lab gossip'; gossip;;
 help|--help|-h) [[ "$#" == 1 ]] || fail 'Usage: mt-lab --help'; usage;;
 *) fail 'Unknown command; use --help.';;
esac
