#!/usr/bin/env bash
set -euo pipefail
REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SELF="$REPO/bin/base/mt-protocol-validation"
cd "$REPO"
source "$REPO/bin/lib/docker-preflight.sh"
STATE_ROOT="$REPO/.mt-state/protocol-validation"
STATE="${MT_PROTOCOL_STATE:-$STATE_ROOT}"
CONFIG="$STATE/paths.env"
MATRIX_STATE_ROOT="$REPO/.mt-state/protocol-validation-matrix"
STEPS=(05.draft-core-vectors 10.offline-existing 20.offline-landmark 30.offline-standalone 40.capture-landmark 50.extract-landmark 55.verify-transcript-landmark 60.validate-wire-landmark 70.report-landmark 80.capture-standalone 90.extract-standalone 95.verify-transcript-standalone 100.validate-wire-standalone 110.report-standalone 120.invalid-input-stress)
PROFILE_MATRIX=(ecdsa-p256 ecdsa-p384 ecdsa-p521 mldsa44 mldsa65 mldsa87 slhdsa128s slhdsa192s slhdsa256s)
LEAF_COUNT=16
fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
validate_profile() {
 case "$1" in
  ecdsa-p256|ecdsa-p384|ecdsa-p521|mldsa44|mldsa65|mldsa87|slhdsa128s|slhdsa192s|slhdsa256s) return 0;;
  *) fail "Unsupported MTC profile: $1";;
 esac
}
mtc_root() {
 local cert_config="$REPO/.mt-state/cert-scaling/paths.env" root
 [[ -f "$cert_config" ]] || fail 'Run bin/base/mt-prepare init to initialize missing launcher paths, or mt-prepare run ALL to also prepare images.'
 root=$( (source "$cert_config"; printf '%s' "$MTC16") )
 case "$root" in artifacts/*) ;; *) fail 'MTC16 must be a relative path under artifacts/.';; esac
 printf '%s\n' "$root"
}
validate_leaf() {
 local leaf=$1
 [[ "$leaf" =~ ^[0-9]+$ ]] || fail "Leaf must be an integer in 0..$((LEAF_COUNT-1))."
 (( leaf >= 0 && leaf < LEAF_COUNT )) || fail "Leaf must be in 0..$((LEAF_COUNT-1))."
}
configure_mtc_profile() {
 local profile=$1 leaf=${2:-${LEAF:-0}} root
 validate_profile "$profile"
 validate_leaf "$leaf"
 root=$(mtc_root)
 PROFILE=$profile
 LEAF=$leaf
 FIX="$root/batch16/mtc/$PROFILE"
 KEY="$root/population/$PROFILE/$LEAF.key"
}
load() { [[ -f "$CONFIG" ]] || fail 'Run init first.'; unset PROFILE REVIEW LEAF; source "$CONFIG"; PROFILE=${PROFILE:-mldsa65}; LEAF=${LEAF:-0}; REVIEW=${REVIEW:-artifacts/protocol-review/$STAMP}; }
save() {
 local key
 (umask 077
 for key in STAMP FIX KEY CAP PROFILE REVIEW LEAF; do printf '%s=%q\n' "$key" "${!key}"; done > "$CONFIG.tmp"
 mv "$CONFIG.tmp" "$CONFIG")
}
init() {
 [[ ! -e "$CONFIG" ]] || fail 'State already exists; use status and set.'
 STAMP=${1:-$(date -u +%Y%m%dT%H%M%SZ)}
 [[ "$STAMP" =~ ^[a-zA-Z0-9_-]+$ ]] || fail 'Invalid name.'
 configure_mtc_profile mldsa65 0
 CAP="artifacts/protocol-validation/$STAMP"
 REVIEW="artifacts/protocol-review/$STAMP"
 mkdir -p "$STATE"; save
 printf 'Configuration saved. Profile: %s, leaf: %s, N=16. Check FIX and KEY with status.\n' "$PROFILE" "$LEAF"
}
init_profile() {
 [[ "$#" -ge 2 && "$#" -le 3 ]] || fail 'Usage: init-profile NAME PROFILE [LEAF]'
 [[ ! -e "$CONFIG" ]] || fail 'State already exists for this profile/leaf.'
 STAMP=$1
 [[ "$STAMP" =~ ^[a-zA-Z0-9_-]+$ ]] || fail 'Invalid name.'
 configure_mtc_profile "$2" "${3:-0}"
 local leaf4
 printf -v leaf4 '%04d' "$LEAF"
 CAP="artifacts/protocol-validation/$STAMP/$PROFILE/leaf-$leaf4"
 REVIEW="artifacts/protocol-review/$STAMP/$PROFILE/leaf-$leaf4"
 [[ ! -e "$CAP" ]] || fail "Profile/leaf campaign output already exists: $CAP"
 [[ ! -e "$REVIEW" ]] || fail "Profile/leaf review output already exists: $REVIEW"
 mkdir -p "$STATE"; save
 printf 'Profile configuration saved. Campaign: %s, profile: %s, leaf/key: %s, N=16.\n' "$STAMP" "$PROFILE" "$LEAF"
}

plan() {
 [[ "$1" != 120.negative ]] || set -- 120.invalid-input-stress
 local item found=0 mode script
 for item in "${STEPS[@]}"; do
  if [[ "$1" == "$item" || "$1" == "${item%%.*}" ]]; then STEP=$item; found=1; break; fi
 done
 [[ "$found" == 1 ]] || fail 'Unknown stage.'
 local args=() image=mt-tls-mtc:local leaf4 leaf6
 printf -v leaf4 '%04d' "$LEAF"
 printf -v leaf6 '%06d' "$LEAF"
 case "$STEP" in
  05.*) OUT="$CAP/05.draft-core-vectors.json"; CMD=(python3 campaigns/validation/protocol_validation/draft_core_audit.py --output "$OUT"); return;;
  10.*|20.*|30.*)
   mode=standalone; [[ "$STEP" != 20.* ]] || mode=landmark
   OUT="$CAP/$STEP.json"; script=validate_mtc.py
   args=("$FIX/$mode-$leaf4.der" --trust "$FIX/trust.bin" --profile "$PROFILE" --mode "$mode" --output "$OUT")
   if [[ "$STEP" == 10.* ]]; then args=("$FIX/standalone-$leaf4.der" --trust "$FIX/authority.bin" --profile "$PROFILE" --mode standalone --output "$OUT");
   else args+=(--entry "$FIX/log/$leaf6.entry"); fi;;
  40.*|80.*)
   mode=landmark; [[ "$STEP" != 80.* ]] || mode=standalone
   OUT="$CAP/$mode"
   CMD=(bash campaigns/validation/protocol_validation/capture_handshake.sh --mode "$mode" --profile "$PROFILE" --leaf "$LEAF" --fixture-dir "$FIX" --server-key "$KEY" --output "$OUT" --execute)
   return;;
  50.*|90.*)
   mode=landmark; [[ "$STEP" != 90.* ]] || mode=standalone
   OUT="$CAP/$mode/extracted"; script=extract_pcap.py; image=mt-tls-capture:local
   args=("$CAP/$mode" --sender "$FIX/$mode-$leaf4.der" --output "$OUT");;
  55.*|95.*)
   mode=landmark; [[ "$STEP" != 95.* ]] || mode=standalone
   OUT="$REVIEW/$mode/independent.json"; image=mt-tls-capture:local
   if [[ -f "$CAP/$mode/metadata.json" ]]; then
    image=$(python3 - "$CAP/$mode/metadata.json" <<'PY'
import json,sys
print(json.load(open(sys.argv[1]))['capture_image_id'])
PY
)
   fi
   CMD=(docker run --rm --network none -e PYTHONDONTWRITEBYTECODE=1 -e PYTHONPATH=/repo/src/mtc -v "$REPO:/repo:ro" -v "$REPO/$REVIEW:/repo/$REVIEW" -w /repo --entrypoint python3 "$image" campaigns/validation/protocol_validation/verify_tls_transcript.py "$CAP/$mode" --output "$OUT" --openssl /opt/mtc/openssl.sh)
   return;;
  60.*|100.*)
   mode=landmark; [[ "$STEP" != 100.* ]] || mode=standalone
   OUT="$CAP/$mode/object-validation.json"; script=validate_mtc.py
   args=("$CAP/$mode/extracted/mtc-wire.bin" --trust "$FIX/trust.bin" --entry "$FIX/log/$leaf6.entry" --sender "$FIX/$mode-$leaf4.der" --profile "$PROFILE" --mode "$mode" --output "$OUT");;
  70.*|110.*)
   mode=landmark; [[ "$STEP" != 110.* ]] || mode=standalone
   OUT="$CAP/$mode/protocol-report.json"; script=report.py
   args=(--capture "$CAP/$mode" --extraction "$CAP/$mode/extracted" --object-report "$CAP/$mode/object-validation.json" --independent-report "$REVIEW/$mode/independent.json" --output "$OUT");;
  120.*) OUT="$CAP/invalid-input-stress"; script=negative_cases.py; args=(--fixtures "$FIX" --profile "$PROFILE" --output "$OUT");;
 esac
 CMD=(docker run --rm --network none -e PYTHONPATH=/repo/src/mtc -v "$REPO:/repo:ro" -v "$REPO/$CAP:/repo/$CAP" -w /repo --entrypoint python3 "$image" "campaigns/validation/protocol_validation/$script" "${args[@]}")
}
show() { printf '%q ' "${CMD[@]}"; printf '\n'; }
status() {
 load
 printf 'FIX=%s\nKEY=%s\nCAP=%s\nREVIEW=%s\nProfile: %s, leaf: %s, N=16. Images: mt-tls-mtc:local and mt-tls-capture:local.\n' "$FIX" "$KEY" "$CAP" "$REVIEW" "$PROFILE" "$LEAF"
 local step state
 for step in "${STEPS[@]}"; do
  plan "$step"; printf '%-36s ' "$STEP"
  if [[ -f "$STATE/$STEP.status" ]]; then
   state=$(<"$STATE/$STEP.status"); printf '%s\n' "${state%%; log=*}"
  else printf 'pending/not executed by this launcher\n'; fi
 done
 [[ ! -d "$STATE/lock" ]] || printf 'An execution lock exists; another stage may still be active.\n'
}
passed() {
 python3 - "$1" <<'PY'
import json,sys
from pathlib import Path
p=Path(sys.argv[1])
if not p.is_file():raise SystemExit('Missing prerequisite validation: '+str(p))
d=json.loads(p.read_text())
if d.get('overall')!='PASS':raise SystemExit('Prerequisite validation did not pass: '+str(p))
PY
}
not_failed() {
 python3 - "$1" <<'PY'
import json,sys
from pathlib import Path
p=Path(sys.argv[1])
if not p.is_file():raise SystemExit('Missing prerequisite evidence: '+str(p))
d=json.loads(p.read_text())
if d.get('overall')=='FAIL':raise SystemExit('Prerequisite evidence failed: '+str(p))
PY
}
preflight() {
 local captured_image
 case "$STEP" in
  40.*|80.*) mt_compose_ready && mt_image_required mt-tls-mtc:local && mt_image_required mt-tls-capture:local || return 1;;
  50.*|90.*) mt_images_required mt-tls-capture:local || return 1;;
  55.*)
   [[ -f "$CAP/landmark/metadata.json" ]] || fail 'Landmark capture metadata is missing.'
   captured_image=$(python3 - "$CAP/landmark/metadata.json" <<'PY'
import json,sys
print(json.load(open(sys.argv[1]))['capture_image_id'])
PY
)
   mt_images_required "$captured_image" || return 1;;
  95.*)
   [[ -f "$CAP/standalone/metadata.json" ]] || fail 'Standalone capture metadata is missing.'
   captured_image=$(python3 - "$CAP/standalone/metadata.json" <<'PY'
import json,sys
print(json.load(open(sys.argv[1]))['capture_image_id'])
PY
)
   mt_images_required "$captured_image" || return 1;;
  *) mt_images_required mt-tls-mtc:local || return 1;;
 esac
 [[ ! -e "$OUT" ]] || fail "Output exists: $OUT. It is preserved; use a new CAP for another attempt."
 [[ -f "$FIX/manifest.json" && -f "$KEY" ]] || fail 'Fixtures or server key are missing. Run bin/base/mt-protocol-validation status and configure FIX and KEY using set or the menu. Initialization does not generate fixtures. See campaigns/validation/protocol_validation/README.md (Before the first run).'
 local leaf4 leaf6
 printf -v leaf4 '%04d' "$LEAF"
 printf -v leaf6 '%06d' "$LEAF"
 [[ -f "$FIX/landmark-$leaf4.der" && -f "$FIX/landmark-$leaf4.pem" && -f "$FIX/standalone-$leaf4.der" && -f "$FIX/standalone-$leaf4.pem" && -f "$FIX/log/$leaf6.entry" ]] || fail "Missing selected leaf fixtures for profile=$PROFILE leaf=$LEAF."
 python3 - "$FIX/manifest.json" "$PROFILE" <<'PY'
import json,sys
sys.path.insert(0,'src/mtc')
from crypto_profiles import crypto_profile
m=json.load(open(sys.argv[1]));p=crypto_profile(sys.argv[2])
if m.get('tree_size')!=16 or m.get('profile',m.get('crypto_family'))!=sys.argv[2] or m.get('ca_id')!=p['ca_id'] or m.get('cosigner_ids')!=list(p['cosigner_ids']):
    raise SystemExit('N=16 fixture identity does not match the configured profile.')
PY
 case "$STEP" in
  10.*) passed "$CAP/05.draft-core-vectors.json";;
  20.*) passed "$CAP/10.offline-existing.json";;
  30.*) passed "$CAP/20.offline-landmark.json";;
  40.*) passed "$CAP/20.offline-landmark.json"; passed "$CAP/30.offline-standalone.json";;
  50.*) [[ -f "$CAP/landmark/metadata.json" ]] || fail 'Landmark capture is missing.';;
  55.*) passed "$CAP/landmark/extracted/extraction.json";;
  60.*) passed "$CAP/landmark/extracted/extraction.json";;
  70.*) passed "$CAP/landmark/object-validation.json"; not_failed "$REVIEW/landmark/independent.json";;
  80.*) passed "$CAP/landmark/protocol-report.json";;
  90.*) [[ -f "$CAP/standalone/metadata.json" ]] || fail 'Standalone capture is missing.';;
  95.*) passed "$CAP/standalone/extracted/extraction.json";;
  100.*) passed "$CAP/standalone/extracted/extraction.json";;
  110.*) passed "$CAP/standalone/object-validation.json"; not_failed "$REVIEW/standalone/independent.json";;
  120.*) passed "$CAP/30.offline-standalone.json";;
 esac
}
run_all() (
 load
 local started_epoch report
 started_epoch=$(date +%s)
 report="artifacts/reports/protocol-validation-$STAMP/report.html"
 finalize_single_report() {
  local rc=$?
  trap - EXIT INT TERM
  rmdir "$STATE/batch.lock" 2>/dev/null || true
  if [[ -d "$CAP" ]]; then
   python3 - "$CAP/execution.json" "$started_epoch" "$rc" "$PROFILE" "$LEAF" "$FIX" "$KEY" <<'PYEXEC'
import json,os,platform,subprocess,sys,time
from pathlib import Path
def sysctl(name):
    try:return subprocess.check_output(['/usr/sbin/sysctl','-n',name],text=True,stderr=subprocess.DEVNULL).strip()
    except (OSError,subprocess.CalledProcessError):return ''
def cpu_frequency():
    for name in ('hw.cpufrequency_max','hw.cpufrequency'):
        value=sysctl(name)
        if value.isdigit() and int(value)>0:return f'{int(value)/1_000_000_000:.2f} GHz'
    return 'not reported by OS (dynamic frequency)'
p=Path(sys.argv[1]); finished=int(time.time())
p.write_text(json.dumps({'status':'PASS' if int(sys.argv[3])==0 else 'NO PASS','configuration':{'profile':sys.argv[4],'leaf':int(sys.argv[5]),'tree_size':16,'fixture_directory':sys.argv[6],'server_key':sys.argv[7],'modes':['landmark','standalone']},'started_unix':int(sys.argv[2]),'finished_unix':finished,'elapsed_seconds':finished-int(sys.argv[2]),'host':{'hostname':platform.node(),'system':platform.system(),'release':platform.release(),'machine':platform.machine(),'processor':sysctl('machdep.cpu.brand_string') or platform.processor(),'cpu_frequency':cpu_frequency(),'cpu_count':os.cpu_count(),'python':platform.python_version()}},indent=2)+'\n')
PYEXEC
   render_validation_html protocol "$CAP" "$report" || [[ "$rc" != 0 ]] || rc=$?
  fi
  exit "$rc"
 }
 trap finalize_single_report EXIT
 trap 'exit 130' INT TERM
 mkdir "$STATE/batch.lock" 2>/dev/null || fail 'A batch is active or a lock needs inspection.'
 [[ ! -d "$STATE/lock" ]] || fail 'A stage is active or a lock needs inspection.'
 local step state count=0
 for step in "${STEPS[@]}"; do
  state=''
  [[ ! -f "$STATE/$step.status" ]] || state=$(cat "$STATE/$step.status")
  case "$state" in running*) fail "Stage marked running: $step. Inspect its process and log before continuing.";; esac
 done
 for step in "${STEPS[@]}"; do
  state=''
  [[ ! -f "$STATE/$step.status" ]] || state=$(cat "$STATE/$step.status")
  case "$state" in completed*) printf 'SKIP completed: %s\n' "$step"; continue;; esac
  printf 'Batch stage: %s\n' "$step"
  run_step "$step" batch || exit "$?"
  count=$((count+1))
 done
 printf 'Batch completed: %s stages.\n' "$count"
)
run_step() (
 [[ "${2:-}" == batch || ! -d "$STATE/batch.lock" ]] || fail 'A batch is active or a lock needs inspection.'
 load || exit "$?"
 plan "$1" || exit "$?"
 mkdir "$STATE/lock" 2>/dev/null || fail 'Another stage is active or a lock remains after interruption.'
 trap 'rmdir "$STATE/lock" 2>/dev/null || true' EXIT
 preflight || exit "$?"
 mkdir -p "$CAP" || exit "$?"
 case "$STEP" in 55.*|95.*) mkdir -p "$(dirname "$OUT")" || exit "$?";; esac
 local log rc
 log="$STATE/$STEP-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
 printf 'running; log=%s\n' "$log" > "$STATE/$STEP.status"
 trap 'printf "interrupted; log=%s\n" "$log" > "$STATE/$STEP.status"; exit 130' INT TERM
 printf 'Stage %s\nLog %s\n' "$STEP" "$log"; show
 set +e
 PYTHONUNBUFFERED=1 "${CMD[@]}" 2>&1 | tee "$log"
 rc=${PIPESTATUS[0]}
 set -e
 if [[ "$rc" == 0 ]]; then printf 'completed; log=%s\n' "$log" > "$STATE/$STEP.status";
 else printf 'failed (exit %s); log=%s\n' "$rc" "$log" > "$STATE/$STEP.status"; fi
 cat "$STATE/$STEP.status"; exit "$rc"
)
set_path() {
 load
 [[ ! -d "$STATE/lock" && ! -d "$STATE/batch.lock" ]] || fail 'Do not change paths while a stage or batch is running.'
 case "$1" in FIX|KEY|CAP|PROFILE|LEAF) ;; *) fail 'Variables: FIX KEY CAP PROFILE LEAF';; esac
 [[ ! -d "$CAP" ]] || fail 'Evidence already exists: use new for another campaign; previous state is preserved.'
 if [[ "$1" == PROFILE ]]; then
  configure_mtc_profile "$2" "${LEAF:-0}"
  save; return
 fi
 if [[ "$1" == LEAF ]]; then
  configure_mtc_profile "$PROFILE" "$2"
  save; return
 fi
 # Relative artifact paths keep container and host references identical.
 case "$2" in artifacts/*) ;; *) fail 'Use a relative path under artifacts/.';; esac
 case "/$2/" in */../*|*/./*|*//*|*$'\n'*) fail 'Path is not normalized.';; esac
 if [[ "$1" == CAP ]]; then
  case "$2" in artifacts/protocol-validation/*) ;; *) fail 'CAP must be under artifacts/protocol-validation/.';; esac
  REVIEW="${2/artifacts\/protocol-validation/artifacts\/protocol-review}"
 fi
 [[ ! -d "$CAP" ]] || fail 'Evidence already exists: use new for another campaign; previous state is preserved.'
 printf -v "$1" '%s' "$2"; save
}
write_matrix_summary() {
 local name=$1
 local launcher_rc=${2:-0}
 local started_epoch=${3:-$(date +%s)}
 mkdir -p "artifacts/protocol-validation/$name" "artifacts/protocol-review/$name"
 python3 - "$name" "$launcher_rc" "$started_epoch" "${PROFILE_MATRIX[@]}" <<'PYSUM'
import hashlib
import json
import os
import platform
import subprocess
import sys
import time
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path

name = sys.argv[1]
launcher_rc = int(sys.argv[2])
started_epoch = int(sys.argv[3])
finished_epoch = int(time.time())
profiles = sys.argv[4:]
leaf_count = 16
modes = ('landmark', 'standalone')
stages = (
    '10.offline-existing',
    '20.offline-landmark',
    '30.offline-standalone',
    '40.capture-landmark',
    '50.extract-landmark',
    '55.verify-transcript-landmark',
    '60.validate-wire-landmark',
    '70.report-landmark',
    '80.capture-standalone',
    '90.extract-standalone',
    '95.verify-transcript-standalone',
    '100.validate-wire-standalone',
    '110.report-standalone',
    '120.invalid-input-stress',
)

cap_root = Path('artifacts/protocol-validation') / name
review_root = Path('artifacts/protocol-review') / name
state_root = Path('.mt-state/protocol-validation-matrix') / name
expected_identities = len(profiles) * leaf_count
expected_handshakes = expected_identities * len(modes)


def load_json(path):
    path = Path(path)
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text())
    except Exception as exc:
        return {'overall': 'ERROR', 'error': str(exc)}


def overall(path):
    data = load_json(path)
    if data is None:
        return 'MISSING'
    return data.get('overall', 'UNKNOWN')


draft_core = load_json(cap_root / '05.draft-core-vectors.json') or {}
draft_core_status = draft_core.get('overall', 'MISSING')


def status_bucket():
    return {
        'PASS': 0,
        'FAIL': 0,
        'PARTIAL': 0,
        'NOT_EXECUTED': 0,
        'MISSING': 0,
        'OTHER': 0,
    }


def add_status(bucket, value):
    if value in bucket:
        bucket[value] += 1
    else:
        bucket['OTHER'] += 1


def stage_status(path):
    path = Path(path)
    if not path.is_file():
        return 'MISSING', None
    text = path.read_text().strip()
    if text.startswith('completed'):
        state = 'COMPLETED'
    elif text.startswith('failed'):
        state = 'FAILED'
    elif text.startswith('running'):
        state = 'RUNNING'
    elif text.startswith('interrupted'):
        state = 'INTERRUPTED'
    else:
        state = 'OTHER'
    log = None
    if 'log=' in text:
        log = text.split('log=', 1)[1].strip()
    return state, log


def command_output(args):
    try:
        return subprocess.check_output(
            args,
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except Exception:
        return None


def file_sha256(path):
    path = Path(path)
    if not path.is_file():
        return None
    h = hashlib.sha256()
    with path.open('rb') as f:
        for block in iter(lambda: f.read(1024 * 1024), b''):
            h.update(block)
    return h.hexdigest()


stage_summary = {}
stage_failures = []
for stage in stages:
    if stage == '120.invalid-input-stress':
        executions = [(profile, 0) for profile in profiles]
    else:
        executions = [
            (profile, leaf)
            for profile in profiles
            for leaf in range(leaf_count)
        ]
    counts = Counter()
    for profile, leaf in executions:
        leaf_name = f'leaf-{leaf:04d}'
        status_path = state_root / profile / leaf_name / f'{stage}.status'
        state, log = stage_status(status_path)
        counts[state] += 1
        if state in ('FAILED', 'INTERRUPTED', 'RUNNING', 'OTHER'):
            stage_failures.append({
                'profile': profile,
                'leaf': leaf,
                'stage': stage,
                'status': state,
                'status_file': str(status_path),
                'log': log,
            })
    stage_summary[stage] = {
        'expected': len(executions),
        'completed': counts['COMPLETED'],
        'failed': counts['FAILED'],
        'interrupted': counts['INTERRUPTED'],
        'running': counts['RUNNING'],
        'missing': counts['MISSING'],
        'other': counts['OTHER'],
    }

captures_present = 0
captures_nonempty = 0
keylogs_present = 0
metadata_present = 0
object_counts = status_bucket()
independent_counts = status_bucket()
protocol_counts = status_bucket()
certificate_verify_counts = status_bucket()
server_finished_counts = status_bucket()
client_finished_counts = status_bucket()
capture_integrity = {
    'metadata_missing': 0,
    'captured_packets_zero': 0,
    'kernel_drops_nonzero': 0,
    'inputs_not_preserved': 0,
    'sources_not_preserved': 0,
}
verifier_hashes = Counter()
capture_image_ids = Counter()
profile_summary = {}
identity_pass_count = 0

for profile in profiles:
    profile_identity_pass = 0
    profile_protocol_pass = 0
    profile_independent_pass = 0
    for leaf in range(leaf_count):
        leaf_name = f'leaf-{leaf:04d}'
        identity_ok = True
        for mode in modes:
            base = cap_root / profile / leaf_name / mode
            independent_path = review_root / profile / leaf_name / mode / 'independent.json'

            pcap = base / 'handshake.pcap'
            keylog = base / 'tls.keys'
            metadata_path = base / 'metadata.json'

            if pcap.is_file():
                captures_present += 1
                if pcap.stat().st_size > 0:
                    captures_nonempty += 1
                else:
                    identity_ok = False
            else:
                identity_ok = False

            if keylog.is_file():
                keylogs_present += 1
            else:
                identity_ok = False

            metadata = load_json(metadata_path)
            if metadata is None:
                capture_integrity['metadata_missing'] += 1
                identity_ok = False
            else:
                metadata_present += 1
                if not metadata.get('captured_packets'):
                    capture_integrity['captured_packets_zero'] += 1
                    identity_ok = False
                if metadata.get('kernel_drops') != 0:
                    capture_integrity['kernel_drops_nonzero'] += 1
                    identity_ok = False
                if metadata.get('inputs_preserved') is not True:
                    capture_integrity['inputs_not_preserved'] += 1
                    identity_ok = False
                if metadata.get('sources_preserved') is not True:
                    capture_integrity['sources_not_preserved'] += 1
                    identity_ok = False
                capture_image_id = metadata.get('capture_image_id')
                if capture_image_id:
                    capture_image_ids[capture_image_id] += 1

            obj_status = overall(base / 'object-validation.json')
            add_status(object_counts, obj_status)
            if obj_status != 'PASS':
