 new) new_campaign "${2:-$(date -u +%Y%m%dT%H%M%SZ)}";;
 status) status;;
 list) printf '%s\n' "${STEPS[@]}";;
 profiles) printf '%s\n' "${PROFILE_MATRIX[@]}";;
 mutual-auth) shift; mutual_authentication "$@";;
 retry) shift; retry_validation "$@";;
 show) load; plan "${2:?Stage required}"; show;;
