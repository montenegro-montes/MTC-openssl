menu() {
 local choice value key
 while true; do
  printf '\nProtocol validation: 1 Initialize  2 Status  3 Show command\n                     4 Run stage  5 Change path  6 New campaign\n                     7 Run ALL pending stages (includes captures and stress checks)\n                     8 Run ALL PROFILES × ALL LEAVES (9 × 16 identities)\n                     9 Mutual-authentication preflight\n                    10 Trust-anchor retry preflight  0 Back\n'
  read -r -p '> ' choice || return 0
  case "$choice" in
   1) read -r -p 'Date/name (empty=new): ' value; "$SELF" init "${value:-$(date -u +%Y%m%dT%H%M%SZ)}" || true;;
   2) "$SELF" status || true;;
   3|4) printf '%s\n' "${STEPS[@]}"; read -r -p 'Number: ' value
     if [[ "$choice" == 3 ]]; then "$SELF" show "$value" || true; else "$SELF" run "$value" || true; fi;;
   5) read -r -p 'Variable FIX, KEY, CAP, PROFILE or LEAF: ' key; read -r -p 'Relative path: ' value; "$SELF" set "$key" "$value" || true;;
   6) read -r -p 'New date/name (empty=new): ' value; "$SELF" new "${value:-$(date -u +%Y%m%dT%H%M%SZ)}" || true;;
   7) "$SELF" run ALL || true;;
   8) read -r -p 'Matrix date/name (empty=new): ' value; "$SELF" run ALL-PROFILES "${value:-$(date -u +%Y%m%dT%H%M%SZ)}" || true;;
   9) "$SELF" mutual-auth --json || true;;
   10) load; printf 'Using configured profile=%s leaf=%s.\n' "$PROFILE" "$LEAF"; read -r -p 'New output below artifacts/results/ (empty=new): ' value
     if [[ -n "$value" ]]; then "$SELF" retry preflight "$value" || true; else "$SELF" retry preflight || true; fi;;
   0) return 0;;
  esac
 done
}
case "${1:-menu}" in
 init) init "${2:-$(date -u +%Y%m%dT%H%M%SZ)}";;
