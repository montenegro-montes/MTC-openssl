  else
   printf 'ERROR: matrix summary generation failed for campaign %s.\n' "$name" >&2
   if [[ "$rc" == 0 ]]; then rc=1; fi
  fi
  set -e
  exit "$rc"
 }

 trap finalize_matrix EXIT
 trap 'exit 130' INT TERM

 printf 'Protocol-validation matrix: %s\n' "$name"
 printf 'Profiles: %s\n' "${PROFILE_MATRIX[*]}"
 printf 'Leaves per profile: 0..%s (N=16).\n' "$((LEAF_COUNT-1))"
 printf 'TLS identities to validate: %s.\n' "$(( ${#PROFILE_MATRIX[@]} * LEAF_COUNT ))"
 total=$(( ${#PROFILE_MATRIX[@]} * LEAF_COUNT ))

 mkdir -p "artifacts/protocol-validation/$name"
 matrix_core="artifacts/protocol-validation/$name/05.draft-core-vectors.json"
 if [[ ! -f "$matrix_core" ]]; then
  printf '\nDraft core-vector evaluation (once for the complete matrix)\n'
  python3 campaigns/validation/protocol_validation/draft_core_audit.py \
   --output "$matrix_core"
 fi
 passed "$matrix_core"

 for profile in "${PROFILE_MATRIX[@]}"; do
  profile_index=$((profile_index+1))
  printf '\n############################################################\n'
  printf 'Profile: %s\n' "$profile"
  printf '############################################################\n'
  for ((leaf=0; leaf<LEAF_COUNT; leaf++)); do
   printf -v leaf4 '%04d' "$leaf"
   leaf_state="$MATRIX_STATE_ROOT/$name/$profile/leaf-$leaf4"
   printf '\n============================================================\n'
   now=$(date +%s); elapsed=$((now-started_epoch))
   if ((completed>0)); then
    average=$((elapsed/completed)); eta=$((average*(total-completed)))
   else
    average=0; eta=0
   fi
   printf 'Profile: %s (%d/%d)  leaf/key: %d/%s\n' "$profile" "$profile_index" "${#PROFILE_MATRIX[@]}" "$leaf" "$leaf"
   printf 'Overall identity: %d/%d  completed: %d  elapsed: %02d:%02d:%02d' "$((completed+1))" "$total" "$completed" "$((elapsed/3600))" "$(((elapsed%3600)/60))" "$((elapsed%60))"
   if ((completed>0)); then printf '  estimated remaining: %02d:%02d:%02d\n' "$((eta/3600))" "$(((eta%3600)/60))" "$((eta%60))"; else printf '  estimated remaining: calculating\n'; fi
   printf '============================================================\n'
   if [[ ! -f "$leaf_state/paths.env" ]]; then
    MT_PROTOCOL_STATE="$leaf_state" "$SELF" init-profile "$name" "$profile" "$leaf"
   fi
   # Stage 05 is evaluated once for the matrix.  Each identity receives the
   # exact same evidence so its ordinary prerequisite gate and standalone
   # report remain self-contained without rerunning the draft vectors.
   leaf_cap="artifacts/protocol-validation/$name/$profile/leaf-$leaf4"
   leaf_core="$leaf_cap/05.draft-core-vectors.json"
   mkdir -p "$leaf_cap"
   if [[ -f "$leaf_core" ]]; then
    cmp -s "$matrix_core" "$leaf_core" || fail "Leaf draft-core evidence differs from the matrix result: $leaf_core"
   else
    cp -p "$matrix_core" "$leaf_core"
   fi
   MT_PROTOCOL_STATE="$leaf_state" "$SELF" run LEAF-ALL
   completed=$((completed+1))
  done
  # Invalid-input stress is fixture/profile-wide, not leaf-specific: run it once per profile.
  stress_state="$MATRIX_STATE_ROOT/$name/$profile/leaf-0000"
  printf '\nProfile-wide invalid-input stress: %s (executed once, using leaf 0 state)\n' "$profile"
  MT_PROTOCOL_STATE="$stress_state" "$SELF" run 120
 done

 printf '\nAll profile/leaf validation executions completed.\n'
)

