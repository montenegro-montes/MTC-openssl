doctor() {
 local os tool
 os=$(uname -s)
 printf 'OS: %s\nArchitecture: %s\n' "$os" "$(uname -m)"
 case "$os" in
  Darwin)
   if command -v sw_vers >/dev/null; then sw_vers; else echo 'MISSING sw_vers'; fi
   if command -v xcode-select >/dev/null; then xcode-select -p || echo 'MISSING active developer directory'; else echo 'MISSING xcode-select'; fi
   tools=(clang python3 git docker);;
  Linux)
   if [[ -f /etc/os-release ]]; then cat /etc/os-release; else echo 'MISSING /etc/os-release'; fi
   tools=(git python3 curl bash tar xz unzip clang ninja docker);;
  *) tools=(git python3 docker);;
 esac
 # Presence checks only: do not invoke wrappers that may bootstrap tools.
 for tool in "${tools[@]}" gclient gn autoninja; do
  if command -v "$tool" >/dev/null; then printf 'PRESENT %s: %s\n' "$tool" "$(command -v "$tool")"; else echo "MISSING $tool"; fi
 done
 echo 'Free disk space (repository filesystem):'
 df -h "$REPO" || echo 'Disk space unavailable'
 return 0
}
