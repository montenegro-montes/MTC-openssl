#!/usr/bin/env bash
# Compatibility dispatcher; setup and experiments have separate entrypoints.
set -euo pipefail
DRIVER_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1:-menu}" in
 menu)
  [[ -t 0 ]] || { echo 'ERROR: menu requires an interactive TTY on stdin.' >&2; exit 1; }
  trap 'printf "\n"; exit 130' INT
  while true; do
   printf '\n1. Setup / installation\n2. Tests / experiments\n3. Exit\n'
   read -r -p 'Select an option: ' choice || exit 0
   case "$choice" in
    1) "$DRIVER_DIR/mt-chromium-setup" menu || echo 'Setup exited with an error.';;
    2) "$DRIVER_DIR/mt-chromium-tests" menu || echo 'Tests exited with an error.';;
    0|3) exit 0;;
    *) echo 'Invalid option.';;
   esac
  done;;
 help|--help|-h)
  echo 'Usage: mt-chromium-mtc menu'
  echo 'Setup: mt-chromium-setup --help'
  echo 'Tests: mt-chromium-tests --help'
  echo 'Existing CLI commands are forwarded to the corresponding driver.';;
 browser-validation)
  case "${2:-}" in credentials|cleanup|trust-status|trust-x509|untrust-x509) exec "$DRIVER_DIR/mt-chromium-setup" "$@";; esac
  exec "$DRIVER_DIR/mt-chromium-tests" "$@";;
 browser-pcap|browser-measurements|preflight|network-experiments) exec "$DRIVER_DIR/mt-chromium-tests" "$@";;
 *) exec "$DRIVER_DIR/mt-chromium-setup" "$@";;
esac
