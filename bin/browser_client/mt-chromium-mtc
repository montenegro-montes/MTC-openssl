#!/usr/bin/env bash
# Existing-build interoperability plus explicit source reconstruction; never builds.
set -euo pipefail
REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$REPO"
STATE="$REPO/.mt-state/chromium-mtc"
STEPS=(00.preflight 10.detect-existing-chromium 20.select-or-generate-mtc-fixture 30.validate-mtc-fixture 40.export-mtc-anchor 50.configure-hostname 60.start-mtc-positive-server)
fail() { echo "ERROR: $*" >&2; exit 1; }
load() { [[ -f "$STATE/paths.env" ]] || fail 'Run init first.'; source "$STATE/paths.env"; }
init() {
 mkdir -p "$STATE"
 [[ ! -e "$STATE/paths.env" ]] || { echo 'Existing configuration preserved.'; return; }
 local fixture="$REPO/artifacts/mtc/browser-server-mtc-example-com-ecdsa-p256-n16-20260925T082751Z-24938"
 (set -o noclobber; printf 'CHROMIUM_SRC=%q\nFIXTURE=%q\nVALIDATION=%q\nANCHOR=%q\nHOSTNAME_LAB=%q\nCONTAINER=%q\n' \
 "$HOME/Desktop/chromium-mtc/src" "$fixture" "$fixture-validation/validation.json" "$fixture-chromium.json" server.mtc.example.com mtc-browser-server > "$STATE/paths.env")
}
step_name() {
 local s
 for s in "${STEPS[@]}"; do if [[ "$1" == "$s" || "$1" == "${s%%.*}" ]]; then echo "$s"; return; fi; done
 fail "Unknown step: $1"
}
check_fixture() {
 python3 - "$FIXTURE" "$VALIDATION" "$HOSTNAME_LAB" "$STATE" <<'PY'
import hashlib,json,sys
from pathlib import Path
root,validation,hostname,state=Path(sys.argv[1]),Path(sys.argv[2]),sys.argv[3],Path(sys.argv[4])
d=json.loads(validation.read_text())
assert d['passed'] and d['server_hostname']==hostname, 'Validation/hostname mismatch'
assert any(c['profile']=='ecdsa-p256' and c['tree_size']==16 and c['mtc_mode']=='landmark' and c['success'] for c in d['cells'])
actual={str(p.relative_to(root)):hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(root.rglob('*')) if p.is_file()}
assert actual==d['fixture_hashes'], 'Fixture differs from validated evidence'
assert json.loads((root/'manifest.json').read_text())['server_hostname']==hostname
image=d['provenance']['image_id']
assert image.startswith('sha256:')
(state/'image-id').write_text(image+'\n')
print('PASS existing fixture hashes, hostname and ECDSA-P256/N=16 landmark evidence')
PY
}
owned() { [[ "$(docker inspect -f '{{index .Config.Labels "mtc.workflow"}}' "$CONTAINER")" == "$STATE" ]]; }
start_server() {
 local prerequisite
 for prerequisite in "${STEPS[@]:0:6}"; do
  [[ -f "$STATE/$prerequisite.done" ]] || fail "Run $prerequisite first."
 done
 check_fixture
 local image result id
 image=$(cat "$STATE/image-id")
 docker image inspect "$image" >/dev/null
 if docker container inspect "$CONTAINER" >/dev/null 2>&1; then
  owned || fail 'Container name belongs to another workflow; preserved.'
  [[ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER")" == true ]] || fail 'Owned container stopped; inspect logs and cleanup before restarting.'
  echo "Already running: $CONTAINER"; return
 fi
 result=$(mktemp -d "$REPO/artifacts/results/chromium-mtc-validation-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")
 printf '%s\n' "$result" > "$STATE/result-dir"
 id=$(docker run -d --pull never --name "$CONTAINER" --label "mtc.workflow=$STATE" \
  -p 127.0.0.1:4433:4433 -v "$FIXTURE:/fixtures:ro" -v "$result:/results" \
  --entrypoint /bin/sh "$image" -c 'exec /opt/mtc/openssl.sh s_server -accept 4433 -tls1_3 -groups X25519 -ciphersuites TLS_AES_256_GCM_SHA384 -num_tickets 0 -www -state -msg -cert /fixtures/batch16/mtc/ecdsa-p256/landmark-0000.pem -key /fixtures/population/ecdsa-p256/0.key -mtc_id 32473.101.1.1.1 > /results/server.log 2>&1')
 printf '%s\n' "$id" > "$STATE/container-id"
 # No probe handshake: wait only for OpenSSL's listening marker.
 for ((n=0;n<20;n++)); do
  [[ "$(docker inspect -f '{{.State.Running}}' "$id")" == true ]] || fail "Server exited; inspect $result/server.log"
  if grep -q '^ACCEPT' "$result/server.log" 2>/dev/null; then echo "RUNNING $CONTAINER; log: $result/server.log"; return; fi
  sleep 0.25
 done
 fail "Readiness not confirmed; container preserved. Inspect $result/server.log"
}
run_step() {
 local step=$1
 case "$step" in
  00.*) for cmd in python3 git docker; do command -v "$cmd" >/dev/null || fail "Missing $cmd"; done; docker info >/dev/null;;
  10.*) python3 - "$CHROMIUM_SRC" "$STATE" <<'PY'
import hashlib,json,os,re,subprocess,sys
from pathlib import Path
src,state=map(Path,sys.argv[1:]);exe=src/'out/mtc/Chromium.app/Contents/MacOS/Chromium'
assert exe.is_file() and os.access(exe,os.X_OK), 'Existing Chromium missing; no build will be attempted'
args=(src/'out/mtc/args.gn').read_text()
def commit(p):return subprocess.check_output(['git','-C',str(p),'rev-parse','HEAD'],text=True).strip()
def flag(k):
 m=re.search(r'^\s*'+k+r'\s*=\s*(true|false)\s*(?:#.*)?$',args,re.M)
 if m:return m.group(1)=='true'
 ninja=src/'out/mtc/obj/base/base.ninja'
 if k=='is_component_build' and ninja.is_file():return '-DCOMPONENT_BUILD' in ninja.read_text().splitlines()[0]
 return 'not explicit in args.gn'
h=hashlib.sha256()
with exe.open('rb') as f:
 for b in iter(lambda:f.read(1024*1024),b''):h.update(b)
d=dict(executable=str(exe),chromium_commit=commit(src),boringssl_commit=commit(src/'third_party/boringssl/src'),is_component_build=flag('is_component_build'),is_debug=flag('is_debug'),sha256=h.hexdigest())
(state/'chromium.json').write_text(json.dumps(d,indent=2)+'\n');print(json.dumps(d,indent=2))
PY
 ;;
  20.*) [[ -d "$FIXTURE" ]] || fail 'Known fixture missing. Generate explicitly with fixtures.py into a fresh timestamped output, then update paths.env.'; check_fixture;;
  30.*) check_fixture;;
  40.*) check_fixture
   python3 - "$REPO" "$FIXTURE" "$ANCHOR" <<'PY'
import hashlib,json,sys
from pathlib import Path
repo,fixture,out=map(Path,sys.argv[1:]);sys.path.insert(0,str(repo/'campaigns/browser_client/chromium_mtc'))
from export_chromium_anchor import parse_landmark
trust=fixture/'batch16/mtc/ecdsa-p256/trust.bin';raw=trust.read_bytes();expected=parse_landmark(raw)
assert expected['landmark']['requested_trust_anchor_id']=='32473.101.2.1.1'
assert expected['landmark']['selected_trust_anchor_id']=='32473.101.1.1.1'
if out.exists():
 data=json.loads(out.read_text());assert all(data.get(k)==v for k,v in expected.items()), 'Existing anchor mismatch'
 assert data['source']['trust_file_sha256']==hashlib.sha256(raw).hexdigest()
else:
 import subprocess
 subprocess.run([sys.executable,str(repo/'campaigns/browser_client/chromium_mtc/export_chromium_anchor.py'),'--trust',str(trust),'--output',str(out)],check=True)
print('PASS anchor:',out)
PY
 ;;
  50.*) python3 - "$HOSTNAME_LAB" <<'PY'
import shlex,socket,sys
from pathlib import Path
host=sys.argv[1];matches=[line.split('#')[0].split() for line in Path('/etc/hosts').read_text().splitlines()]
assert any(p and p[0]=='127.0.0.1' and host in p[1:] for p in matches), "Run manually: printf '%s\\n' " + shlex.quote('127.0.0.1 '+host) + ' | sudo tee -a /etc/hosts'
assert all(p[0]=='127.0.0.1' for p in matches if host in p[1:]), 'Conflicting hosts entry'
assert {a[4][0] for a in socket.getaddrinfo(host,4433)}=={'127.0.0.1'}, 'Resolution differs from loopback'
print('PASS existing hosts entry; not owned or modified by this workflow')
PY
 ;;
  60.*) start_server;;
 esac
 date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE/$step.done"
}
doctor() {
 local os tool
 os=$(uname -s)
 printf 'OS: %s\nArchitecture: %s\n' "$os" "$(uname -m)"
 case "$os" in
  Darwin)
   if command -v sw_vers >/dev/null; then sw_vers; else echo 'MISSING sw_vers'; fi
   if command -v xcode-select >/dev/null; then xcode-select -p || echo 'MISSING active developer directory'; else echo 'MISSING xcode-select'; fi
   tools=(clang python3 git docker);;
  Linux)
   if [[ -f /etc/os-release ]]; then cat /etc/os-release; else echo 'MISSING /etc/os-release'; fi
   tools=(git python3 curl bash tar xz unzip clang ninja docker);;
  *) tools=(git python3 docker);;
 esac
 # Presence checks only: do not invoke wrappers that may bootstrap tools.
 for tool in "${tools[@]}" gclient gn autoninja; do
  if command -v "$tool" >/dev/null; then printf 'PRESENT %s: %s\n' "$tool" "$(command -v "$tool")"; else echo "MISSING $tool"; fi
 done
 echo 'Free disk space (repository filesystem):'
 df -h "$REPO" || echo 'Disk space unavailable'
 return 0
}
reconstruct_plan() (
 source "$REPO/campaigns/browser_client/chromium_mtc/versions/chromium-mtc.env"
 cat <<PLAN
PRINT ONLY — no reconstruction commands executed.
Upstream pinned bases:
  depot_tools: $DEPOT_TOOLS_COMMIT
  Chromium $CHROMIUM_VERSION: $CHROMIUM_BASE_COMMIT
  Chromium base tree: $CHROMIUM_BASE_TREE
  BoringSSL: $BORINGSSL_BASE_COMMIT
  BoringSSL base tree: $BORINGSSL_BASE_TREE
Verify patches/SHA256SUMS and source-bundles/SHA256SUMS from the campaign directory.
Import exact preserved custom commits (do not replay git am):
  source-bundles/chromium-mtc.bundle -> $CHROMIUM_PATCHED_COMMIT
  source-bundles/boringssl-mtc.bundle -> $BORINGSSL_PATCHED_COMMIT
Verify exact commits, Chromium's BoringSSL gitlink, and authoritative source trees:
  Chromium: $CHROMIUM_PATCHED_TREE
  BoringSSL: $BORINGSSL_PATCHED_TREE
Explicit source interface: reconstruct-source plan|status|run STEP [--dest ABSOLUTE_PATH]
Stages 100–160 reconstruct only these two source repositories and pinned depot_tools.
Other Chromium DEPS, toolchains and build configuration require later explicit work.
Later build: separately authorized, not implemented here; no packages or gclient sync.
Normal resume cannot execute reconstruction or build stages.
PLAN
)
reconstruct_source() {
 python3 - "$REPO" "$@" <<'PY'
import hashlib, json, os, re, subprocess, sys
from pathlib import Path

def require(ok, message):
 if not ok: raise SystemExit('ERROR: '+message)
def git(path, *args):
 return subprocess.check_output(['git','-c','core.hooksPath=/dev/null','-c','submodule.recurse=false','-C',str(path),*args], text=True).strip()
repo=Path(sys.argv[1]); root=repo/'campaigns/browser_client/chromium_mtc'
v=dict(line.split('=',1) for line in (root/'versions/chromium-mtc.env').read_text().splitlines() if line and not line.startswith('#'))
steps=['100.verify-reconstruction-inputs','110.prepare-depot-tools','120.prepare-chromium-base','130.prepare-boringssl-base','140.import-preserved-commits','150.checkout-patched-source','160.verify-source-trees']
args=sys.argv[2:]
destination=Path.home()/'chromium-mtc-rebuild'
if '--dest' in args:
 require(args.count('--dest')==1,'Supply --dest only once')
 offset=args.index('--dest')
 require(offset+1<len(args),'Use --dest ABSOLUTE_PATH')
 destination=Path(args[offset+1])
 require(destination.is_absolute(),'An absolute --dest is required')
 del args[offset:offset+2]
dest=destination.resolve()
action=args.pop(0) if args else 'plan'
require(action in ('plan','status','run'), 'Expected plan, status or run')
step=None
if action=='run':
 require(bool(args), 'Step required')
 requested=args.pop(0); matches=[s for s in steps if requested in (s,s.split('.')[0])]
 require(len(matches)==1,'Unknown reconstruction step'); step=matches[0]
require(not args,'Unexpected arguments; use plan|status|run STEP [--dest ABSOLUTE_PATH]')
if action=='plan':
 print('\n'.join(steps)); print('Explicit run only; steps 110–130 fetch pinned upstream repositories. No build, sync or installation.'); print('Destination: '+str(dest)); sys.exit(0)
protected=[Path.home()/'Desktop/chromium-mtc', repo, Path.home()/'Desktop/depot_tools']
for p in protected:
 p=p.resolve(); require(dest!=p and p not in dest.parents and dest not in p.parents,'Destination overlaps a protected checkout')
marker=dest/'.mtc-source-owner.json'; state=dest/'.mtc-source-state'
identity={'destination':str(dest),'versions':v,'workflow':'chromium-mtc-source-v1'}
if dest.exists():
 require(dest.is_dir(),'Destination is not a directory')
 if any(dest.iterdir()):
  require(marker.is_file() and not marker.is_symlink() and json.loads(marker.read_text())==identity,'Refusing non-empty destination without matching workflow ownership marker: '+str(marker))
if action=='status':
 print('Destination: '+str(dest))
 for s in steps: print(('RECORDED ' if (state/(s+'.done')).is_file() else 'PENDING ')+s)
 print('Markers record prior success; run 160 explicitly to reverify source.'); sys.exit(0)

def inputs():
 for manifest in ('patches/SHA256SUMS','source-bundles/SHA256SUMS'):
  for line in (root/manifest).read_text().splitlines():
   digest,name=line.split(None,1); f=root/name.strip()
   require(hashlib.sha256(f.read_bytes()).hexdigest()==digest,'SHA-256 mismatch: '+name)
 for label in ('CHROMIUM','BORINGSSL'):
  for suffix in ('BASE_COMMIT','PATCHED_COMMIT','BASE_TREE','PATCHED_TREE'):
   require(re.fullmatch('[0-9a-f]{40}',v[label+'_'+suffix]) is not None,'Invalid pin')
  bundle=root/'source-bundles'/(label.lower()+'-mtc.bundle')
  require(git(repo,'bundle','list-heads',str(bundle))==v[label+'_PATCHED_COMMIT']+' HEAD','Unexpected bundle tip')
 print('PASS patch/bundle SHA-256 and preserved tips')
inputs()
require(step==steps[0] or marker.is_file(),'Run 100 first')
dest.mkdir(parents=True,exist_ok=True)
if not marker.exists(): marker.write_text(json.dumps(identity,sort_keys=True)+'\n')
require(not state.is_symlink(),'Symlink state rejected'); state.mkdir(exist_ok=True)
lock=state/'lock'
try: lock.mkdir()
except FileExistsError: raise SystemExit('ERROR: Reconstruction locked; inspect before retrying')
try:
 index=steps.index(step)
 for previous in steps[:index]: require((state/(previous+'.done')).is_file(),'Run '+previous+' first')
 # A failed rerun must not leave success markers for this or dependent steps.
 for pending in steps[index:]:
  recorded=state/(pending+'.done')
  if recorded.exists(): recorded.unlink()
 # Reject symlink traversal and foreign repositories before any Git mutations.
 src=dest/'src'; boring=src/'third_party/boringssl/src'; depot=dest/'depot_tools'
 for path in (src,boring,depot):
  require(path.resolve()==path,'Symlink source path rejected')
  if (path/'.git').exists():
   require((path/'.git').is_dir() and not (path/'.git').is_symlink(),'External Git directory rejected')
   require(Path(git(path,'rev-parse','--show-toplevel')).resolve()==path,'Unexpected Git worktree')
 def verify(path, commit, tree=None):
  require(git(path,'rev-parse','HEAD')==commit,'HEAD mismatch: '+str(path))
  if tree: require(git(path,'show','-s','--format=%T','HEAD')==tree,'Tree mismatch: '+str(path))
 def clean(path):
  require(not git(path,'status','--porcelain','--untracked-files=all','--ignore-submodules=all'),'Dirty source: '+str(path))
 def prepare(path,url,commit,tree=None):
  if (path/'.git').exists():
   verify(path,commit,tree); clean(path); return
  require(not path.exists() or not any(path.iterdir()),'Unexpected non-empty source: '+str(path))
  path.mkdir(parents=True,exist_ok=True); git(path,'init')
  git(path,'fetch','--no-tags',url,commit)
  git(path,'checkout','--detach',commit)
  verify(path,commit,tree)
 if index==1: prepare(depot,'https://chromium.googlesource.com/chromium/tools/depot_tools.git',v['DEPOT_TOOLS_COMMIT'])
 if index==2: prepare(src,'https://chromium.googlesource.com/chromium/src.git',v['CHROMIUM_BASE_COMMIT'],v['CHROMIUM_BASE_TREE'])
 if index==3: prepare(boring,'https://boringssl.googlesource.com/boringssl',v['BORINGSSL_BASE_COMMIT'],v['BORINGSSL_BASE_TREE'])
 if index==4:
  for label,path in [('CHROMIUM',src),('BORINGSSL',boring)]:
   bundle=root/'source-bundles'/(label.lower()+'-mtc.bundle')
   require(git(path,'show','-s','--format=%T',v[label+'_BASE_COMMIT'])==v[label+'_BASE_TREE'],'Base tree mismatch')
   git(path,'bundle','verify',str(bundle)); git(path,'fetch','--no-tags',str(bundle),'HEAD')
   require(git(path,'show','-s','--format=%T',v[label+'_PATCHED_COMMIT'])==v[label+'_PATCHED_TREE'],'Imported tree mismatch')
 if index==5:
  for label,path in [('CHROMIUM',src),('BORINGSSL',boring)]:
   clean(path); git(path,'checkout','--detach',v[label+'_PATCHED_COMMIT'])
 if index in (5,6):
  verify(depot,v['DEPOT_TOOLS_COMMIT']); clean(depot)
  for label,path in [('CHROMIUM',src),('BORINGSSL',boring)]:
   verify(path,v[label+'_PATCHED_COMMIT'],v[label+'_PATCHED_TREE']); clean(path)
  require(git(src,'ls-tree','HEAD','third_party/boringssl/src')=='160000 commit '+v['BORINGSSL_PATCHED_COMMIT']+'\tthird_party/boringssl/src','BoringSSL gitlink mismatch')
  print('PASS exact commits, authoritative trees, clean tracked content and BoringSSL gitlink')
 (state/(step+'.done')).write_text('PASS\n'); print('PASS '+step)
finally: lock.rmdir()
PY
}
case "${1:-help}" in
 help|--help|-h) echo 'Usage: mt-chromium-mtc init|status|plan|doctor|reconstruct-plan|reconstruct-source plan|status|run STEP [--dest PATH]|show STEP|run STEP|resume|cleanup';;
 doctor) doctor;;
 reconstruct-plan) reconstruct_plan;;
 reconstruct-source) shift; reconstruct_source "$@";;
 init) init;;
 plan) printf '%s\n' "${STEPS[@]}"; echo 'Existing Chromium/validated fixture only. No build, pull or automatic generation.';;
 show) step=$(step_name "${2:?Step required}"); echo "$step"; sed -n '/^run_step()/,/^case "${1:-help}"/p' "$0"; [[ "$step" != 60.* ]] || sed -n '/^start_server()/,/^run_step()/p' "$0";;
 status) if [[ ! -f "$STATE/paths.env" ]]; then echo 'NOT INITIALIZED'; exit; fi; load
  for step in "${STEPS[@]}"; do if [[ -f "$STATE/$step.done" ]]; then echo "RECORDED $step"; else echo "PENDING $step"; fi; done
  [[ ! -f "$STATE/result-dir" ]] || cat "$STATE/result-dir"
  docker container inspect -f '{{.Name}} running={{.State.Running}} image={{.Image}}' "$CONTAINER" 2>/dev/null || echo 'Container unavailable (absent or Docker inaccessible)';;
 run|resume|cleanup) load; mkdir "$STATE/lock" 2>/dev/null || fail 'Workflow locked; inspect before retrying.'; trap 'rmdir "$STATE/lock"' EXIT
  case "$1" in
   run) run_step "$(step_name "${2:?Step required}")";;
   resume) for step in "${STEPS[@]}"; do if [[ -f "$STATE/$step.done" ]]; then echo "SKIP $step"; else run_step "$step"; fi; done;;
   cleanup) if docker container inspect "$CONTAINER" >/dev/null 2>&1; then owned || fail 'Foreign container preserved'; docker rm -f "$CONTAINER"; fi
    rm -f "$STATE/60.start-mtc-positive-server.done" "$STATE/container-id"
    echo 'Artifacts and existing hosts entry preserved. No browser profiles are created by this workflow.';;
  esac;;
 *) fail 'Unknown command; use help';;
esac
