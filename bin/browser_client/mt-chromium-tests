#!/usr/bin/env bash
# Test entrypoint; measurements may generate missing fixtures through prepare_credentials().
set -euo pipefail
REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
MENU_CALL_DIR=$PWD
cd "$REPO"
STATE="$REPO/.mt-state/chromium-mtc"
fail() { echo "ERROR: $*" >&2; exit 1; }
source "$REPO/bin/browser_client/mt-chromium-menu.sh"
browser_measurements_readiness() {
 python3 -B - "$REPO" <<'PY'
import sys
from pathlib import Path
repo = Path(sys.argv[1])
sys.path.insert(0, str(repo/'campaigns/browser_client/chromium_mtc'))
import browser_pcap as pcap
import browser_validation as bv

ready = True
try:
    browser = bv.browser_executable()
    print('Chromium: READY ('+browser['executable']+')')
except (ValueError, OSError) as error:
    ready = False
    print('Chromium: NOT READY ('+str(error)+')')

tools = pcap.requirements()
capture_ready = bool(tools['interface'] and tools['tshark'] and
                     (tools['dumpcap'] or tools['tcpdump']))
ready &= capture_ready
print('Capture: '+('READY' if capture_ready else 'NOT READY'))
profiles = ('ecdsa-p256', 'ecdsa-p384', 'mldsa44', 'mldsa65', 'mldsa87')
fixtures_ready = True
roots = []
print('Credential preparation:')
for profile in profiles:
    states = {}
    for mode in ('landmark', 'standalone'):
        try:
            bv.preselect_mtc_fixture(repo, profile, mode)
            states[mode] = 'READY'
        except (ValueError, OSError, KeyError, TypeError):
            states[mode] = 'NEEDS PREPARATION'
            fixtures_ready = False
    try:
        selected = [bv.precheck_formal_x509_fixture(
            repo, profile, depth, 'chromium-x509-depth-matrix-v1')
                    for depth in (2, 3, 4, 5)]
        roots.extend(fixture/'root.pem' for fixture in selected)
        states['x509'] = 'READY (D=2..5)'
    except (ValueError, OSError, KeyError, TypeError):
        states['x509'] = 'NEEDS PREPARATION'
        fixtures_ready = False
    print(f"  {profile:<11} X509={states['x509']}; "
          f"landmark={states['landmark']}; standalone={states['standalone']}")
ready &= fixtures_ready
try:
    for root in roots:
        bv.chromium_ca_policy(root)
    policy_ready = bool(roots)
except (ValueError, OSError, KeyError, TypeError):
    policy_ready = False
ready &= policy_ready
print('X.509 trust: '+('READY' if policy_ready else 'NEEDS PREPARATION')+
      ' (Chromium CACertificates; verification enabled)')
print('Ready: '+('YES' if ready else 'NO'))
PY
}

tests_menu_status() {
 python3 -B - "$REPO" <<'PY'
import sys
from pathlib import Path
repo = Path(sys.argv[1])
sys.path.insert(0, str(repo/'campaigns/browser_client/chromium_mtc'))
import browser_pcap as pcap
import browser_validation as bv

def brief(value):
    return ' '.join(str(value).split())[:180]

def latest(prefix):
    paths = sorted((repo/'artifacts/results').glob(prefix+'*/summary.json'))
    if not paths:
        return 'NOT RUN', None
    try:
        data = bv.read(paths[-1])
        passed = data.get('overall_pass') is True or data.get('status') == 'PASS'
        if passed:
            return 'PASS', None
        reason = data.get('reason') or data.get('error')
        if not reason and isinstance(data.get('reasons'), list):
            reason = next((str(value) for value in data['reasons'] if value), None)
        if not reason:
            reason = next((str(case.get('reason')) for case in data.get('cases', [])
                           if not case.get('pass') and case.get('reason')), None)
        return 'FAIL', brief(reason or 'Latest recorded run did not pass')
    except (OSError, ValueError, KeyError, TypeError) as error:
        return 'FAIL', brief(error)

preflight = 'PASS' if (repo/'.mt-state/chromium-mtc/00.preflight.done').is_file() else 'NOT RUN'
functional_landmark, landmark_reason = bv.functional_mode_status(repo, 'landmark')
functional_standalone, standalone_reason = bv.functional_mode_status(repo, 'standalone')
pcap_status, pcap_reason = latest('chromium-browser-pcap-')
measurements, measurements_reason = latest('chromium-browser-measurements-')

tools = pcap.requirements()
capture_ready = bool(tools['interface'] and tools['tshark'] and
                     (tools['dumpcap'] or tools['tcpdump']))
try:
    bv.browser_executable()
    chromium_ready = True
except (ValueError, OSError):
    chromium_ready = False

rows = (
    ('Preflight', preflight),
    ('Functional landmark', functional_landmark),
    ('Functional standalone', functional_standalone),
    ('PCAP validation', pcap_status),
    ('Browser measurements', measurements),
    ('Capture backend', 'READY' if capture_ready else 'NOT READY'),
    ('Chromium', 'READY' if chromium_ready else 'NOT READY'),
)
overall = (all(value == 'PASS' for value in
               (preflight, functional_landmark, functional_standalone,
                pcap_status, measurements))
           and capture_ready and chromium_ready)
print('Chromium / MTC — Tests status')
for label, value in rows:
    print(f'{label+":":<25}{value}')
print(f'{"Overall:":<25}'+('READY' if overall else 'NOT READY'))
for label, status, reason in (
        ('Functional landmark', functional_landmark, landmark_reason),
        ('Functional standalone', functional_standalone, standalone_reason),
        ('PCAP validation', pcap_status, pcap_reason),
        ('Browser measurements', measurements, measurements_reason)):
    if status == 'FAIL':
        print(f'{label} reason: {brief(reason)}')
PY
}

browser_measurements_environment() {
 local image=$1 chromium=$2 diagnostic socket_path
 echo '[DEPENDENCIES] Checking Docker, image, Chromium and capture tools...'
 command -v docker >/dev/null 2>&1 || fail 'Docker client is missing; install Docker without running the campaign as root.'
 if ! diagnostic=$(docker info 2>&1); then
  socket_path=${DOCKER_HOST:-}
  socket_path=${socket_path#unix://}
  [[ -n "$socket_path" && "$socket_path" != "${DOCKER_HOST:-}" ]] || socket_path=/var/run/docker.sock
  echo "[DEPENDENCIES] Docker: FAIL" >&2
  echo "User: $(id -un) (uid=$(id -u), groups=$(id -Gn))" >&2
  [[ ! -e "$socket_path" ]] || ls -ld "$socket_path" >&2 || true
  echo "Docker diagnostic: ${diagnostic//$'\n'/ }" >&2
  fail 'Docker API is inaccessible. Start Docker or arrange user access to its socket, then log out/in if group membership changed. No groups were modified.'
 fi
 echo '[DEPENDENCIES] Docker: PASS'
 docker image inspect "$image" >/dev/null 2>&1 ||
  fail "Required Docker image is unavailable: $image"
 echo "[DEPENDENCIES] Docker image: PASS ($image)"
 python3 -B - "$REPO" "$chromium" <<'PY'
import sys
from pathlib import Path
repo=Path(sys.argv[1]); requested=sys.argv[2]
sys.path.insert(0,str(repo/'campaigns/browser_client/chromium_mtc'))
import browser_pcap as pcap
import browser_preflight as bp
import browser_validation as bv
browser=bv.browser_executable(Path(requested) if requested else None)
print('[DEPENDENCIES] Chromium: PASS ('+browser['executable']+')')
tools=pcap.requirements()
capture=bp.capture_diagnostics(tools,check_capture=True)
for name in ('tcpdump','dumpcap','tshark','loopback','permissions','backend'):
    print('[CAPTURE] '+name+': '+capture[name])
if capture['backend'] != 'READY':
    for line in bp.capture_guidance(capture): print('[CAPTURE] action: '+line)
    raise ValueError('Capture backend is not ready ['+capture['category']+']: '
                     +str(capture['reason']))
print('[DEPENDENCIES] Capture backend: PASS')
for directory in (repo/'artifacts', repo/'.mt-state'):
    directory.mkdir(parents=True, exist_ok=True)
    bv.require(directory.is_dir() and not directory.is_symlink(),
               'Unsafe working directory: '+str(directory))
    bv.require(__import__('os').access(directory, __import__('os').R_OK | __import__('os').W_OK | __import__('os').X_OK),
               'Working directory is not accessible to the invoking user: '+str(directory))
print('[DEPENDENCIES] Working directories: PASS')
PY
}

browser_measurements_prepare() {
 local argument previous='' depth=2 image=mt-tls-mtc:local profile=ecdsa-p256 chromium='' all_profiles=false
 local profiles_text setup="$REPO/bin/browser_client/mt-chromium-setup"
 for argument in "$@"; do
  [[ "$previous" != --depth ]] || depth=$argument
  [[ "$previous" != --image ]] || image=$argument
  [[ "$previous" != --profile ]] || profile=$argument
  [[ "$previous" != --chromium ]] || chromium=$argument
  case "$argument" in
   --depth=*) depth=${argument#*=};; --image=*) image=${argument#*=};;
   --profile=*) profile=${argument#*=};; --chromium=*) chromium=${argument#*=};;
   --all-profiles) all_profiles=true;;
  esac
  previous=$argument
 done
 browser_measurements_environment "$image" "$chromium"
 if [[ "$all_profiles" == true ]]; then
  profiles_text=$(python3 -B - "$REPO" <<'PY'
import sys
from pathlib import Path
sys.path.insert(0,str(Path(sys.argv[1])/'campaigns/browser_client/chromium_mtc'))
from browser_measurements import CAMPAIGN_PROFILES
print(' '.join(CAMPAIGN_PROFILES))
PY
  ) || fail 'Could not load browser-measurements profiles.'
 else
  profiles_text=$profile
 fi
 echo "[X509] Preparing formal dependencies: profiles=$profiles_text depth=$depth"
 "$setup" x509-fixtures ensure --fixture-set chromium-x509-depth-matrix-v1 \
  --output "$REPO/artifacts/x509/chromium-x509-depth-matrix-v1" \
  --profiles $profiles_text --depth "$depth" --image "$image"
 echo '[POLICY] Checking Chromium CACertificates...'
 "$setup" ca-policy-prepare
 echo '[CREDENTIALS] Preparing landmark and standalone credentials...'
 if [[ "$all_profiles" == true ]]; then
  "$setup" browser-validation credentials --all-profiles --depth "$depth" --image "$image"
 else
  "$setup" browser-validation credentials --measurement-profile "$profile" --depth "$depth" --image "$image"
 fi
 python3 -B - "$REPO" "$profiles_text" "$depth" <<'PY'
import json,os,sys,tempfile
from datetime import datetime,timezone
from pathlib import Path
repo,profiles,depth=Path(sys.argv[1]),sys.argv[2].split(),int(sys.argv[3])
sys.path.insert(0,str(repo/'campaigns/browser_client/chromium_mtc'))
import browser_validation as bv
items=[]
for profile in profiles:
    fixture=bv.precheck_formal_x509_fixture(repo,profile,depth,'chromium-x509-depth-matrix-v1')
    mtc={}
    for mode in ('landmark','standalone'):
        selected,_=bv.preselect_mtc_fixture(repo,profile,mode)
        mtc[mode]={'fixture':selected['fixture'],'validation_evidence':selected['validation_evidence'],
                   'anchor':selected['anchor'],'anchor_sha256':selected['anchor_sha256']}
    items.append({'profile':profile,'depth':depth,'x509_fixture':str(fixture.resolve()),
                  'x509_root_der_sha256':bv.certificate_sha256((fixture/'root.pem').read_bytes()),
                  'mtc':mtc})
record={'status':'PASS','prepared_at':datetime.now(timezone.utc).isoformat(),
        'fixture_set':'chromium-x509-depth-matrix-v1','profiles':profiles,
        'depth':depth,'dependencies':items}
state=repo/'.mt-state/chromium-mtc'; state.mkdir(parents=True,exist_ok=True)
fd,name=tempfile.mkstemp(prefix='.browser-measurements-preparation-',dir=state)
with os.fdopen(fd,'w') as stream: json.dump(record,stream,indent=2,sort_keys=True);stream.write('\n')
os.replace(name,state/'browser-measurements-preparation.json')
print('[CREDENTIALS] All requested combinations: PASS')
PY
 echo '[MEASUREMENTS] Preparation complete.'
}

preflight() {
 python3 -B - "$REPO" "$@" <<'PY'
import argparse, base64, getpass, json, platform, plistlib, subprocess, sys
from pathlib import Path
repo=Path(sys.argv[1])
sys.path.insert(0,str(repo/'campaigns/browser_client/chromium_mtc'))
import browser_validation as bv
import browser_pcap as pcap
import browser_preflight as bp
parser=argparse.ArgumentParser(description='Read-only readiness; capture is started only with --check-capture.')
parser.add_argument('--strict',action='store_true')
parser.add_argument('--check-capture','--capture',dest='check_capture',action='store_true')
parser.add_argument('--profile',choices=bv.PROFILES)
parser.add_argument('--depth',type=int,choices=(2,3,4,5))
parser.add_argument('--mtc-trust-mode',choices=('landmark','standalone'),default='landmark')
args=parser.parse_args(sys.argv[2:])
profiles=(args.profile,) if args.profile else ('ecdsa-p256','ecdsa-p384','mldsa44','mldsa65','mldsa87')
depths=(args.depth,) if args.depth else (2,3,4,5)
setup='bin/browser_client/mt-chromium-setup'
state=repo/'.mt-state/chromium-mtc'
failures=[]
def check(label, instruction, fn):
 try:
  fn()
  print('[PASS] '+label)
 except (ValueError,OSError,KeyError,TypeError,subprocess.SubprocessError) as error:
  failures.append(label)
  print('[FAIL] '+label+': '+str(error)+'\nRequired setup:\n'+setup+' '+instruction)
def require(ok,message):
 if not ok: raise ValueError(message)
def chromium():
 data=bv.read(state/'chromium.json')
 actual=bv.browser_executable(data['executable'])
 pins=dict(line.split('=',1) for line in (repo/'campaigns/browser_client/chromium_mtc/versions/chromium-mtc.env').read_text().splitlines() if line and not line.startswith('#'))
 src=Path(subprocess.check_output(['git','-C',str(Path(actual['executable']).parent),'rev-parse','--show-toplevel'],text=True).strip())
 boring=subprocess.check_output(['git','-C',str(src/'third_party/boringssl/src'),'rev-parse','HEAD'],text=True).strip()
 problem=bp.build_evidence_problem(state,actual,data,pins,boring)
 errors,warnings=bp.chromium_findings(
     actual,data,pins,boring,problem,strict=args.strict)
 for warning in warnings: print('[WARN] '+warning)
 require(not errors,'; '.join(errors))
 require(not (src.parent/'.mtc-source-state/lock').exists(),'Source/build lock present; inspect owner before retrying')
check('Recorded Chromium executable/build','run 10 (after build run chromium if needed)',chromium)
def hostname():
 rows=[line.split('#',1)[0].split() for line in Path('/etc/hosts').read_text().splitlines()]
 addresses={p[0] for p in rows if bv.HOST in [v.lower().rstrip('.') for v in p[1:]]}
 require(addresses=={'127.0.0.1'},'Required exclusive /etc/hosts mapping missing')
 bv.check_hostname()
check('Laboratory hostname','run 50',hostname)
def docker():
 for cmd in (['docker','info'],['docker','image','inspect','mt-tls-mtc:local']):
  subprocess.run(cmd,check=True,stdout=subprocess.DEVNULL,stderr=subprocess.PIPE,timeout=30)
check('Docker daemon and existing test image','doctor (prepare the existing test image explicitly if missing)',docker)
def locks():
 paths=[state/'lock',repo/'.mt-state/chromium-browser-validation.lock']
 require(not any(p.exists() for p in paths),'Lock present: '+', '.join(str(p) for p in paths if p.exists())+'; inspect active owner/stale state; no lock removed')
check('No workflow locks','status',locks)
for profile in profiles:
 def mtc():
  errors=[]
  for manifest in (repo/'artifacts/mtc').glob('*/manifest.json'):
   try:
    meta=bv.read(manifest)
    if meta.get('server_hostname')!=bv.HOST or profile not in meta.get('profiles',[]) or 16 not in meta.get('sizes',[]): continue
    directory=manifest.parent/'batch16/mtc'/profile
    bv.check_saved_hashes(directory,bv.read(directory/'fixture-sha256.json'))
    certificate=directory/(args.mtc_trust_mode+'-0000.pem')
    require(certificate.is_file() and (manifest.parent/'population'/profile/'0.key').is_file(),
            args.mtc_trust_mode+' leaf 0 certificate/key missing')
    credential_meta=bv.read(directory/'manifest.json')
    anchor=(bv.parse_landmark((directory/'trust.bin').read_bytes())
            if args.mtc_trust_mode=='landmark'
            else bv.parse_standalone((directory/'trust.bin').read_bytes()))
    require(anchor['ca_id']==credential_meta.get('ca_id'),'Trust anchor CA ID mismatch')
    if args.mtc_trust_mode=='landmark':
     require(anchor['landmark']['tree_size']==16,'Expected N=16 landmark')
    validations=sorted(manifest.parent.parent.glob(manifest.parent.name+'-validation*/validation.json'))
    require(bool(validations),'Missing prevalidated MTC evidence')
    validated=False
    for validation in validations:
     evidence=bv.read(validation)
     if evidence.get('passed') is not True or evidence.get('server_hostname')!=bv.HOST: continue
     if 'fixture' in evidence and Path(evidence['fixture']).resolve()!=manifest.parent.resolve(): continue
     try: bv.check_saved_hashes(manifest.parent,evidence.get('fixture_hashes'),complete=True)
     except (ValueError,OSError,KeyError,TypeError): continue
     if any(c.get('profile')==profile and c.get('tree_size')==16
            and c.get('mtc_mode')==args.mtc_trust_mode and c.get('success') is True
            and c.get('fixture_hash')==bv.sha(directory/'manifest.json')
            for c in evidence.get('cells',[])):
      validated=True; break
    require(validated,'No matching successful '+args.mtc_trust_mode+' validation cell')
    return
   except (ValueError,OSError,KeyError,TypeError) as error: errors.append(str(error))
  raise ValueError('No intact prevalidated N=16 '+args.mtc_trust_mode+' leaf 0 fixture. '+'; '.join(errors))
 check('MTC fixture '+profile+' ('+args.mtc_trust_mode+')',
       'browser-validation credentials --profile '+profile,mtc)
roots=set()
for profile in profiles:
 for depth in depths:
  def x509():
   candidates=[]
   for fixture in bv.x509_paths(repo):
    manifest=fixture/'manifest.json'
    if not manifest.is_file(): continue
    meta=bv.read(manifest)
    if (meta.get('fixture_set'),meta.get('profile'),meta.get('depth'))!=('chromium-x509-depth-matrix-v1',profile,depth): continue
    require(meta.get('hostname')==bv.HOST,'Wrong hostname: '+str(fixture))
    bv.check_saved_hashes(fixture,meta['files_sha256'])
    require(all((fixture/n).is_file() for n in ('root.pem','server.pem','server.key')),'Missing certificate/key: '+str(fixture))
    chain=fixture/'intermediates.pem'
    count=len(bv.pem_certificates(chain.read_bytes())) if chain.is_file() and chain.stat().st_size else 0
    require(count==depth-2,'Intermediate count mismatch: '+str(fixture))
    digest=bv.certificate_sha256((fixture/'root.pem').read_bytes())
    require(digest==meta['root_der_sha256'],'Root fingerprint mismatch')
    candidates.append(digest)
   require(bool(candidates),'Formal fixture missing')
   require(len(set(candidates))==1,'Ambiguous formal roots; resolve fixture selection explicitly')
   roots.update(candidates)
  check(f'Formal X.509 {profile} D={depth}',
        f'x509-fixtures generate --profile {profile} --fixture-set chromium-x509-depth-matrix-v1 --output NEW_MATRIX_DIRECTORY',x509)
def policy():
 require(bool(roots),'No verified formal roots available')
 documents=[]
 if platform.system()=='Linux':
  documents=[json.loads(p.read_text()) for p in sorted(Path('/etc/chromium/policies/managed').glob('*.json'))]
 elif platform.system()=='Darwin':
  for p in (Path('/Library/Managed Preferences/org.chromium.Chromium.plist'),
            Path('/Library/Managed Preferences')/getpass.getuser()/'org.chromium.Chromium.plist'):
   if p.is_file(): documents.append(plistlib.loads(p.read_bytes()))
 values=[d['CACertificates'] for d in documents if 'CACertificates' in d]
 require(bool(values),'Chromium CACertificates policy unavailable')
 # Do not pretend conflicting policy values form one effective union.
 for value in values:
  require(isinstance(value,list),'Invalid CACertificates policy')
  hashes={bv.hashlib.sha256(base64.b64decode(v,validate=True)).hexdigest() for v in value}
  require(roots<=hashes,'Policy lacks selected formal root fingerprints')
check('Chromium CA policy available for formal roots','trust-setup',policy)
tools=pcap.requirements()
def capture_tools():
 require(tools['interface'] and tools['tshark'] and (tools['dumpcap'] or tools['tcpdump']),
         'Capture backend/tshark unavailable')
check('Capture tools available','doctor (install capture tools through your administrator)',capture_tools)
if args.check_capture:
 try:
  bp.verify_capture_permissions(tools)
  print('[PASS] Capture permissions verified')
 except bp.CaptureCheckError as error:
  failures.append('Capture permissions')
  if error.category=='permission':
   print('[FAIL] Capture permissions insufficient: '+str(error))
  else:
   print('[FAIL] Capture permissions check '+error.category+': '+str(error))
else:
 print('[INFO] Capture permissions not tested (read-only preflight)')
print('Read-only readiness only; cryptographic validation and effective browser policy remain runtime checks.')
if not failures:
 print('PREFLIGHT: PASS ('+('STRICT' if args.strict else 'DEVELOPMENT')+')')
raise SystemExit(1 if failures else 0)
PY
}
campaign() {
 local module=$1
 shift
 if [[ "$module" == browser_measurements && "${1:-}" == run ]]; then
  browser_measurements_prepare "$@"
  set -- "$@" --x509-chromium-ca-policy
 fi
 if [[ "$module" == browser_validation ]]; then
  if [[ "${1:-}" == run ]]; then
   selected_mtc_arguments "$@"
   set -- "$@" "${MTC_ARGUMENTS[@]}"
  elif [[ "${1:-}" == run-prevalidated-mtc ]]; then
   [[ "${2:-}" == mtc-positive ]] || fail 'run-prevalidated-mtc is restricted to mtc-positive.'
   shift
   set -- run "$@"
  fi
 fi
 # Functional validation and PCAP entrypoints cannot fall back to generating
 # credentials. Browser measurements have already completed the explicit
 # preparation workflow above; their measurement engine remains fail-closed.
 python3 -B - "$REPO" "$module" "$@" <<'PY'
import importlib, sys
from pathlib import Path
sys.path.insert(0,str(Path(sys.argv[1])/'campaigns/browser_client/chromium_mtc'))
import browser_validation as bv
def no_generation(*args, **kwargs):
    raise ValueError('Missing valid fixtures. Required setup: bin/browser_client/mt-chromium-setup browser-validation credentials [--profile PROFILE --depth DEPTH]')
if sys.argv[2] != 'browser_measurements':
    bv.generate_mtc=bv.generate_x509=no_generation
module=importlib.import_module(sys.argv[2])
sys.argv=[module.__file__,*sys.argv[3:]]
raise SystemExit(module.main())
PY
}
