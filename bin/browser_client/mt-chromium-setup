#!/usr/bin/env bash
# Existing-build interoperability; source preparation and compilation are explicit namespaces.
set -euo pipefail
REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
MENU_CALL_DIR=$PWD
cd "$REPO"
STATE="$REPO/.mt-state/chromium-mtc"
STEPS=(00.preflight 10.detect-existing-chromium 20.select-or-generate-mtc-fixture 30.validate-mtc-fixture 40.export-mtc-anchor 50.configure-hostname 60.start-mtc-positive-server)
fail() { echo "ERROR: $*" >&2; exit 1; }
load() { [[ -f "$STATE/paths.env" ]] || fail 'Run init first.'; source "$STATE/paths.env"; }
init() {
 mkdir -p "$STATE"
 if [[ -e "$STATE/paths.env" ]]; then
  load
  if [[ -n "${FIXTURE:-}" ]]; then
   check_fixture || fail 'Invalid existing fixture configuration preserved. Run step 20 with --fixture PATH or --generate explicitly.'
  else
   [[ -z "${VALIDATION:-}" && -z "${ANCHOR:-}" ]] || fail 'Incomplete fixture selection; run step 20 --fixture PATH or --generate.'
  fi
  echo 'Existing configuration preserved; step 20 selects or explicitly generates fixtures.'; return
 fi
 local chromium_src="$HOME/Desktop/chromium-mtc/src"
 if [[ "$(uname -s)" == Linux ]]; then chromium_src="$HOME/chromium-mtc-rebuild/src"; fi
 (set -o noclobber; printf 'CHROMIUM_SRC=%q\nFIXTURE=%q\nVALIDATION=%q\nANCHOR=%q\nHOSTNAME_LAB=%q\nCONTAINER=%q\n' \
 "$chromium_src" "" "" "" server.mtc.example.com mtc-browser-server > "$STATE/paths.env")
}
step_name() {
 local s
 for s in "${STEPS[@]}"; do if [[ "$1" == "$s" || "$1" == "${s%%.*}" ]]; then echo "$s"; return; fi; done
 fail "Unknown step: $1"
}
check_fixture() {
 [[ -n "${FIXTURE:-}" && -n "${VALIDATION:-}" && -n "${ANCHOR:-}" ]] || fail 'No fixture selected. Run step 20 --fixture PATH or --generate.'
 python3 - "$FIXTURE" "$VALIDATION" "$HOSTNAME_LAB" "$STATE" <<'PY'
import hashlib,json,sys
from pathlib import Path
root,validation,hostname,state=Path(sys.argv[1]),Path(sys.argv[2]),sys.argv[3],Path(sys.argv[4])
d=json.loads(validation.read_text())
assert d['passed'] and d['server_hostname']==hostname, 'Validation/hostname mismatch'
assert any(c['profile']=='ecdsa-p256' and c['tree_size']==16 and c['mtc_mode']=='landmark' and c['success'] for c in d['cells'])
actual={str(p.relative_to(root)):hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(root.rglob('*')) if p.is_file()}
assert actual==d['fixture_hashes'], 'Fixture differs from validated evidence'
assert json.loads((root/'manifest.json').read_text())['server_hostname']==hostname
image=d['provenance']['image_id']
assert image.startswith('sha256:')
(state/'image-id').write_text(image+'\n')
print('PASS existing fixture hashes, hostname and ECDSA-P256/N=16 landmark evidence')
PY
}
select_fixture() (
 local temporary step
 case "${1:-}" in
  --fixture)
   [[ "$#" == 2 ]] || fail 'Usage: run 20 --fixture PATH'
   FIXTURE=$(CDPATH= cd -- "$2" && pwd) || fail "Fixture directory missing: $2";;
  --generate)
   [[ "$#" == 1 ]] || fail 'Usage: run 20 --generate'
   FIXTURE="$REPO/artifacts/mtc/browser-${HOSTNAME_LAB//./-}-ecdsa-p256-n16-$(date -u +%Y%m%dT%H%M%SZ)-$$";;
  '')
   [[ "$#" == 0 && -n "$FIXTURE" ]] || fail 'Choose explicitly: run 20 --fixture PATH or run 20 --generate'
   check_fixture; exit "$?";;
  *) fail 'Usage: run 20 [--fixture PATH|--generate]';;
 esac
 [[ ! -f "$STATE/container-id" ]] || fail 'Cleanup the workflow-owned server before changing fixture selection.'
 VALIDATION="$FIXTURE-validation/validation.json"
 ANCHOR="$FIXTURE-chromium.json"
 if [[ "$1" == --generate ]]; then
  [[ ! -e "$FIXTURE" && ! -e "${VALIDATION%/validation.json}" && ! -e "$ANCHOR" ]] || fail 'Generation output exists; preserved.'
  python3 "$REPO/campaigns/browser_client/chromium_mtc/fixtures.py" generate \
   --output "$FIXTURE" --server-hostname "$HOSTNAME_LAB" --execute || exit "$?"
  python3 "$REPO/campaigns/browser_client/chromium_mtc/fixtures.py" validate \
   --fixtures "$FIXTURE" --output "${VALIDATION%/validation.json}" --server-hostname "$HOSTNAME_LAB" --execute || exit "$?"
 fi
 check_fixture || exit "$?"
 temporary=$(mktemp "$STATE/paths.env.XXXXXX")
 trap 'rm -f "$temporary"' EXIT
 printf 'CHROMIUM_SRC=%q\nFIXTURE=%q\nVALIDATION=%q\nANCHOR=%q\nHOSTNAME_LAB=%q\nCONTAINER=%q\n' \
  "$CHROMIUM_SRC" "$FIXTURE" "$VALIDATION" "$ANCHOR" "$HOSTNAME_LAB" "$CONTAINER" > "$temporary"
 # Invalidate downstream evidence before publishing the new selection.
 for step in "${STEPS[@]:2}"; do rm -f "$STATE/$step.done"; done
 mv -- "$temporary" "$STATE/paths.env"
 echo "Selected fixture: $FIXTURE"
)
owned() { [[ "$(docker inspect -f '{{index .Config.Labels "mtc.workflow"}}' "$CONTAINER")" == "$STATE" ]]; }
start_server() {
 local prerequisite
 for prerequisite in "${STEPS[@]:0:6}"; do
  [[ -f "$STATE/$prerequisite.done" ]] || fail "Run $prerequisite first."
 done
 check_fixture
 local image result id
 image=$(cat "$STATE/image-id")
 docker image inspect "$image" >/dev/null
 if docker container inspect "$CONTAINER" >/dev/null 2>&1; then
  owned || fail 'Container name belongs to another workflow; preserved.'
  [[ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER")" == true ]] || fail 'Owned container stopped; inspect logs and cleanup before restarting.'
  echo "Already running: $CONTAINER"; return
 fi
 result=$(mktemp -d "$REPO/artifacts/results/chromium-mtc-validation-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")
 printf '%s\n' "$result" > "$STATE/result-dir"
 id=$(docker run -d --pull never --name "$CONTAINER" --label "mtc.workflow=$STATE" \
  -p 127.0.0.1:4433:4433 -v "$FIXTURE:/fixtures:ro" -v "$result:/results" \
  --entrypoint /bin/sh "$image" -c 'exec /opt/mtc/openssl.sh s_server -accept 4433 -tls1_3 -groups X25519 -ciphersuites TLS_AES_256_GCM_SHA384 -num_tickets 0 -www -state -msg -cert /fixtures/batch16/mtc/ecdsa-p256/landmark-0000.pem -key /fixtures/population/ecdsa-p256/0.key -mtc_id 32473.101.1.1.1 > /results/server.log 2>&1')
 printf '%s\n' "$id" > "$STATE/container-id"
 # No probe handshake: wait only for OpenSSL's listening marker.
 for ((n=0;n<20;n++)); do
  [[ "$(docker inspect -f '{{.State.Running}}' "$id")" == true ]] || fail "Server exited; inspect $result/server.log"
  if grep -q '^ACCEPT' "$result/server.log" 2>/dev/null; then echo "RUNNING $CONTAINER; log: $result/server.log"; return; fi
  sleep 0.25
 done
 fail "Readiness not confirmed; container preserved. Inspect $result/server.log"
}
run_step() {
 local step=$1
 shift
 [[ "$step" == 20.* || "$#" == 0 ]] || fail 'Only step 20 accepts --fixture PATH or --generate.'
 case "$step" in
  00.*) for cmd in python3 git docker; do command -v "$cmd" >/dev/null || fail "Missing $cmd"; done; docker info >/dev/null;;
  10.*) python3 - "$CHROMIUM_SRC" "$STATE" <<'PY'
import hashlib,json,os,platform,re,subprocess,sys
from pathlib import Path
src,state=map(Path,sys.argv[1:])
system=platform.system()
assert system in ('Darwin','Linux'), 'Existing Chromium detection supports macOS and Linux'
binary='Chromium.app/Contents/MacOS/Chromium' if system=='Darwin' else 'chrome'
outputs=('mtc','mtc-release') if system=='Darwin' else ('mtc-release','mtc')
output=next((src/'out'/name for name in outputs if (src/'out'/name/binary).is_file() and os.access(src/'out'/name/binary,os.X_OK)),None)
assert output is not None, 'Existing Chromium missing under '+str(src/'out')+'; no build will be attempted'
exe=output/binary
args=(output/'args.gn').read_text()
def commit(p):return subprocess.check_output(['git','-C',str(p),'rev-parse','HEAD'],text=True).strip()
def flag(k):
 m=re.search(r'^\s*'+k+r'\s*=\s*(true|false)\s*(?:#.*)?$',args,re.M)
 if m:return m.group(1)=='true'
 ninja=output/'obj/base/base.ninja'
 if k=='is_component_build' and ninja.is_file():return '-DCOMPONENT_BUILD' in ninja.read_text().splitlines()[0]
 return 'not explicit in args.gn'
h=hashlib.sha256()
with exe.open('rb') as f:
 for b in iter(lambda:f.read(1024*1024),b''):h.update(b)
d=dict(executable=str(exe),chromium_commit=commit(src),boringssl_commit=commit(src/'third_party/boringssl/src'),is_component_build=flag('is_component_build'),is_debug=flag('is_debug'),sha256=h.hexdigest())
(state/'chromium.json').write_text(json.dumps(d,indent=2)+'\n');print(json.dumps(d,indent=2))
PY
 ;;
  20.*) select_fixture "$@"; load;;
  30.*) check_fixture;;
  40.*) check_fixture
   python3 - "$REPO" "$FIXTURE" "$ANCHOR" <<'PY'
import hashlib,json,sys
from pathlib import Path
repo,fixture,out=map(Path,sys.argv[1:]);sys.path.insert(0,str(repo/'campaigns/browser_client/chromium_mtc'))
from export_chromium_anchor import parse_landmark
trust=fixture/'batch16/mtc/ecdsa-p256/trust.bin';raw=trust.read_bytes();expected=parse_landmark(raw)
assert expected['landmark']['requested_trust_anchor_id']=='32473.101.2.1.1'
assert expected['landmark']['selected_trust_anchor_id']=='32473.101.1.1.1'
if out.exists():
 data=json.loads(out.read_text());assert all(data.get(k)==v for k,v in expected.items()), 'Existing anchor mismatch'
 assert data['source']['trust_file_sha256']==hashlib.sha256(raw).hexdigest()
else:
 import subprocess
 subprocess.run([sys.executable,str(repo/'campaigns/browser_client/chromium_mtc/export_chromium_anchor.py'),'--trust',str(trust),'--output',str(out)],check=True)
print('PASS anchor:',out)
PY
 ;;
  50.*) python3 - "$HOSTNAME_LAB" <<'PY'
import socket,subprocess,sys
from pathlib import Path
host=sys.argv[1];hosts=Path('/etc/hosts')
def read_entries():
 text=hosts.read_text()
 entries=[(line,line.split('#')[0].split()) for line in text.splitlines()]
 matches=[(line,p) for line,p in entries if host.lower() in [a.lower().rstrip('.') for a in p[1:]]]
 conflicts=[line for line,p in matches if p[0]!='127.0.0.1']
 if conflicts:
  sys.exit('ERROR: Conflicting /etc/hosts entries:\n'+'\n'.join(conflicts)+
           '\n'+host+' must resolve exclusively to 127.0.0.1. Resolve conflicting entries manually.')
 return text,matches
text,matches=read_entries()
if not matches:
 entry='127.0.0.1 '+host
 print('Adding to /etc/hosts using sudo tee -a: '+entry,flush=True)
 subprocess.run(['sudo','tee','-a','/etc/hosts'],
                input=('\n' if text and not text.endswith('\n') else '')+entry+'\n',
                text=True,check=True,stdout=subprocess.DEVNULL)
_,matches=read_entries()
if not matches:
 sys.exit('ERROR: Required loopback mapping missing from /etc/hosts.')
try:
 addresses={a[4][0] for a in socket.getaddrinfo(host,4433)}
except OSError as error:
 sys.exit('ERROR: Cannot resolve '+host+': '+str(error))
if addresses!={'127.0.0.1'}:
 sys.exit('ERROR: '+host+' must resolve exclusively to 127.0.0.1; resolved: '+str(sorted(addresses)))
print('PASS /etc/hosts mapping and resolution exclusively to 127.0.0.1')
PY
 ;;
  60.*) start_server;;
 esac
 date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE/$step.done"
}
apparmor_required() {
 [[ "$(uname -s)" == Linux ]] &&
  [[ -f /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]] &&
  [[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null)" == 1 ]]
}
sandbox_action() {
 if ! apparmor_required; then
  echo 'AppArmor user-namespace setup is not required.'; return
 fi
 [[ -f "$STATE/paths.env" ]] || { echo 'Initialize/configure CHROMIUM_SRC first: mt-chromium-setup init' >&2; return 1; }
 load
 python3 -B "$REPO/campaigns/browser_client/chromium_mtc/apparmor_setup.py" "$1" "$CHROMIUM_SRC/out/mtc-release/chrome"
}
doctor() {
 local os tool
 os=$(uname -s)
 printf 'OS: %s\nArchitecture: %s\n' "$os" "$(uname -m)"
 case "$os" in
  Darwin)
   if command -v sw_vers >/dev/null; then sw_vers; else echo 'MISSING sw_vers'; fi
   if command -v xcode-select >/dev/null; then xcode-select -p || echo 'MISSING active developer directory'; else echo 'MISSING xcode-select'; fi
   tools=(clang python3 git docker);;
  Linux)
   if [[ -f /etc/os-release ]]; then cat /etc/os-release; else echo 'MISSING /etc/os-release'; fi
   tools=(git python3 curl bash tar xz unzip clang ninja docker);;
  *) tools=(git python3 docker);;
 esac
 # Presence checks only: do not invoke wrappers that may bootstrap tools.
 for tool in "${tools[@]}" gclient gn autoninja; do
  if command -v "$tool" >/dev/null; then printf 'PRESENT %s: %s\n' "$tool" "$(command -v "$tool")"; else echo "MISSING $tool"; fi
 done
 if [[ "$os" == Linux ]]; then sandbox_action status || echo 'AppArmor sandbox preflight needs attention; see diagnostic above.'; fi
 echo 'Free disk space (repository filesystem):'
 df -h "$REPO" || echo 'Disk space unavailable'
 return 0
}
