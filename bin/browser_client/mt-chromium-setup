 [[ -t 0 ]] || fail 'menu requires an interactive TTY on stdin.'
 trap 'printf "\n"; exit 130' INT
 local selection index
 local labels actions
 while true; do
  labels=('Doctor / requirements' 'Initialize / configuration' 'Installation status' 'Source reconstruction' 'Build preparation' 'Build Chromium' 'Existing Chromium / MTC setup')
  actions=(doctor init status source preparation build setup)
  if apparmor_required; then labels+=('Sandbox / AppArmor setup'); actions+=(sandbox); fi
  labels+=('X.509 trust management' 'Chromium CA policy' 'Prepare browser credentials' 'Cleanup / reset')
  actions+=(trust ca-policy credentials cleanup)
  printf 'Chromium / MTC — Setup / installation\n'
  for ((index=0; index<${#labels[@]}; index++)); do printf '%d. %s\n' "$((index+1))" "${labels[index]}"; done
  echo '0. Exit'
  read -r -p 'Select an option: ' selection || exit 0
  [[ "$selection" == 0 ]] && exit 0
  [[ "$selection" =~ ^[1-9][0-9]*$ ]] && (( selection <= ${#actions[@]} )) || { echo 'Invalid option.'; continue; }
  case "${actions[selection-1]}" in
   doctor) menu_invoke readonly doctor;; init) menu_invoke confirm init;;
   status) menu_invoke readonly status; menu_invoke readonly reconstruct-source status; menu_invoke readonly prepare-build status; menu_invoke readonly build status;;
   source) menu_submenu source;; preparation) menu_submenu preparation;; build) menu_submenu build;; setup) menu_submenu setup;;
   sandbox) menu_invoke confirm sandbox-setup;; trust) menu_submenu trust;;
   ca-policy) menu_ca_policy;; credentials) menu_browser_credentials;; cleanup) menu_invoke confirm cleanup;;
  esac
 done
)

ensure_formal_x509_dependencies() {
 local profiles_text=$1 depth=2 image=mt-tls-mtc:local argument previous=''
 shift
 for argument in "$@"; do
  [[ "$previous" != --depth ]] || depth=$argument
  [[ "$previous" != --image ]] || image=$argument
  case "$argument" in
   --depth=*) depth=${argument#*=};;
   --image=*) image=${argument#*=};;
  esac
  previous=$argument
 done
 local profiles=()
 read -r -a profiles <<< "$profiles_text"
 python3 -B "$REPO/campaigns/browser_client/chromium_mtc/generate_x509_depth_matrix.py" \
  ensure --fixture-set chromium-x509-depth-matrix-v1 \
  --output "$REPO/artifacts/x509/chromium-x509-depth-matrix-v1" \
  --profiles "${profiles[@]}" --depth "$depth" --image "$image"
}

browser_validation_credentials_profiles() {
 local profiles_text=$1 profile trust_mode result index=0 total_start=$SECONDS docker_total counter_file image=mt-tls-mtc:local previous=''
 shift
 local profiles=() passed=()
 local argument
 for argument in "$@"; do
  [[ "$previous" != --image ]] || image=$argument
  case "$argument" in
   --image=*) image=${argument#*=};;
   --mtc-trust-mode|--mtc-trust-mode=*)
    fail '--all-profiles prepares both landmark and standalone; do not select one MTC trust mode.';;
  esac
  previous=$argument
 done
 read -r -a profiles <<< "$profiles_text"
 ensure_formal_x509_dependencies "$profiles_text" "$@" ||
  fail "Formal X509 dependency preparation failed for profiles=$profiles_text"
 python3 -B "$REPO/campaigns/browser_client/chromium_mtc/browser_validation.py" \
  prepare-mtc-dependencies --profiles "${profiles[@]}" --image "$image" ||
  fail "MTC dependency preparation failed for profiles=$profiles_text"
 counter_file=$(mktemp "${TMPDIR:-/tmp}/chromium-credential-docker-count.XXXXXX")
 for profile in "${profiles[@]}"; do
  for trust_mode in landmark standalone; do
   index=$((index+1))
   if python3 -B "$REPO/campaigns/browser_client/chromium_mtc/browser_validation.py" \
     credentials --profile "$profile" --mtc-trust-mode "$trust_mode" "$@" \
     --x509-fixture-set chromium-x509-depth-matrix-v1 \
     --x509-chromium-ca-policy --optimized-all-profiles \
     --precheck-index "$index" --precheck-total "$((${#profiles[@]}*2))" \
     --docker-count-file "$counter_file"; then
    passed+=("$profile $trust_mode")
   else
    result=$?
    rm -f "$counter_file"
    echo "ERROR: Chromium browser credentials failed for profile=$profile trust_mode=$trust_mode" >&2
    return "$result"
   fi
  done
 done
 printf '\nChromium browser credentials\n\n'
 for profile in "${passed[@]}"; do printf '%-26s PASS\n' "$profile"; done
 docker_total=$(awk '{total += $1} END {print total + 0}' "$counter_file")
 rm -f "$counter_file"
 printf '\nElapsed: %ss\nDocker run invocations: %s\n' "$((SECONDS-total_start))" "$docker_total"
 printf '\nOverall: PASS\n'
}

browser_validation_credentials_all_profiles() {
 local profiles_text
 profiles_text=$(python3 -B - "$REPO" <<'PY'
import sys
from pathlib import Path

module_dir = Path(sys.argv[1]) / 'campaigns/browser_client/chromium_mtc'
sys.path.insert(0, str(module_dir))
from browser_measurements import CAMPAIGN_PROFILES

print(' '.join(CAMPAIGN_PROFILES))
PY
 ) || fail 'Could not load browser-measurements campaign profiles.'
 browser_validation_credentials_profiles "$profiles_text" "$@"
}

case "${1:-help}" in
 help|--help|-h) cat <<'HELP'
Usage: mt-chromium-setup menu|doctor|init|status|plan|show STEP|run STEP|resume|cleanup
  reconstruct-plan|reconstruct-source plan|status|run STEP [--dest PATH]
  prepare-build plan|status|run STEP|install-deps [--dest PATH]
  build plan|status|run chromium [--dest PATH]
  sandbox-setup|sandbox-status
  browser-validation credentials [--profile PROFILE | --all-profiles] [OPTIONS]
  browser-validation cleanup|trust-status|trust-x509|untrust-x509 [OPTIONS]
  trust-setup [--root PATH]
  x509-fixtures plan|generate --profile PROFILE --fixture-set NAME --output PATH
  x509-fixtures generate-matrix --fixture-set chromium-x509-depth-matrix-v1 --output NEW_PATH
  ca-policy --matrix PATH --output PATH
  ca-policy-status|ca-policy-generate|ca-policy-install|ca-policy-verify|ca-policy-prepare
Step 20: run 20 --fixture PATH or run 20 --generate (explicit selection/generation).
Trust operations require --root PATH. No automatic fixture selection.
HELP
 ;;
 menu) menu;;
 browser-validation)
  case "${2:-}" in credentials|cleanup|trust-status|trust-x509|untrust-x509|--help|-h) ;;
   *) fail 'Use mt-chromium-tests browser-validation for test actions.';; esac
  shift
  if [[ "${1:-}" == credentials ]]; then
   all_profiles=false
   profile_requested=false
   measurement_profile=''
   formal_x509_requested=false
   selected_profile=ecdsa-p256
   credentials_arguments=()
   previous=''
   for argument in "${@:2}"; do
    if [[ "$previous" == --measurement-profile ]]; then
     measurement_profile=$argument
     previous=$argument
     continue
    fi
    [[ "$previous" != --profile ]] || selected_profile=$argument
    [[ "$previous" != --x509-fixture-set ]] ||
     [[ "$argument" != chromium-x509-depth-matrix-v1 ]] || formal_x509_requested=true
    case "$argument" in
     --all-profiles) all_profiles=true;;
     --measurement-profile) previous=$argument; continue;;
     --measurement-profile=*) measurement_profile=${argument#*=};;
     --profile) profile_requested=true; credentials_arguments+=("$argument");;
     --profile=*) profile_requested=true; selected_profile=${argument#*=}; credentials_arguments+=("$argument");;
     --x509-fixture-set=chromium-x509-depth-matrix-v1) formal_x509_requested=true; credentials_arguments+=("$argument");;
     *) credentials_arguments+=("$argument");;
    esac
    previous=$argument
   done
   if [[ -n "$measurement_profile" ]]; then
    [[ "$all_profiles" == false && "$profile_requested" == false ]] ||
     fail '--measurement-profile is mutually exclusive with --profile/--all-profiles.'
    case "$measurement_profile" in
     ecdsa-p256|ecdsa-p384|mldsa44|mldsa65|mldsa87) ;;
     *) fail "Unsupported browser-measurements profile: $measurement_profile";;
    esac
    browser_validation_credentials_profiles "$measurement_profile" "${credentials_arguments[@]}"
    exit $?
   fi
   if [[ "$all_profiles" == true ]]; then
    [[ "$profile_requested" == false ]] || fail '--profile and --all-profiles are mutually exclusive.'
    browser_validation_credentials_all_profiles "${credentials_arguments[@]}"
    exit $?
   fi
   if [[ "$formal_x509_requested" == true ]]; then
    ensure_formal_x509_dependencies "$selected_profile" "${credentials_arguments[@]}" ||
     fail "Formal X509 dependency preparation failed for profile=$selected_profile"
   fi
   selected_mtc_arguments "$@"
   set -- "$@" "${MTC_ARGUMENTS[@]}"
  fi
  exec python3 -B "$REPO/campaigns/browser_client/chromium_mtc/browser_validation.py" "$@";;
 trust-setup) shift; trust_setup "$@";;
 x509-fixtures) shift; exec python3 -B "$REPO/campaigns/browser_client/chromium_mtc/generate_x509_depth_matrix.py" "$@";;
 ca-policy) shift; exec python3 -B "$REPO/campaigns/browser_client/chromium_mtc/generate_chromium_ca_policy.py" "$@";;
 ca-policy-status) ca_policy_action status;;
 ca-policy-generate) ca_policy_action generate;;
 ca-policy-install) ca_policy_action install;;
 ca-policy-verify) ca_policy_action verify;;
 ca-policy-prepare) ca_policy_prepare;;
 sandbox-setup) sandbox_action setup;;
 sandbox-status) sandbox_action status;;
 doctor) doctor;;
 reconstruct-plan) reconstruct_plan;;
 reconstruct-source) shift; reconstruct_source "$@";;
 prepare-build|build) build_phase "$@";;
 init) init;;
 plan) printf '%s\n' "${STEPS[@]}"; echo 'Existing Chromium/validated fixture only. No build, pull or automatic generation.';;
 show) step=$(step_name "${2:?Step required}"); echo "$step"; sed -n '/^run_step()/,/^case "${1:-help}"/p' "$0"; [[ "$step" != 60.* ]] || sed -n '/^start_server()/,/^run_step()/p' "$0";;
 status) if [[ ! -f "$STATE/paths.env" ]]; then echo 'NOT INITIALIZED'; exit; fi; load
  for step in "${STEPS[@]}"; do if [[ -f "$STATE/$step.done" ]]; then echo "RECORDED $step"; else echo "PENDING $step"; fi; done
  [[ ! -f "$STATE/result-dir" ]] || cat "$STATE/result-dir"
  docker container inspect -f '{{.Name}} running={{.State.Running}} image={{.Image}}' "$CONTAINER" 2>/dev/null || echo 'Container unavailable (absent or Docker inaccessible)';;
 run|resume|cleanup) load; mkdir "$STATE/lock" 2>/dev/null || fail 'Workflow locked; inspect before retrying.'; trap 'rmdir "$STATE/lock"' EXIT
  case "$1" in
   run) run_step "$(step_name "${2:?Step required}")" "${@:3}";;
   resume) for step in "${STEPS[@]}"; do if [[ -f "$STATE/$step.done" ]]; then echo "SKIP $step"; else run_step "$step"; fi; done;;
   cleanup) if docker container inspect "$CONTAINER" >/dev/null 2>&1; then owned || fail 'Foreign container preserved'; docker rm -f "$CONTAINER"; fi
    rm -f "$STATE/60.start-mtc-positive-server.done" "$STATE/container-id"
    echo 'Artifacts and existing hosts entry preserved. No browser profiles are created by this workflow.';;
  esac;;
 *) fail 'Unknown command; use help';;
esac
