  "definitions": {
    "process_wall_ms": "host monotonic time around one Docker client process; includes process/container overhead",
    "tcp_connect_wall_ms_native": "native client connection entry through successful TCP connect return",
    "handshake_wall_ms": "native TLS handshake start through handshake completion",
    "x509_verification_ms": "client wall time in the native peer-certificate verification path; inclusive of the custom MTC callback for MTC credentials",
    "credential_verification_total_ms": "compatibility-equivalent value for x509_verification_ms; the inclusive ssl_verify_internal interval for X.509 or MTC credentials",
    "client_authentication_verification_total_ms": "per-connection sum accumulated directly in C from two local monotonic intervals: ssl_verify_internal and tls_process_cert_verify; it excludes the TLS state transition and network wait between them",
    "mtc_credential_auth_ms": "complete MTC credential callback interval; unavailable for X.509",
    "merkle_proof_ms": "client wall time to reconstruct the MTC leaf and evaluate its Merkle inclusion proof; unavailable for X.509",
    "landmark_validation_ms": "client wall time to validate the reconstructed root against trusted landmark/subtree state; available only for MTC landmark credentials",
    "standalone_validation_ms": "client wall time to validate the standalone MTC root signatures; available only for MTC standalone credentials",
    "certificate_verify_ms": "client wall time to process and cryptographically verify the peer TLS CertificateVerify message",
    "credential_verification_other_ms": "credential_verification_total_ms minus applicable Merkle, Landmark and Standalone suboperations; missing suboperations count as zero only for this derived value",
    "connection_establishment_wall_ms_native": "native connection entry through TLS handshake completion",
    "tls_bytes_total": "OpenSSL TLS handshake bytes read plus written; excludes IP/TCP headers",
    "tcp_handshake_ms": "PCAP time from initial client TCP SYN to the corresponding client ACK completing the three-way handshake",
    "tcp_syn_to_clienthello_ms": "PCAP time from initial client TCP SYN to the first client ClientHello",
    "tls_clienthello_to_client_finished_ms": "PCAP time from the first client ClientHello to the client Finished",
    "tcp_syn_to_first_application_request_ms": "PCAP time from initial client TCP SYN to the first decrypted client HTTP request",
    "tls_handshake_bytes": "complete logical TLS records in the handshake interval, including each five-byte record header once",
    "tls_client_handshake_wire_bytes": "sum of frame lengths for client TCP-payload frames from ClientHello through client Finished, inclusive",
    "tls_server_handshake_wire_bytes": "sum of frame lengths for server TCP-payload frames over the same TLS interval",
    "tls_handshake_wire_bytes": "client plus server handshake wire bytes; pure TCP ACKs are excluded",
    "tcp_handshake_wire_bytes": "sum of frame lengths for the SYN, corresponding SYN/ACK and first ACK completing the selected TCP stream handshake",
    "connection_handshake_wire_bytes": "sum of unique frame lengths across the TCP three-way handshake and TLS handshake interval; an ACK carrying TLS data is counted once",
    "tls_handshake_packets": "client plus server TCP-payload frames in the TLS handshake interval",
    "tls_client_certificate_bytes": "complete client Certificate handshake message, including its four-byte handshake header; zero only when not requested; applies to X.509 and project MTC credentials carried in Certificate",
    "tls_server_certificate_bytes": "complete server Certificate handshake message, including its four-byte handshake header; applies to X.509 and project MTC credentials carried in Certificate",
    "tls_certificate_verify_bytes": "complete CertificateVerify handshake message, including its four-byte handshake header",
    "tls_certificate_verify_signature_bytes": "signature vector contents after validating the TLS 1.3 algorithm and uint16 length fields",
    "mtc_proof_bytes": "complete MTCProof carried in the MTC certificate signatureValue; unavailable for X.509",
    "mtc_merkle_path_bytes": "MTCProof inclusion-path vector contents; excludes its uint16 length",
    "sct_bytes": "encoded SCT-list extension value; zero means a parsed certificate with no SCT extension, blank means unavailable",
    "tls_authentication_bytes": "Certificate plus CertificateVerify handshake messages, without TLS record overhead; Finished and CertificateRequest are excluded",
    "tcp_retransmission_packets": "retransmitted frames retained in wire-byte and packet counts but deduplicated from logical TLS bytes"
  },
