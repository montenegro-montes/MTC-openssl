+TEST_F(CertVerifyProcBuiltinTest, StandaloneMtcPlants06Verification) {
+  constexpr uint8_t kMtcCaId[] = {0x09, 0x08, 0x07};
+  constexpr uint16_t kLogNumber = 1;
+  net::MtcLogBuilder mtc_log(
+      kMtcCaId, kLogNumber, net::MtcLogBuilder::Format::kPlants06);
+  std::unique_ptr<net::CertBuilder> mtc_leaf =
+      std::move(net::CertBuilder::CreateSimpleChain(1u)[0]);
+  uint64_t leaf_index = mtc_log.AddEntry(*mtc_leaf);
+  const uint64_t serial =
+      (static_cast<uint64_t>(kLogNumber) << 48) + leaf_index;
+
+  InitializeVerifyProc(CreateParams(/*additional_trust_anchors=*/{}));
+
+  MtcLogBuilder::Cosigner ca_cosigner = {
+      base::ToVector(kMtcCaId), crypto::keypair::PrivateKey::GenerateEcP256(),
+      bssl::SignatureAlgorithm::kEcdsaSha256};
+  auto leaf_der =
+      mtc_log.CreateStandaloneCertificate(leaf_index, {&ca_cosigner});
+  ASSERT_TRUE(leaf_der);
+  scoped_refptr<X509Certificate> leaf =
+      X509Certificate::CreateFromBytes(*leaf_der);
+  ASSERT_TRUE(leaf);
+
+  SetMockIsKnownRoot(false);
+  SetMockIsKnownMtcAnchor(false);
+
+  bssl::TrustStoreInMemory trust_store;
+  auto mtc_anchor = std::make_shared<const bssl::MTCAnchor>(
+      bssl::MTCAnchor::kPlants06, ca_cosigner.id,
+      ca_cosigner.signature_algorithm,
+      x509_util::CreateCryptoBuffer(ca_cosigner.key.ToSubjectPublicKeyInfo()),
+      serial, serial, std::vector<bssl::LogTrustedSubtrees>());
+  ASSERT_TRUE(mtc_anchor->IsValid());
+  ASSERT_TRUE(trust_store.AddMTCTrustAnchor(mtc_anchor));
+  AddTrustStore(&trust_store);
+
+  CertVerifyResult verify_result;
+  NetLogSource verify_net_log_source;
+  TestCompletionCallback callback;
+  Verify(leaf.get(), "www.example.com", /*flags=*/0, &verify_result,
+         &verify_net_log_source, callback.callback());
+
+  int error = callback.WaitForResult();
+  EXPECT_THAT(error, IsOk());
+  ASSERT_TRUE(verify_result.mtc_verification_info.has_value());
+  EXPECT_EQ(bssl::MTCVerificationMode::kStandalone,
+            verify_result.mtc_verification_info->mode);
+
+  // A signature made by a different key with the CA's identity is rejected.
+  MtcLogBuilder::Cosigner wrong_key_cosigner = {
+      base::ToVector(kMtcCaId), crypto::keypair::PrivateKey::GenerateEcP256(),
+      bssl::SignatureAlgorithm::kEcdsaSha256};
+  auto invalid_signature_der =
+      mtc_log.CreateStandaloneCertificate(leaf_index, {&wrong_key_cosigner});
+  ASSERT_TRUE(invalid_signature_der);
+  scoped_refptr<X509Certificate> invalid_signature_leaf =
+      X509Certificate::CreateFromBytes(*invalid_signature_der);
+  ASSERT_TRUE(invalid_signature_leaf);
+  ASSERT_TRUE(invalid_signature_leaf->VerifyNameMatch("www.example.com"));
+  ASSERT_EQ(wrong_key_cosigner.id, ca_cosigner.id);
+  ASSERT_TRUE(mtc_anchor->IsSerialInRange(serial));
+  {
+    CertVerifyResult invalid_result;
+    NetLogSource invalid_net_log_source;
+    TestCompletionCallback invalid_callback;
+    Verify(invalid_signature_leaf.get(), "www.example.com", /*flags=*/0,
+           &invalid_result, &invalid_net_log_source,
+           invalid_callback.callback());
+    EXPECT_THAT(invalid_callback.WaitForResult(),
+                IsError(ERR_CERT_AUTHORITY_INVALID));
+    EXPECT_FALSE(invalid_result.mtc_verification_info.has_value());
+  }
+
+  // A Plants-06 anchor whose allowed serial range excludes the certificate is
+  // incompatible and must not authenticate it.
+  trust_store.Clear();
+  auto incompatible_anchor = std::make_shared<const bssl::MTCAnchor>(
+      bssl::MTCAnchor::kPlants06, ca_cosigner.id,
+      ca_cosigner.signature_algorithm,
+      x509_util::CreateCryptoBuffer(ca_cosigner.key.ToSubjectPublicKeyInfo()),
+      serial + 1, serial + 1, std::vector<bssl::LogTrustedSubtrees>());
+  ASSERT_TRUE(incompatible_anchor->IsValid());
+  ASSERT_FALSE(incompatible_anchor->IsSerialInRange(serial));
+  ASSERT_TRUE(leaf->VerifyNameMatch("www.example.com"));
+  ASSERT_TRUE(trust_store.AddMTCTrustAnchor(incompatible_anchor));
+  {
+    CertVerifyResult incompatible_result;
+    NetLogSource incompatible_net_log_source;
+    TestCompletionCallback incompatible_callback;
+    Verify(leaf.get(), "www.example.com", /*flags=*/0, &incompatible_result,
+           &incompatible_net_log_source, incompatible_callback.callback());
+    EXPECT_THAT(incompatible_callback.WaitForResult(),
+                IsError(ERR_CERT_AUTHORITY_INVALID));
+    EXPECT_FALSE(incompatible_result.mtc_verification_info.has_value());
+  }
+
+  // Altering authenticated TBSCertificate bytes invalidates the Merkle proof.
+  trust_store.Clear();
+  ASSERT_TRUE(trust_store.AddMTCTrustAnchor(mtc_anchor));
+  std::vector<uint8_t> altered_der = *leaf_der;
+  constexpr std::string_view kOriginalName = "www.example.com";
+  constexpr std::string_view kAlteredName = "vww.example.com";
+  size_t replacements = 0;
+  for (auto it = std::search(altered_der.begin(), altered_der.end(),
+                             kOriginalName.begin(), kOriginalName.end());
+       it != altered_der.end();
+       it = std::search(it, altered_der.end(), kOriginalName.begin(),
+                        kOriginalName.end())) {
+    std::copy(kAlteredName.begin(), kAlteredName.end(), it);
+    ++replacements;
+    it += kAlteredName.size();
+  }
+  ASSERT_GT(replacements, 0u);
+  scoped_refptr<X509Certificate> altered_leaf =
+      X509Certificate::CreateFromBytes(altered_der);
+  ASSERT_TRUE(altered_leaf);
+  ASSERT_NE(altered_der, *leaf_der);
+  ASSERT_TRUE(altered_leaf->VerifyNameMatch(kAlteredName));
+  {
+    CertVerifyResult altered_result;
+    NetLogSource altered_net_log_source;
+    TestCompletionCallback altered_callback;
+    Verify(altered_leaf.get(), std::string(kAlteredName), /*flags=*/0,
+           &altered_result, &altered_net_log_source,
+           altered_callback.callback());
+    EXPECT_THAT(altered_callback.WaitForResult(),
+                IsError(ERR_CERT_AUTHORITY_INVALID));
+    EXPECT_FALSE(altered_result.mtc_verification_info.has_value());
+  }
+}
