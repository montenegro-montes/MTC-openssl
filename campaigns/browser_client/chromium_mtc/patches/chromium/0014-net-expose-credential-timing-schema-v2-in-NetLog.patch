From 6a1d8945debdecde85aeecda75adcafcbfa794b4 Mon Sep 17 00:00:00 2001
From: Jose Antonio Montenegro Montes <jmmontes@uma.es>
Date: Thu, 15 Oct 2026 10:44:44 +0200
Subject: [PATCH 14/16] net: expose credential timing schema v2 in NetLog

---
 net/cert/cert_verify_proc.cc         | 100 ++++++++++++++++++++++++++-
 net/cert/cert_verify_proc_builtin.cc |  18 +++++
 net/cert/cert_verify_result.cc       |   7 ++
 net/cert/cert_verify_result.h        |  17 +++++
 net/log/net_log_event_type_list.h    |  46 +++++++++++-
 5 files changed, 183 insertions(+), 5 deletions(-)

diff --git a/net/cert/cert_verify_proc.cc b/net/cert/cert_verify_proc.cc
index 5c15c76bea..140cc67481 100644
--- a/net/cert/cert_verify_proc.cc
+++ b/net/cert/cert_verify_proc.cc
@@ -7,6 +7,8 @@
 #include <stdint.h>
 
 #include <algorithm>
+#include <chrono>
+#include <limits>
 #include <optional>
 #include <string_view>
 
@@ -449,6 +451,14 @@ int CertVerifyProc::Verify(X509Certificate* cert,
     return CertVerifyParams(cert, hostname, ocsp_response, sct_list, flags,
                             crl_set());
   });
+
+  // Inclusive credential-validation interval. This covers CertVerifyProc's
+  // complete synchronous verification boundary, including path building and
+  // selection, policy and hostname checks, available revocation data, cache
+  // lookups, and any blocking work performed by VerifyInternal(). It excludes
+  // TLS CertificateVerify and NetLog event emission outside this interval.
+  const auto credential_validation_start = std::chrono::steady_clock::now();
+
   // CertVerifyProc's contract allows ::VerifyInternal() to wait on File I/O
   // (such as the Windows registry or smart cards on all platforms) or may re-
   // enter this code via extension hooks (such as smart card UI). To ensure
@@ -564,19 +574,105 @@ int CertVerifyProc::Verify(X509Certificate* cert,
                                verify_result->is_issued_by_known_root);
   }
 
+  const uint64_t credential_validation_total_ns =
+      std::chrono::duration_cast<std::chrono::nanoseconds>(
+          std::chrono::steady_clock::now() - credential_validation_start)
+          .count();
+  net_log.AddEvent(NetLogEventType::CREDENTIAL_VALIDATION_TIMING, [&] {
+    base::DictValue params;
+    params.Set("timing_schema_version", 2);
+    params.Set("credential_validation_total_ns",
+               std::to_string(credential_validation_total_ns));
+    if (verify_result->selected_path_is_mtc) {
+      params.Set("credential_type",
+                 *verify_result->selected_path_is_mtc ? "mtc" : "x509");
+    }
+    if (verify_result->selected_path_is_mtc.value_or(false) &&
+        verify_result->mtc_verification_timing &&
+        verify_result->mtc_verification_timing->mode) {
+      params.Set(
+          "verification_mode",
+          *verify_result->mtc_verification_timing->mode ==
+                  bssl::MTCVerificationMode::kLandmark
+              ? "landmark"
+              : "standalone");
+    }
+    if (verify_result->selected_path_is_mtc.has_value() &&
+        !*verify_result->selected_path_is_mtc &&
+        verify_result->x509_signatures_ns) {
+      params.Set("x509_signatures_inclusive_ns",
+                 std::to_string(*verify_result->x509_signatures_ns));
+    }
+    if (verify_result->selected_path_is_mtc.has_value() &&
+        !*verify_result->selected_path_is_mtc &&
+        verify_result->x509_signature_crypto_ns) {
+      params.Set("x509_signatures_ns",
+                 std::to_string(*verify_result->x509_signature_crypto_ns));
+      params.Set("x509_signature_count",
+                 std::to_string(*verify_result->x509_signature_count));
+    }
+    if (verify_result->selected_path_is_mtc.has_value() &&
+        !*verify_result->selected_path_is_mtc &&
+        verify_result->x509_signature_cache_ns) {
+      params.Set("x509_signature_cache_ns",
+                 std::to_string(*verify_result->x509_signature_cache_ns));
+      params.Set("x509_signature_cache_hits",
+                 std::to_string(*verify_result->x509_signature_cache_hits));
+      params.Set("x509_signature_cache_misses",
+                 std::to_string(*verify_result->x509_signature_cache_misses));
+    }
+    params.Set("success", rv == OK);
+    return params;
+  });
+
   if (verify_result->mtc_verification_timing) {
     const bssl::MTCVerificationTiming& timing =
         *verify_result->mtc_verification_timing;
     net_log.AddEvent(NetLogEventType::MTC_VERIFICATION_TIMING, [&] {
       base::DictValue params;
+      params.Set("timing_schema_version", 2);
       params.Set("mtc_total_ns", std::to_string(timing.mtc_total_ns));
+      if (timing.merkle_leaf_hash_ns) {
+        params.Set("merkle_leaf_hash_ns",
+                   std::to_string(*timing.merkle_leaf_hash_ns));
+      }
+      if (timing.merkle_path_ns) {
+        params.Set("merkle_path_ns",
+                   std::to_string(*timing.merkle_path_ns));
+      }
+      if (timing.merkle_total_ns) {
+        params.Set("merkle_total_ns",
+                   std::to_string(*timing.merkle_total_ns));
+      }
       if (timing.merkle_proof_ns) {
         params.Set("merkle_proof_ns",
                    std::to_string(*timing.merkle_proof_ns));
       }
-      if (timing.standalone_signatures_ns) {
+      if (timing.standalone_signatures_inclusive_ns) {
+        params.Set("standalone_signatures_inclusive_ns",
+                   std::to_string(
+                       *timing.standalone_signatures_inclusive_ns));
+      }
+      const bssl::SignatureVerificationTiming& signature_timing =
+          timing.standalone_signature_timing;
+      if (!signature_timing.crypto_overflow &&
+          signature_timing.crypto_count > 0) {
         params.Set("standalone_signatures_ns",
-                   std::to_string(*timing.standalone_signatures_ns));
+                   std::to_string(signature_timing.crypto_ns));
+        params.Set("standalone_signature_count",
+                   std::to_string(signature_timing.crypto_count));
+      }
+      if (!signature_timing.cache_overflow &&
+          signature_timing.cache_hits <=
+              std::numeric_limits<uint64_t>::max() -
+                  signature_timing.cache_misses &&
+          signature_timing.cache_hits + signature_timing.cache_misses > 0) {
+        params.Set("standalone_signature_cache_ns",
+                   std::to_string(signature_timing.cache_ns));
+        params.Set("standalone_signature_cache_hits",
+                   std::to_string(signature_timing.cache_hits));
+        params.Set("standalone_signature_cache_misses",
+                   std::to_string(signature_timing.cache_misses));
       }
       if (timing.mode) {
         params.Set("verification_mode",
diff --git a/net/cert/cert_verify_proc_builtin.cc b/net/cert/cert_verify_proc_builtin.cc
index 789e70c4bf..b3efc41506 100644
--- a/net/cert/cert_verify_proc_builtin.cc
+++ b/net/cert/cert_verify_proc_builtin.cc
@@ -5,6 +5,7 @@
 #include "net/cert/cert_verify_proc_builtin.h"
 
 #include <cstdint>
+#include <limits>
 #include <memory>
 #include <optional>
 #include <string>
@@ -1622,6 +1623,23 @@ int AssignVerifyResult(
   // Preserve timing from the selected path even when MTC verification failed.
   verify_result->mtc_verification_timing =
       partial_path.mtc_verification_timing;
+  verify_result->selected_path_is_mtc =
+      partial_path.trust_anchor.MTCAnchor() != nullptr;
+  verify_result->x509_signatures_ns = partial_path.x509_signatures_ns;
+  const bssl::SignatureVerificationTiming& x509_timing =
+      partial_path.x509_signature_timing;
+  if (!x509_timing.crypto_overflow && x509_timing.crypto_count > 0) {
+    verify_result->x509_signature_crypto_ns = x509_timing.crypto_ns;
+    verify_result->x509_signature_count = x509_timing.crypto_count;
+  }
+  if (!x509_timing.cache_overflow &&
+      x509_timing.cache_hits <=
+          std::numeric_limits<uint64_t>::max() - x509_timing.cache_misses &&
+      x509_timing.cache_hits + x509_timing.cache_misses > 0) {
+    verify_result->x509_signature_cache_ns = x509_timing.cache_ns;
+    verify_result->x509_signature_cache_hits = x509_timing.cache_hits;
+    verify_result->x509_signature_cache_misses = x509_timing.cache_misses;
+  }
 
   AppendPublicKeyHashes(partial_path, &verify_result->public_key_hashes);
 
diff --git a/net/cert/cert_verify_result.cc b/net/cert/cert_verify_result.cc
index 1d9e9b674e..69d51cd71f 100644
--- a/net/cert/cert_verify_result.cc
+++ b/net/cert/cert_verify_result.cc
@@ -33,6 +33,13 @@ void CertVerifyResult::Reset() {
   public_key_hashes.clear();
   mtc_verification_info.reset();
   mtc_verification_timing.reset();
+  selected_path_is_mtc.reset();
+  x509_signatures_ns.reset();
+  x509_signature_crypto_ns.reset();
+  x509_signature_count.reset();
+  x509_signature_cache_ns.reset();
+  x509_signature_cache_hits.reset();
+  x509_signature_cache_misses.reset();
   ocsp_result = bssl::OCSPVerifyResult();
 
   scts.clear();
diff --git a/net/cert/cert_verify_result.h b/net/cert/cert_verify_result.h
index 2668efe2cf..67284899e8 100644
--- a/net/cert/cert_verify_result.h
+++ b/net/cert/cert_verify_result.h
@@ -81,6 +81,23 @@ class NET_EXPORT CertVerifyResult {
   // Experimental timing for MTC verification on the selected validation path.
   std::optional<bssl::MTCVerificationTiming> mtc_verification_timing;
 
+  // Whether the selected validation path uses an MTC trust anchor. Absent when
+  // no path was selected, so failed validations are not misclassified.
+  std::optional<bool> selected_path_is_mtc;
+
+  // Accumulated X.509 certificate signature verification time for the selected
+  // validation path. Absent if no X.509 certificate signature was verified.
+  std::optional<uint64_t> x509_signatures_ns;
+
+  // v2 effective X.509 signature cryptography and cache lookup metrics for
+  // the selected candidate path. Absent means the operation was not executed
+  // or its accumulator overflowed.
+  std::optional<uint64_t> x509_signature_crypto_ns;
+  std::optional<uint64_t> x509_signature_count;
+  std::optional<uint64_t> x509_signature_cache_ns;
+  std::optional<uint64_t> x509_signature_cache_hits;
+  std::optional<uint64_t> x509_signature_cache_misses;
+
   // is_issued_by_known_root is true if we recognise the root CA as a standard
   // root.  If it isn't then it's probably the case that this certificate was
   // generated by a MITM proxy whose root has been installed locally. This is
diff --git a/net/log/net_log_event_type_list.h b/net/log/net_log_event_type_list.h
index 817357c849..78c19c29ff 100644
--- a/net/log/net_log_event_type_list.h
+++ b/net/log/net_log_event_type_list.h
@@ -751,7 +751,10 @@ EVENT_TYPE(SSL_HANDSHAKE_ERROR)
 
 // Experimental TLS 1.3 CertificateVerify signature verification timing.
 // Parameters:
+//   "certificate_verify_crypto_ns": Canonical v2 name for the effective
+//       ssl_public_key_verify interval, as a nanosecond string.
 //   "elapsed_ns": Elapsed wall-clock time in nanoseconds, as a string.
+//       Historical alias for certificate_verify_crypto_ns.
 //   "signature_algorithm": TLS signature scheme identifier.
 //   "success": Whether the cryptographic verification succeeded.
 //   "ssl_do_handshake_result": Return value of SSL_do_handshake() when collected.
@@ -4219,12 +4222,49 @@ EVENT_TYPE(CERT_VERIFY_PROC_CREATED)
 //   }
 EVENT_TYPE(CERT_VERIFY_PROC)
 
+// Inclusive timing for one CertVerifyProc credential validation. The interval
+// includes path building and selection, certificate-policy and hostname checks,
+// available revocation processing, signature-cache lookups, and blocking work
+// performed by the verifier. It excludes TLS CertificateVerify and the timing
+// NetLog events themselves.
+// Parameters:
+//   "credential_validation_total_ns": Inclusive duration in nanoseconds, as a
+//       string.
+//   "credential_type": Optional "x509" or "mtc". Absent if validation did
+//       not select a path whose credential type can be determined reliably.
+//   "verification_mode": Optional "landmark" or "standalone" for MTC.
+//   "x509_signatures_ns": Optional selected-path effective X.509 signature
+//       cryptography duration, as a string.
+//   "x509_signature_count": Optional number of effective cryptographic
+//       signature checks, as a string.
+//   "x509_signature_cache_ns": Optional selected-path cache lookup duration,
+//       as a string, with corresponding hit and miss counters.
+//   "x509_signatures_inclusive_ns": Historical interval around
+//       VerifySignedData, including cache lookup, as a string.
+//   "success": Whether CertVerifyProc returned OK.
+// Internal MTC timers are subsets of the common interval and must not be added
+// to it. TLS CertificateVerify is a separate operation.
+EVENT_TYPE(CREDENTIAL_VALIDATION_TIMING)
+
 // Experimental timing for MTC verification on the selected certificate path.
 // Parameters:
+//   "timing_schema_version": Integer schema version. Version 2 adds separate
+//       Merkle leaf-hash, path, and inclusive-total intervals.
 //   "mtc_total_ns": Complete VerifyMTC wall-clock time, as a string.
-//   "merkle_proof_ns": Optional inclusion-proof evaluation time, as a string.
-//   "standalone_signatures_ns": Optional accumulated Standalone signature
-//       verification time, as a string. This includes signature-cache lookups.
+//   "merkle_leaf_hash_ns": Optional MTC leaf construction and hash time, as a
+//       string.
+//   "merkle_path_ns": Optional inclusion-proof evaluation time, as a string.
+//   "merkle_total_ns": Optional inclusive leaf-hash through path-evaluation
+//       time, as a string. It is measured directly, not derived by addition.
+//   "merkle_proof_ns": Historical alias for merkle_path_ns, as a string.
+//   "standalone_signatures_ns": Optional accumulated effective Standalone
+//       signature cryptography time, as a string.
+//   "standalone_signature_count": Optional number of effective cryptographic
+//       signature checks, as a string.
+//   "standalone_signature_cache_ns": Optional accumulated signature-cache
+//       lookup time, as a string, with corresponding hit and miss counters.
+//   "standalone_signatures_inclusive_ns": Historical interval around
+//       VerifyMTCProofSignaturePlants04, as a string.
 //   "verification_mode": Optional "landmark" or "standalone" classification.
 //   "success": Whether VerifyMTC itself succeeded.
 EVENT_TYPE(MTC_VERIFICATION_TIMING)
