diff --git a/net/cert/mtc_plants06_lab_config.h b/net/cert/mtc_plants06_lab_config.h
new file mode 100644
index 0000000000..f8634d8933
--- /dev/null
+++ b/net/cert/mtc_plants06_lab_config.h
@@ -0,0 +1,69 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef NET_CERT_MTC_PLANTS06_LAB_CONFIG_H_
+#define NET_CERT_MTC_PLANTS06_LAB_CONFIG_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "net/base/net_export.h"
+
+namespace net {
+
+// Operator-supplied trust configuration for the controlled Plants-06
+// interoperability laboratory. This is deliberately separate from Chrome Root
+// Store production trust configuration.
+enum class MtcPlants06LabSignatureAlgorithm {
+  kEcdsaSha256,
+  kEcdsaSha384,
+  kEcdsaSha512,
+  kMldsa44,
+  kMldsa65,
+  kMldsa87,
+};
+
+struct NET_EXPORT MtcPlants06LabTrustedSubtree {
+  uint64_t start = 0;
+  uint64_t end = 0;
+  std::array<uint8_t, 32> hash{};
+};
+
+struct NET_EXPORT MtcPlants06LabConfig {
+  std::vector<uint8_t> ca_id;
+  std::vector<uint8_t> ca_spki_der;
+
+  MtcPlants06LabSignatureAlgorithm signature_algorithm =
+      MtcPlants06LabSignatureAlgorithm::kEcdsaSha256;
+
+  uint64_t min_serial = 0;
+  uint64_t max_serial = 0;
+
+  uint16_t log_number = 0;
+  uint64_t landmark_number = 0;
+  uint64_t tree_size = 0;
+
+  std::vector<MtcPlants06LabTrustedSubtree> trusted_subtrees;
+};
+
+// Reads and validates a chromium-mtc-plants06-lab version 1 JSON file.
+NET_EXPORT std::optional<MtcPlants06LabConfig> LoadMtcPlants06LabConfig(
+    const base::FilePath& path);
+
+// Reads the path from --mtc-plants06-trust and applies trusted-subtree
+// state from either --mtc-plants06-trusted-subtrees (FILE mode) or the
+// supplied HTTP MTS1 bytes when --mtc-plants06-trusted-subtrees-url is used.
+// FILE and URL modes are mutually exclusive. URL mode fails closed while no
+// successfully fetched HTTP state is available.
+NET_EXPORT std::optional<MtcPlants06LabConfig>
+LoadMtcPlants06LabConfigFromCommandLine(
+    const std::string* http_trusted_subtrees = nullptr);
+
+}  // namespace net
+
+#endif  // NET_CERT_MTC_PLANTS06_LAB_CONFIG_H_
