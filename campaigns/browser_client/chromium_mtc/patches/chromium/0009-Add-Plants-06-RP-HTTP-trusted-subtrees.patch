+
+void SystemNetworkContextManager::StartMtcPlants06TrustedSubtreesFetch() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+
+  const bool has_file =
+      command_line->HasSwitch(net::switches::kMtcPlants06TrustedSubtrees);
+  const bool has_url =
+      command_line->HasSwitch(net::switches::kMtcPlants06TrustedSubtreesUrl);
+
+  if (has_file && has_url) {
+    LOG(ERROR) << "MTC Plants-06 trusted-subtrees file and URL modes "
+                  "are mutually exclusive";
+    return;
+  }
+
+  if (!has_url) {
+    return;
+  }
+
+  const std::string url_string =
+      command_line->GetSwitchValueASCII(
+          net::switches::kMtcPlants06TrustedSubtreesUrl);
+
+  const GURL url(url_string);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    LOG(ERROR) << "Invalid MTC Plants-06 trusted-subtrees URL";
+    return;
+  }
+
+  net::NetworkTrafficAnnotationTag traffic_annotation =
+      net::DefineNetworkTrafficAnnotation(
+          "mtc_plants06_trusted_subtrees",
+          R"(
+        semantics {
+          sender: "MTC Plants-06 laboratory trusted-subtree loader"
+          description:
+            "Fetches laboratory relying-party trusted subtree state for "
+            "experimental Merkle Tree Certificate verification."
+          trigger:
+            "Chromium is explicitly launched with the laboratory-only "
+            "--mtc-plants06-trusted-subtrees-url switch."
+          data: "No user data. The request retrieves MTC trust metadata."
+          destination: OTHER
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "This request only exists for the explicitly enabled MTC "
+            "Plants-06 interoperability laboratory."
+          policy_exception_justification:
+            "Laboratory-only command-line configuration."
+        })");
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->method = "GET";
+  request->load_flags =
+      net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+
+  mtc_plants06_trusted_subtrees_loader_ =
+      network::SimpleURLLoader::Create(std::move(request),
+                                       traffic_annotation);
+
+  constexpr size_t kMaximumMts1Size = 64 * 1024;
+
+  mtc_plants06_trusted_subtrees_loader_->DownloadToString(
+      GetSharedURLLoaderFactory().get(),
+      base::BindOnce(
+          &SystemNetworkContextManager::
+              OnMtcPlants06TrustedSubtreesFetched,
+          base::Unretained(this)),
+      kMaximumMts1Size);
+}
+
+void SystemNetworkContextManager::OnMtcPlants06TrustedSubtreesFetched(
+    std::optional<std::string> response_body) {
+  const int net_error =
+      mtc_plants06_trusted_subtrees_loader_->NetError();
+
+  const network::mojom::URLResponseHead* response =
+      mtc_plants06_trusted_subtrees_loader_->ResponseInfo();
+
+  int response_code = 0;
+  if (response && response->headers) {
+    response_code = response->headers->response_code();
+  }
+
+  if (net_error != net::OK || response_code != 200 ||
+      !response_body.has_value()) {
+    LOG(ERROR) << "Unable to fetch MTC Plants-06 trusted subtrees"
+               << " net_error=" << net_error
+               << " http_status=" << response_code;
+    mtc_plants06_trusted_subtrees_.reset();
+
+#if BUILDFLAG(CHROME_ROOT_STORE_SUPPORTED)
+    content::GetCertVerifierServiceFactory()
+        ->UpdateMtcPlants06TrustedSubtrees(std::nullopt, base::DoNothing());
+#endif
+
+    mtc_plants06_trusted_subtrees_loader_.reset();
+    return;
+  }
+
+  mtc_plants06_trusted_subtrees_ = std::move(*response_body);
+
+  std::vector<uint8_t> trusted_subtrees(
+      mtc_plants06_trusted_subtrees_->begin(),
+      mtc_plants06_trusted_subtrees_->end());
+
+#if BUILDFLAG(CHROME_ROOT_STORE_SUPPORTED)
+  content::GetCertVerifierServiceFactory()
+      ->UpdateMtcPlants06TrustedSubtrees(std::move(trusted_subtrees),
+                                         base::DoNothing());
+#endif
+
+  LOG(INFO) << "Loaded MTC Plants-06 trusted subtrees from RP HTTP endpoint: "
+            << mtc_plants06_trusted_subtrees_->size() << " bytes";
+
+  mtc_plants06_trusted_subtrees_loader_.reset();
+}
