+namespace security_state {
+namespace {
+
+void ExpectMtcVerificationInfo(
+    const std::optional<net::MtcVerificationInfo>& info,
+    net::MtcVerificationMode mode,
+    const std::vector<uint8_t>& ca_id,
+    uint16_t log_number,
+    uint64_t leaf_index) {
+  ASSERT_TRUE(info.has_value());
+  EXPECT_EQ(info->mode, mode);
+  EXPECT_EQ(info->ca_id, ca_id);
+  EXPECT_EQ(info->log_number, log_number);
+  EXPECT_EQ(info->leaf_index, leaf_index);
+}
+
+class ContentUtilsTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    web_contents_ = web_contents_factory_.CreateWebContents(&browser_context_);
+    content::WebContentsTester::For(web_contents_)
+        ->NavigateAndCommit(GURL("https://example.test"));
+  }
+
+  std::unique_ptr<VisibleSecurityState> GetState(
+      const content::SSLStatus& ssl_status) {
+    web_contents_->GetController().GetVisibleEntry()->GetSSL() =
+        ssl_status;
+    return GetVisibleSecurityState(web_contents_);
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  content::TestBrowserContext browser_context_;
+  content::TestWebContentsFactory web_contents_factory_;
+  raw_ptr<content::WebContents> web_contents_ = nullptr;
+};
+
+TEST_F(ContentUtilsTest, MtcVerificationInfoAbsent) {
+  const content::SSLStatus ssl_status{net::SSLInfo()};
+  EXPECT_FALSE(ssl_status.mtc_verification_info.has_value());
+
+  std::unique_ptr<VisibleSecurityState> state = GetState(ssl_status);
+  EXPECT_FALSE(state->mtc_verification_info.has_value());
+}
+
+TEST_F(ContentUtilsTest, LandmarkMtcVerificationInfo) {
+  constexpr uint16_t kLogNumber = 7;
+  constexpr uint64_t kLeafIndex = 0x010203040506;
+  const std::vector<uint8_t> kCaId = {0x10, 0x20, 0x30};
+  net::SSLInfo ssl_info;
+  ssl_info.mtc_verification_info = bssl::MTCVerificationInfo{
+      .mode = bssl::MTCVerificationMode::kLandmark,
+      .ca_id = kCaId,
+      .log_number = kLogNumber,
+      .leaf_index = kLeafIndex,
+  };
+  const content::SSLStatus ssl_status{ssl_info};
+  ExpectMtcVerificationInfo(ssl_status.mtc_verification_info,
+                            net::MtcVerificationMode::kLandmark, kCaId,
+                            kLogNumber, kLeafIndex);
+
+  std::unique_ptr<VisibleSecurityState> state = GetState(ssl_status);
+
+  ExpectMtcVerificationInfo(state->mtc_verification_info,
+                            net::MtcVerificationMode::kLandmark, kCaId,
+                            kLogNumber, kLeafIndex);
+}
+
+TEST_F(ContentUtilsTest, StandaloneMtcVerificationInfo) {
+  constexpr uint16_t kLogNumber = 11;
+  constexpr uint64_t kLeafIndex = 0x0a0b0c0d0e0f;
+  const std::vector<uint8_t> kCaId = {0xaa, 0xbb, 0xcc};
+  net::SSLInfo ssl_info;
+  ssl_info.mtc_verification_info = bssl::MTCVerificationInfo{
+      .mode = bssl::MTCVerificationMode::kStandalone,
+      .ca_id = kCaId,
+      .log_number = kLogNumber,
+      .leaf_index = kLeafIndex,
+  };
+  const content::SSLStatus ssl_status{ssl_info};
+  ExpectMtcVerificationInfo(ssl_status.mtc_verification_info,
+                            net::MtcVerificationMode::kStandalone, kCaId,
+                            kLogNumber, kLeafIndex);
+
+  std::unique_ptr<VisibleSecurityState> state = GetState(ssl_status);
+
+  ExpectMtcVerificationInfo(state->mtc_verification_info,
+                            net::MtcVerificationMode::kStandalone, kCaId,
+                            kLogNumber, kLeafIndex);
+}
+
+}  // namespace
+}  // namespace security_state
