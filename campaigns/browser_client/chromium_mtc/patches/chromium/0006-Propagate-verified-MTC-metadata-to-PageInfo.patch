+#ifndef NET_SSL_MTC_VERIFICATION_INFO_H_
+#define NET_SSL_MTC_VERIFICATION_INFO_H_
+
+#include <cstdint>
+#include <vector>
+
+#include "net/base/net_export.h"
+
+namespace net {
+
+enum class MtcVerificationMode {
+  kLandmark,
+  kStandalone,
+};
+
+struct NET_EXPORT MtcVerificationInfo {
+  MtcVerificationMode mode;
+  std::vector<uint8_t> ca_id;
+  uint16_t log_number;
+  uint64_t leaf_index;
+};
+
+}  // namespace net
