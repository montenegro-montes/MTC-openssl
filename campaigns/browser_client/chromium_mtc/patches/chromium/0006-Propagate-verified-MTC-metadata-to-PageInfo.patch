diff --git a/content/public/browser/ssl_status.cc b/content/public/browser/ssl_status.cc
index 4a9ed77ecd..bc8482b57b 100644
--- a/content/public/browser/ssl_status.cc
+++ b/content/public/browser/ssl_status.cc
@@ -6,6 +6,34 @@
 
 #include "net/ssl/ssl_info.h"
 
+namespace {
+
+std::optional<net::MtcVerificationInfo> ConvertMtcVerificationInfo(
+    const std::optional<bssl::MTCVerificationInfo>& mtc_verification_info) {
+  if (!mtc_verification_info) {
+    return std::nullopt;
+  }
+
+  net::MtcVerificationMode mode;
+  switch (mtc_verification_info->mode) {
+    case bssl::MTCVerificationMode::kLandmark:
+      mode = net::MtcVerificationMode::kLandmark;
+      break;
+    case bssl::MTCVerificationMode::kStandalone:
+      mode = net::MtcVerificationMode::kStandalone;
+      break;
+  }
+
+  return net::MtcVerificationInfo{
+      .mode = mode,
+      .ca_id = mtc_verification_info->ca_id,
+      .log_number = mtc_verification_info->log_number,
+      .leaf_index = mtc_verification_info->leaf_index,
+  };
+}
+
+}  // namespace
+
 namespace content {
 
