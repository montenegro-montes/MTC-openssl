diff --git a/chrome/browser/ui/page_info/page_info_unittest.cc b/chrome/browser/ui/page_info/page_info_unittest.cc
index 9e3e5fb667..0bc13a0961 100644
--- a/chrome/browser/ui/page_info/page_info_unittest.cc
+++ b/chrome/browser/ui/page_info/page_info_unittest.cc
@@ -1199,12 +1199,71 @@ TEST_F(PageInfoTest, HTTPSConnection) {
   visible_security_state_.connection_status = status;
   visible_security_state_.connection_info_initialized = true;
 
-  SetDefaultUIExpectations(mock_ui());
+  EXPECT_CALL(*mock_ui(), SetPermissionInfoStub());
+  PageInfoUI::IdentityInfo identity_info;
+  EXPECT_CALL(*mock_ui(), SetIdentityInfo(_))
+      .WillOnce(::testing::SaveArg<0>(&identity_info));
+  ExpectInitialSetCookieInfoCall(mock_ui());
 
   EXPECT_EQ(PageInfo::SITE_CONNECTION_STATUS_ENCRYPTED,
             page_info()->site_connection_status());
   EXPECT_EQ(PageInfo::SITE_IDENTITY_STATUS_CERT,
             page_info()->site_identity_status());
+  EXPECT_FALSE(identity_info.mtc_verification_info.has_value());
+}
+
+TEST_F(PageInfoTest, LandmarkMtcVerificationInfo) {
+  constexpr uint16_t kLogNumber = 7;
+  constexpr uint64_t kLeafIndex = 0x010203040506;
+  const std::vector<uint8_t> kCaId = {0x10, 0x20, 0x30};
+  visible_security_state_.mtc_verification_info = net::MtcVerificationInfo{
+      .mode = net::MtcVerificationMode::kLandmark,
+      .ca_id = kCaId,
+      .log_number = kLogNumber,
+      .leaf_index = kLeafIndex,
+  };
+
+  EXPECT_CALL(*mock_ui(), SetPermissionInfoStub());
+  PageInfoUI::IdentityInfo identity_info;
+  EXPECT_CALL(*mock_ui(), SetIdentityInfo(_))
+      .WillOnce(::testing::SaveArg<0>(&identity_info));
+  ExpectInitialSetCookieInfoCall(mock_ui());
+
+  page_info();
+
+  ASSERT_TRUE(identity_info.mtc_verification_info.has_value());
+  EXPECT_EQ(identity_info.mtc_verification_info->mode,
+            net::MtcVerificationMode::kLandmark);
+  EXPECT_EQ(identity_info.mtc_verification_info->ca_id, kCaId);
+  EXPECT_EQ(identity_info.mtc_verification_info->log_number, kLogNumber);
+  EXPECT_EQ(identity_info.mtc_verification_info->leaf_index, kLeafIndex);
+}
+
+TEST_F(PageInfoTest, StandaloneMtcVerificationInfo) {
+  constexpr uint16_t kLogNumber = 11;
+  constexpr uint64_t kLeafIndex = 0x0a0b0c0d0e0f;
+  const std::vector<uint8_t> kCaId = {0xaa, 0xbb, 0xcc};
+  visible_security_state_.mtc_verification_info = net::MtcVerificationInfo{
+      .mode = net::MtcVerificationMode::kStandalone,
+      .ca_id = kCaId,
+      .log_number = kLogNumber,
+      .leaf_index = kLeafIndex,
+  };
+
+  EXPECT_CALL(*mock_ui(), SetPermissionInfoStub());
+  PageInfoUI::IdentityInfo identity_info;
+  EXPECT_CALL(*mock_ui(), SetIdentityInfo(_))
+      .WillOnce(::testing::SaveArg<0>(&identity_info));
+  ExpectInitialSetCookieInfoCall(mock_ui());
+
+  page_info();
+
+  ASSERT_TRUE(identity_info.mtc_verification_info.has_value());
+  EXPECT_EQ(identity_info.mtc_verification_info->mode,
+            net::MtcVerificationMode::kStandalone);
+  EXPECT_EQ(identity_info.mtc_verification_info->ca_id, kCaId);
+  EXPECT_EQ(identity_info.mtc_verification_info->log_number, kLogNumber);
+  EXPECT_EQ(identity_info.mtc_verification_info->leaf_index, kLeafIndex);
 }
 
