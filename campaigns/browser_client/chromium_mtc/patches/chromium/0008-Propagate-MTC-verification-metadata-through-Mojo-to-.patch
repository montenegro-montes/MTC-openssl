+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "services/network/public/cpp/mtc_verification_info_mojom_traits.h"
+
+#include "base/notreached.h"
+
+namespace mojo {
+
+// static
+network::mojom::MTCVerificationMode EnumTraits<
+    network::mojom::MTCVerificationMode,
+    bssl::MTCVerificationMode>::ToMojom(bssl::MTCVerificationMode input) {
+  switch (input) {
+    case bssl::MTCVerificationMode::kLandmark:
+      return network::mojom::MTCVerificationMode::kLandmark;
+    case bssl::MTCVerificationMode::kStandalone:
+      return network::mojom::MTCVerificationMode::kStandalone;
+  }
+  NOTREACHED();
+}
+
+// static
+std::optional<bssl::MTCVerificationMode>
+EnumTraits<network::mojom::MTCVerificationMode, bssl::MTCVerificationMode>::
+    FromMojom(network::mojom::MTCVerificationMode input) {
+  switch (input) {
+    case network::mojom::MTCVerificationMode::kLandmark:
+      return bssl::MTCVerificationMode::kLandmark;
+    case network::mojom::MTCVerificationMode::kStandalone:
+      return bssl::MTCVerificationMode::kStandalone;
+  }
+  return std::nullopt;
+}
+
+// static
+bool StructTraits<network::mojom::MTCVerificationInfoDataView,
+                  bssl::MTCVerificationInfo>::
+    Read(network::mojom::MTCVerificationInfoDataView data,
+         bssl::MTCVerificationInfo* out) {
+  out->log_number = data.log_number();
+  out->leaf_index = data.leaf_index();
+  return data.ReadMode(&out->mode) && data.ReadCaId(&out->ca_id);
+}
+
+}  // namespace mojo
