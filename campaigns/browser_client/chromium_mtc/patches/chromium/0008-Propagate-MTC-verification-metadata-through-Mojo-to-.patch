+#ifndef SERVICES_NETWORK_PUBLIC_CPP_MTC_VERIFICATION_INFO_MOJOM_TRAITS_H_
+#define SERVICES_NETWORK_PUBLIC_CPP_MTC_VERIFICATION_INFO_MOJOM_TRAITS_H_
