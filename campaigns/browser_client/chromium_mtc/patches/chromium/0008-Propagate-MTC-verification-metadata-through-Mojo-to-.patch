+TEST_F(PageInfoBubbleViewTest, MtcVerificationInfo) {
+  api_->navigation_handler()->OpenSecurityPage();
+  auto* page_view = static_cast<PageInfoSecurityContentView*>(
+      api_->current_view()->children()[1]);
+  ASSERT_TRUE(page_view);
+
+  PageInfoUI::IdentityInfo identity_info;
+  identity_info.identity_status = PageInfo::SITE_IDENTITY_STATUS_CERT;
+  identity_info.connection_status =
+      PageInfo::SITE_CONNECTION_STATUS_ENCRYPTED;
+
+  page_view->SetIdentityInfo(identity_info);
+  EXPECT_FALSE(api_->mtc_verification_view());
+
+  constexpr uint16_t kLandmarkLogNumber = 7;
+  constexpr uint64_t kLandmarkLeafIndex = 0x010203040506;
+  identity_info.mtc_verification_info = net::MtcVerificationInfo{
+      .mode = net::MtcVerificationMode::kLandmark,
+      .ca_id = {0x81, 0xfd, 0x59, 0x65, 0x01, 0x01, 0x01},
+      .log_number = kLandmarkLogNumber,
+      .leaf_index = kLandmarkLeafIndex,
+  };
+  page_view->SetIdentityInfo(identity_info);
+
+  ASSERT_TRUE(api_->mtc_verification_view());
+  EXPECT_EQ(api_->GetMtcVerificationTitle(),
+            l10n_util::GetStringUTF16(
+                IDS_PAGE_INFO_MTC_VERIFICATION_TITLE));
+  EXPECT_EQ(api_->GetMtcVerificationDetails(),
+            u"Mode: Landmark\nCA ID: 81fd5965010101\nLog number: 7\nLeaf "
+            u"index: 1108152157446");
+
+  constexpr uint16_t kStandaloneLogNumber = 11;
+  constexpr uint64_t kStandaloneLeafIndex = 42;
+  identity_info.mtc_verification_info = net::MtcVerificationInfo{
+      .mode = net::MtcVerificationMode::kStandalone,
+      .ca_id = {0xaa, 0x0b, 0xcc},
+      .log_number = kStandaloneLogNumber,
+      .leaf_index = kStandaloneLeafIndex,
+  };
+  page_view->SetIdentityInfo(identity_info);
+
+  ASSERT_TRUE(api_->mtc_verification_view());
+  EXPECT_EQ(api_->GetMtcVerificationDetails(),
+            u"Mode: Standalone\nCA ID: aa0bcc\nLog number: 11\nLeaf index: "
+            u"42");
+
+  identity_info.mtc_verification_info.reset();
+  page_view->SetIdentityInfo(identity_info);
+  EXPECT_FALSE(api_->mtc_verification_view());
+}
