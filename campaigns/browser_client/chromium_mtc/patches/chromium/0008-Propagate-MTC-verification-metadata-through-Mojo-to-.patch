+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "services/network/public/cpp/cert_verify_result_mojom_traits.h"
+
+#include <optional>
+
+#include "mojo/public/cpp/test_support/test_utils.h"
+#include "net/cert/cert_verify_result.h"
+#include "services/network/public/mojom/cert_verify_result.mojom.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+void ExpectMtcVerificationInfoEquals(
+    const bssl::MTCVerificationInfo& expected,
+    const std::optional<bssl::MTCVerificationInfo>& actual) {
+  ASSERT_TRUE(actual.has_value());
+  EXPECT_EQ(expected.mode, actual->mode);
+  EXPECT_EQ(expected.ca_id, actual->ca_id);
+  EXPECT_EQ(expected.log_number, actual->log_number);
+  EXPECT_EQ(expected.leaf_index, actual->leaf_index);
+}
+
+TEST(CertVerifyResultMojoTraitsTest, MtcVerificationInfo) {
+  net::CertVerifyResult in;
+  net::CertVerifyResult out;
+
+  ASSERT_TRUE(
+      mojo::test::SerializeAndDeserialize<network::mojom::CertVerifyResult>(
+          in, out));
+  EXPECT_FALSE(out.mtc_verification_info.has_value());
+
+  const bssl::MTCVerificationInfo landmark_info{
+      .mode = bssl::MTCVerificationMode::kLandmark,
+      .ca_id = {0x81, 0xfd, 0x59, 0x65},
+      .log_number = 7,
+      .leaf_index = 0x010203040506,
+  };
+  in.mtc_verification_info = landmark_info;
+  ASSERT_TRUE(
+      mojo::test::SerializeAndDeserialize<network::mojom::CertVerifyResult>(
+          in, out));
+  ExpectMtcVerificationInfoEquals(landmark_info, out.mtc_verification_info);
+
+  const bssl::MTCVerificationInfo standalone_info{
+      .mode = bssl::MTCVerificationMode::kStandalone,
+      .ca_id = {0xaa, 0x0b, 0xcc},
+      .log_number = 11,
+      .leaf_index = 42,
+  };
+  in.mtc_verification_info = standalone_info;
+  ASSERT_TRUE(
+      mojo::test::SerializeAndDeserialize<network::mojom::CertVerifyResult>(
+          in, out));
+  ExpectMtcVerificationInfoEquals(standalone_info, out.mtc_verification_info);
+}
+
+}  // namespace
