+#include <vector>
+
+#include "base/component_export.h"
+#include "mojo/public/cpp/bindings/enum_traits.h"
+#include "mojo/public/cpp/bindings/struct_traits.h"
+#include "services/network/public/mojom/mtc_verification_info.mojom-shared.h"
+#include "third_party/boringssl/src/pki/verify_certificate_chain.h"
+
+namespace mojo {
+
+template <>
+struct COMPONENT_EXPORT(NETWORK_CPP_NETWORK_PARAM)
+    EnumTraits<network::mojom::MTCVerificationMode, bssl::MTCVerificationMode> {
+  static network::mojom::MTCVerificationMode ToMojom(
+      bssl::MTCVerificationMode input);
+  static std::optional<bssl::MTCVerificationMode> FromMojom(
+      network::mojom::MTCVerificationMode input);
+};
+
+template <>
+class COMPONENT_EXPORT(NETWORK_CPP_NETWORK_PARAM)
+    StructTraits<network::mojom::MTCVerificationInfoDataView,
+                 bssl::MTCVerificationInfo> {
+ public:
+  static bssl::MTCVerificationMode mode(const bssl::MTCVerificationInfo& info) {
+    return info.mode;
+  }
+  static const std::vector<uint8_t>& ca_id(
+      const bssl::MTCVerificationInfo& info) {
+    return info.ca_id;
+  }
+  static uint16_t log_number(const bssl::MTCVerificationInfo& info) {
+    return info.log_number;
+  }
+  static uint64_t leaf_index(const bssl::MTCVerificationInfo& info) {
+    return info.leaf_index;
+  }
+
+  static bool Read(network::mojom::MTCVerificationInfoDataView data,
+                   bssl::MTCVerificationInfo* out);
+};
+
+}  // namespace mojo
