+  ASSERT_TRUE(ca_key);
+
+  auto mtc_anchor = std::make_shared<const bssl::MTCAnchor>(
+      bssl::MTCAnchor::kPlants07, kMtcCaId,
+      bssl::SignatureAlgorithm::kEcdsaSha256, std::move(ca_key),
+      kMinSerial, kMaxSerial, std::vector<bssl::LogTrustedSubtrees>());
