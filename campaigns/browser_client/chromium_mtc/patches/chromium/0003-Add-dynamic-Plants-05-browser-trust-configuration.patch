+// found in the LICENSE file.
+
+#ifndef NET_CERT_MTC_PLANTS05_LAB_CONFIG_H_
+#define NET_CERT_MTC_PLANTS05_LAB_CONFIG_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "net/base/net_export.h"
+
+namespace net {
+
+// Operator-supplied trust configuration for the controlled Plants-05
+// interoperability laboratory. This is deliberately separate from Chrome Root
+// Store production trust configuration.
+enum class MtcPlants05LabSignatureAlgorithm {
+  kEcdsaSha256,
+  kEcdsaSha384,
+  kEcdsaSha512,
+  kMldsa44,
+  kMldsa65,
+  kMldsa87,
+};
+
+struct NET_EXPORT MtcPlants05LabTrustedSubtree {
+  uint64_t start = 0;
+  uint64_t end = 0;
+  std::array<uint8_t, 32> hash{};
+};
+
+struct NET_EXPORT MtcPlants05LabConfig {
+  std::vector<uint8_t> ca_id;
+  std::vector<uint8_t> ca_spki_der;
+
+  MtcPlants05LabSignatureAlgorithm signature_algorithm =
+      MtcPlants05LabSignatureAlgorithm::kEcdsaSha256;
+
+  uint64_t min_serial = 0;
+  uint64_t max_serial = 0;
+
+  uint16_t log_number = 0;
+  uint64_t landmark_number = 0;
+  uint64_t tree_size = 0;
+
+  std::vector<MtcPlants05LabTrustedSubtree> trusted_subtrees;
+};
+
+// Reads and validates a chromium-mtc-plants05-lab version 1 JSON file.
+NET_EXPORT std::optional<MtcPlants05LabConfig> LoadMtcPlants05LabConfig(
+    const base::FilePath& path);
+
