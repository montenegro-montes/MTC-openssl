--- /dev/null
+++ b/net/cert/mtc_plants05_lab_config.cc
@@ -0,0 +1,278 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/cert/mtc_plants05_lab_config.h"
+
+#include <limits>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/values.h"
+#include "net/base/switches.h"
+
+namespace net {
+
+namespace {
+
+bool ParseUint64Hex(std::string_view value, uint64_t* result) {
+  if (value.starts_with("0x") || value.starts_with("0X")) {
+    value.remove_prefix(2);
+  }
+
+  if (value.empty() || value.size() > 16) {
+    return false;
+  }
+
+  uint64_t out = 0;
+  for (char c : value) {
+    uint8_t nibble;
+    if (c >= '0' && c <= '9') {
+      nibble = static_cast<uint8_t>(c - '0');
+    } else if (c >= 'a' && c <= 'f') {
+      nibble = static_cast<uint8_t>(c - 'a' + 10);
+    } else if (c >= 'A' && c <= 'F') {
+      nibble = static_cast<uint8_t>(c - 'A' + 10);
+    } else {
+      return false;
+    }
+    out = (out << 4) | nibble;
+  }
+
+  *result = out;
+  return true;
+}
+
+std::optional<MtcPlants05LabSignatureAlgorithm> ParseSignatureAlgorithm(
+    const base::DictValue& root) {
+  const std::string* value = root.FindString("signature_algorithm");
+
+  // Compatibility with the first version of the laboratory exporter. New
+  // exports should carry signature_algorithm explicitly.
+  if (!value) {
+    value = root.FindString("profile");
+  }
+  if (!value) {
+    return std::nullopt;
+  }
+
+  if (*value == "ecdsa-sha256" || *value == "ecdsa-p256") {
+    return MtcPlants05LabSignatureAlgorithm::kEcdsaSha256;
+  }
+  if (*value == "ecdsa-sha384" || *value == "ecdsa-p384") {
+    return MtcPlants05LabSignatureAlgorithm::kEcdsaSha384;
+  }
+  if (*value == "ecdsa-sha512" || *value == "ecdsa-p521") {
+    return MtcPlants05LabSignatureAlgorithm::kEcdsaSha512;
+  }
+  if (*value == "mldsa44") {
+    return MtcPlants05LabSignatureAlgorithm::kMldsa44;
+  }
+  if (*value == "mldsa65") {
+    return MtcPlants05LabSignatureAlgorithm::kMldsa65;
+  }
+  if (*value == "mldsa87") {
+    return MtcPlants05LabSignatureAlgorithm::kMldsa87;
+  }
+
+  return std::nullopt;
+}
+
+std::optional<MtcPlants05LabConfig> ParseConfig(std::string_view json) {
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!parsed) {
+    LOG(ERROR) << "MTC Plants-05 lab config is not valid JSON";
+    return std::nullopt;
+  }
+
+  const base::DictValue& root = *parsed;
+
+  const std::string* format = root.FindString("format");
+  std::optional<int> version = root.FindInt("version");
+  const std::string* spec = root.FindString("spec");
+  const std::string* source_format = root.FindString("source_format");
+
+  if (!format || *format != "chromium-mtc-plants05-lab" || !version ||
+      *version != 1 || !spec || *spec != "plants-05" || !source_format ||
+      *source_format != "MCF1") {
+    LOG(ERROR) << "Unsupported MTC Plants-05 lab config format";
+    return std::nullopt;
+  }
+
+  MtcPlants05LabConfig config;
+
+  const std::string* ca_id_hex = root.FindString("ca_id_hex");
+  if (!ca_id_hex || !base::HexStringToBytes(*ca_id_hex, &config.ca_id) ||
+      config.ca_id.empty()) {
+    LOG(ERROR) << "Invalid MTC Plants-05 CA ID";
+    return std::nullopt;
+  }
+
+  const base::ListValue* signers = root.FindList("signers");
+  if (!signers || signers->size() != 2 || !(*signers)[0].is_dict()) {
+    LOG(ERROR) << "MTC Plants-05 config must contain exactly two signers";
+    return std::nullopt;
+  }
+
+  const base::DictValue& ca_signer = (*signers)[0].GetDict();
+  const std::string* signer_id_hex = ca_signer.FindString("id_hex");
+  const std::string* spki_base64 = ca_signer.FindString("spki_der_base64");
+
+  std::vector<uint8_t> signer_id;
+  if (!signer_id_hex || !base::HexStringToBytes(*signer_id_hex, &signer_id) ||
+      signer_id != config.ca_id || !spki_base64) {
+    LOG(ERROR) << "Invalid MTC Plants-05 CA signer";
+    return std::nullopt;
+  }
+
+  std::optional<std::vector<uint8_t>> spki = base::Base64Decode(*spki_base64);
+  if (!spki || spki->empty()) {
+    LOG(ERROR) << "Invalid MTC Plants-05 CA SPKI";
+    return std::nullopt;
+  }
+  config.ca_spki_der = std::move(*spki);
+
+  std::optional<MtcPlants05LabSignatureAlgorithm> signature_algorithm =
+      ParseSignatureAlgorithm(root);
+  if (!signature_algorithm) {
+    LOG(ERROR) << "Unsupported MTC Plants-05 signature algorithm";
+    return std::nullopt;
+  }
+  config.signature_algorithm = *signature_algorithm;
+
+  const std::string* min_serial_hex = root.FindString("min_serial_hex");
+  const std::string* max_serial_hex = root.FindString("max_serial_hex");
+  if (!min_serial_hex || !max_serial_hex ||
+      !ParseUint64Hex(*min_serial_hex, &config.min_serial) ||
+      !ParseUint64Hex(*max_serial_hex, &config.max_serial) ||
+      config.min_serial > config.max_serial) {
+    LOG(ERROR) << "Invalid MTC Plants-05 serial range";
+    return std::nullopt;
+  }
+
+  std::optional<int> log_number = root.FindInt("log_number");
+  if (!log_number || *log_number <= 0 ||
+      *log_number > std::numeric_limits<uint16_t>::max()) {
+    LOG(ERROR) << "Invalid MTC Plants-05 log number";
+    return std::nullopt;
+  }
+  config.log_number = static_cast<uint16_t>(*log_number);
+
+  const base::DictValue* landmark = root.FindDict("landmark");
+  if (!landmark) {
+    LOG(ERROR) << "Missing MTC Plants-05 landmark";
+    return std::nullopt;
+  }
+
+  std::optional<int> landmark_number = landmark->FindInt("number");
+  std::optional<int> tree_size = landmark->FindInt("tree_size");
+  if (!landmark_number || *landmark_number <= 0 || !tree_size ||
+      *tree_size <= 0) {
+    LOG(ERROR) << "Invalid MTC Plants-05 landmark coordinates";
+    return std::nullopt;
+  }
+
+  config.landmark_number = static_cast<uint64_t>(*landmark_number);
+  config.tree_size = static_cast<uint64_t>(*tree_size);
+
+  if (config.max_serial - config.min_serial + 1 != config.tree_size) {
+    LOG(ERROR) << "MTC Plants-05 serial range does not match tree size";
+    return std::nullopt;
+  }
+
+  const base::ListValue* subtrees = landmark->FindList("trusted_subtrees");
+  if (!subtrees || subtrees->empty()) {
+    LOG(ERROR) << "MTC Plants-05 config has no trusted subtrees";
+    return std::nullopt;
+  }
+
+  uint64_t expected_start = 0;
+  for (const base::Value& entry : *subtrees) {
+    if (!entry.is_dict()) {
+      return std::nullopt;
+    }
+
+    const base::DictValue& subtree_dict = entry.GetDict();
+    std::optional<int> start = subtree_dict.FindInt("start");
+    std::optional<int> end = subtree_dict.FindInt("end");
+    const std::string* hash_hex = subtree_dict.FindString("hash");
+
+    if (!start || !end || *start < 0 || *end <= *start ||
+        static_cast<uint64_t>(*start) != expected_start || !hash_hex) {
+      LOG(ERROR) << "Invalid MTC Plants-05 trusted subtree range";
+      return std::nullopt;
+    }
+
+    MtcPlants05LabTrustedSubtree subtree;
+    subtree.start = static_cast<uint64_t>(*start);
+    subtree.end = static_cast<uint64_t>(*end);
+
+    if (!base::HexStringToSpan(*hash_hex, subtree.hash)) {
+      LOG(ERROR) << "Invalid MTC Plants-05 trusted subtree hash";
+      return std::nullopt;
+    }
+
+    expected_start = subtree.end;
+    config.trusted_subtrees.push_back(std::move(subtree));
+  }
+
+  if (expected_start != config.tree_size) {
+    LOG(ERROR) << "MTC Plants-05 trusted subtrees do not cover tree";
+    return std::nullopt;
+  }
+
+  const std::string* merkle_hash = root.FindString("merkle_hash");
+  if (!merkle_hash || *merkle_hash != "SHA-256") {
+    LOG(ERROR) << "Unsupported MTC Plants-05 Merkle hash";
+    return std::nullopt;
+  }
+
+  return config;
+}
+
+}  // namespace
+
+std::optional<MtcPlants05LabConfig> LoadMtcPlants05LabConfig(
+    const base::FilePath& path) {
+  // This is an explicitly opt-in laboratory-only configuration. Keep the
+  // synchronous file read isolated here; production trust configuration must
+  // not depend on this path.
+  base::ScopedAllowBlockingForTesting allow_blocking;
+
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    LOG(ERROR) << "Unable to read MTC Plants-05 lab config: " << path;
+    return std::nullopt;
+  }
+
+  return ParseConfig(json);
+}
+
+std::optional<MtcPlants05LabConfig> LoadMtcPlants05LabConfigFromCommandLine() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+
+  if (!command_line->HasSwitch(switches::kMtcPlants05Trust)) {
+    return std::nullopt;
+  }
+
+  base::FilePath path =
+      command_line->GetSwitchValuePath(switches::kMtcPlants05Trust);
+  if (path.empty()) {
+    LOG(ERROR) << "--" << switches::kMtcPlants05Trust << " requires a path";
+    return std::nullopt;
+  }
+
+  return LoadMtcPlants05LabConfig(path);
+}
+
+}  // namespace net
