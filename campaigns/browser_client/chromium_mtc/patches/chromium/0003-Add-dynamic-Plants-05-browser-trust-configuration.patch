+    if (!config) {
+      LOG(ERROR) << "MTC Plants-05 lab enabled without a valid trust config";
+    } else {
+      std::optional<bssl::SignatureAlgorithm> signature_algorithm =
+          MtcPlants05LabSignatureAlgorithmToBsslSignatureAlgorithm(
+              config->signature_algorithm);
+
+      if (!signature_algorithm) {
+        LOG(ERROR) << "Unsupported MTC Plants-05 lab signature algorithm";
+      } else {
+        auto ca_key = x509_util::CreateCryptoBuffer(config->ca_spki_der);
+
+        if (!ca_key) {
+          LOG(ERROR) << "Unable to create MTC Plants-05 CA key buffer";
+        } else {
+          std::vector<bssl::TrustedSubtree> subtrees;
+          subtrees.reserve(config->trusted_subtrees.size());
+
+          for (const auto& source_subtree : config->trusted_subtrees) {
+            bssl::TrustedSubtree subtree;
+            subtree.range.start = source_subtree.start;
+            subtree.range.end = source_subtree.end;
+            base::span(subtree.hash).copy_from(source_subtree.hash);
+            subtrees.push_back(std::move(subtree));
+          }
+
+          std::vector<bssl::LogTrustedSubtrees> trusted_subtrees;
+          trusted_subtrees.emplace_back(config->log_number,
+                                        std::move(subtrees));
+
+          auto mtc_anchor = std::make_shared<const bssl::MTCAnchor>(
+              bssl::MTCAnchor::kPlants05, bssl::MakeSpan(config->ca_id),
+              *signature_algorithm, std::move(ca_key), config->min_serial,
+              config->max_serial, std::move(trusted_subtrees));
+
+          if (!mtc_anchor->IsValid()) {
+            LOG(ERROR) << "Invalid MTC Plants-05 lab trust anchor";
+          } else if (!trust_store_.AddMTCTrustAnchor(std::move(mtc_anchor))) {
+            LOG(ERROR) << "Unable to install MTC Plants-05 lab trust anchor";
+          }
+        }
+      }
+    }
+  }
+
   disable_mtc_mirroring_requirements_ =
       root_store_data.disable_mtc_mirroring_requirements();
 
