+std::optional<bssl::SignatureAlgorithm>
+MtcPlants05LabSignatureAlgorithmToBsslSignatureAlgorithm(
+    MtcPlants05LabSignatureAlgorithm signature_algorithm) {
+  switch (signature_algorithm) {
+    case MtcPlants05LabSignatureAlgorithm::kEcdsaSha256:
+      return bssl::SignatureAlgorithm::kEcdsaSha256;
+    case MtcPlants05LabSignatureAlgorithm::kEcdsaSha384:
+      return bssl::SignatureAlgorithm::kEcdsaSha384;
+    case MtcPlants05LabSignatureAlgorithm::kEcdsaSha512:
+      return bssl::SignatureAlgorithm::kEcdsaSha512;
+    case MtcPlants05LabSignatureAlgorithm::kMldsa44:
+      return bssl::SignatureAlgorithm::kMldsa44;
+    case MtcPlants05LabSignatureAlgorithm::kMldsa65:
+      return bssl::SignatureAlgorithm::kMldsa65;
+    case MtcPlants05LabSignatureAlgorithm::kMldsa87:
+      return bssl::SignatureAlgorithm::kMldsa87;
+  }
+
+  return std::nullopt;
+}
+
 }  // namespace
 
 ChromeRootCertConstraints::ChromeRootCertConstraints() = default;
@@ -473,6 +495,57 @@ TrustStoreChrome::TrustStoreChrome(
     }
   }
 
+  // MTC Plants-05 lab trust anchor configuration is deliberately loaded
+  // separately from Chrome Root Store signer and metadata state.
