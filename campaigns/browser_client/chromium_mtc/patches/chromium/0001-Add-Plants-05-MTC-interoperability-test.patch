+TEST_F(CertVerifyProcBuiltinTest, Plants05OpenSSLFixtureInteroperability) {
+  // External fixture generated by the MTC/OpenSSL Plants-05 laboratory:
+  // ECDSA-P256, SHA-256, N=16, log number 1, landmark-relative certificate.
+  constexpr uint8_t kMtcCaId[] = {0x81, 0xfd, 0x59, 0x65};
+  constexpr uint16_t kLogNumber = 1;
+  constexpr uint64_t kMinSerial = 0x0001000000000000ULL;
+  constexpr uint64_t kMaxSerial = 0x000100000000000fULL;
+
+  scoped_refptr<X509Certificate> chain = ImportCertFromFile(
+      GetTestCertsDirectory(),
+      "mtc-plants05-ecdsa-p256-n16-landmark-0000.der");
+  ASSERT_TRUE(chain);
+
+  auto ca_spki = base::ReadFileToBytes(
+      GetTestCertsDirectory().AppendASCII(
+          "mtc-plants05-ecdsa-p256-ca.spki"));
+  ASSERT_TRUE(ca_spki);
+
+  auto ca_key = x509_util::CreateCryptoBuffer(*ca_spki);
+  ASSERT_TRUE(ca_key);
+
+  std::vector<bssl::TrustedSubtree> subtrees;
+
+  {
+    bssl::TrustedSubtree subtree;
+    subtree.range.start = 0;
+    subtree.range.end = 8;
+    subtree.hash = {
+        0x71, 0x6e, 0x02, 0xed, 0x3d, 0xd7, 0x11, 0x93,
+        0x16, 0x83, 0xf0, 0xd1, 0xa2, 0xdd, 0xc4, 0x96,
+        0xd2, 0x9e, 0xe6, 0x47, 0xcc, 0xdb, 0xf7, 0x7a,
+        0xa7, 0xb2, 0xf0, 0x2f, 0x8d, 0x07, 0xd8, 0xf6,
+    };
+    subtrees.push_back(std::move(subtree));
+  }
+
+  {
+    bssl::TrustedSubtree subtree;
+    subtree.range.start = 8;
+    subtree.range.end = 16;
+    subtree.hash = {
+        0xe5, 0x83, 0xcf, 0xf6, 0x75, 0x47, 0x5a, 0xc3,
+        0x52, 0xa9, 0x17, 0x14, 0x4f, 0x81, 0xdf, 0x5f,
+        0xc0, 0x21, 0xe1, 0x30, 0xb0, 0x6f, 0xd9, 0x2f,
+        0x01, 0xe1, 0x15, 0xa9, 0xfb, 0xc8, 0x3f, 0xf6,
+    };
+    subtrees.push_back(std::move(subtree));
+  }
+
+  std::vector<bssl::LogTrustedSubtrees> trusted_subtrees;
+  trusted_subtrees.emplace_back(kLogNumber, std::move(subtrees));
+
+  auto mtc_anchor = std::make_shared<const bssl::MTCAnchor>(
+      bssl::MTCAnchor::kPlants05, kMtcCaId,
+      bssl::SignatureAlgorithm::kEcdsaSha256, std::move(ca_key),
+      kMinSerial, kMaxSerial, std::move(trusted_subtrees));
+
+  ASSERT_TRUE(mtc_anchor->IsValid());
+  EXPECT_EQ(mtc_anchor->spec_version(), bssl::MTCAnchor::kPlants05);
+  EXPECT_TRUE(mtc_anchor->IsSerialInRange(kMinSerial));
+
+  // Verify the external fixture at a time within its validity interval.
+  InitializeVerifyProc(
+      CreateParams(/*additional_trust_anchors=*/{}),
+      base::Time::FromMillisecondsSinceUnixEpoch(1790251200000));
+
+  bssl::TrustStoreInMemory trust_store;
+  ASSERT_TRUE(trust_store.AddMTCTrustAnchor(mtc_anchor));
+  AddTrustStore(&trust_store);
+
+  SetMockIsKnownRoot(false);
+  SetMockIsKnownMtcAnchor(false);
+
+  CertVerifyResult verify_result;
+  NetLogSource verify_net_log_source;
+  TestCompletionCallback callback;
+
+  Verify(chain.get(), "server", /*flags=*/0, &verify_result,
+         &verify_net_log_source, callback.callback());
+
+  int error = callback.WaitForResult();
+  EXPECT_THAT(error, IsOk());
+
+  ASSERT_EQ(2u, verify_result.verified_cert->cert_buffers().size());
+  EXPECT_TRUE(chain->EqualsExcludingChain(verify_result.verified_cert.get()));
+  EXPECT_TRUE(x509_util::CryptoBufferEqual(
+      mtc_anchor->AsCert()->cert_buffer(),
+      verify_result.verified_cert->cert_buffers()[1].get()));
+  EXPECT_FALSE(verify_result.is_issued_by_known_root);
+}
