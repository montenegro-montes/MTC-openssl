 net/cert/cert_verify_proc_builtin_unittest.cc | 13 +++++
 net/cert/internal/system_trust_store.cc       | 17 ++++++
 net/cert/internal/system_trust_store.h        |  8 +++
 net/cert/internal/trust_store_chrome.cc       | 56 ++++++++++++++++++-
 net/cert/internal/trust_store_chrome.h        | 13 +++++
 .../internal/trust_store_chrome_unittest.cc   | 13 ++++-
 net/cert/mtc_plants07_lab_config.cc           | 25 ++++++++-
 net/cert/mtc_plants07_lab_config.h            |  7 +++
 net/cert/mtc_plants07_lab_config_unittest.cc  | 12 +++-
 10 files changed, 193 insertions(+), 6 deletions(-)

diff --git a/net/cert/cert_verify_proc_builtin.cc b/net/cert/cert_verify_proc_builtin.cc
index b3efc41506..d9268df0a4 100644
--- a/net/cert/cert_verify_proc_builtin.cc
+++ b/net/cert/cert_verify_proc_builtin.cc
@@ -391,6 +391,22 @@ class CertVerifyProcTrustStore {
     return system_trust_store_->GetMtcMirrorKey(cosigner_id);
   }
 
+  std::optional<bssl::VerifyCertificateChainDelegate::MTCCosigner>
+  GetLabMtcCosignerKey(base::span<const uint8_t> cosigner_id) const {
+    return system_trust_store_->GetLabMtcCosignerKey(cosigner_id);
+  }
+
+  bool IsLabMtcAnchor(const bssl::MTCAnchor* anchor) const {
+    return system_trust_store_->IsLabMtcAnchor(anchor);
+  }
+
+  bool IsLabMtcCosignerPolicySatisfied(
+      const bssl::MTCAnchor* anchor,
+      base::span<const std::vector<uint8_t>> valid_additional_cosigners) const {
+    return system_trust_store_->IsLabMtcCosignerPolicySatisfied(
+        anchor, valid_additional_cosigners);
+  }
+
   bool IsMtcCosignerPolicySatisfied(
       const bssl::ParsedCertificate& target_cert,
       base::Time current_time,
@@ -527,6 +543,20 @@ class PathBuilderDelegateImpl : public bssl::SimplePathBuilderDelegate {
       const bssl::MTCAnchor* mtc_anchor,
       std::vector<std::vector<uint8_t>> valid_additional_cosigners) override {
     CHECK(mtc_anchor);
+#if BUILDFLAG(CHROME_ROOT_STORE_SUPPORTED)
+    if (trust_store_->IsLabMtcAnchor(mtc_anchor)) {
+      const bool is_valid = trust_store_->IsLabMtcCosignerPolicySatisfied(
+          mtc_anchor, valid_additional_cosigners);
+      net_log_->AddEvent(net::NetLogEventType::CERT_MTC_COSIGNER_POLICY_CHECKED,
+                         [&] {
+                           base::DictValue dict;
+                           dict.Set("is_valid", is_valid);
+                           dict.Set("reason", "lab standalone signer policy");
+                           return dict;
+                         });
+      return is_valid;
+    }
+#endif
     if (!trust_store_->IsKnownMtcAnchor(mtc_anchor)) {
       // Cosigner policy only applies to publicly trusted MTCs, only a valid CA
       // signature is required for private PKIs.
@@ -552,7 +582,10 @@ class PathBuilderDelegateImpl : public bssl::SimplePathBuilderDelegate {
   std::optional<bssl::VerifyCertificateChainDelegate::MTCCosigner>
   GetMTCCosigner(bssl::Span<const uint8_t> cosigner_id) override {
 #if BUILDFLAG(CHROME_ROOT_STORE_SUPPORTED)
-    return trust_store_->GetMtcMirrorKey(cosigner_id);
+    if (auto mirror = trust_store_->GetMtcMirrorKey(cosigner_id)) {
+      return mirror;
+    }
+    return trust_store_->GetLabMtcCosignerKey(cosigner_id);
 #else
     return std::nullopt;
 #endif
