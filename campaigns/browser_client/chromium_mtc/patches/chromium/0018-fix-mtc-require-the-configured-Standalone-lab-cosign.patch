diff --git a/net/cert/internal/trust_store_chrome.cc b/net/cert/internal/trust_store_chrome.cc
index cd3e84405c..9c9a041936 100644
--- a/net/cert/internal/trust_store_chrome.cc
+++ b/net/cert/internal/trust_store_chrome.cc
@@ -4,6 +4,7 @@
 
 #include "net/cert/internal/trust_store_chrome.h"
 
+#include <algorithm>
 #include <optional>
 
 #include "base/command_line.h"
@@ -527,9 +528,11 @@ TrustStoreChrome::TrustStoreChrome(
         LOG(ERROR) << "Unsupported MTC Plants-07 lab signature algorithm";
       } else {
         auto ca_key = x509_util::CreateCryptoBuffer(config->ca_spki_der);
+        auto additional_cosigner_key = x509_util::CreateCryptoBuffer(
+            config->additional_cosigner.spki_der);
 
-        if (!ca_key) {
-          LOG(ERROR) << "Unable to create MTC Plants-07 CA key buffer";
+        if (!ca_key || !additional_cosigner_key) {
+          LOG(ERROR) << "Unable to create MTC Plants-07 signer key buffer";
         } else {
           std::vector<bssl::TrustedSubtree> subtrees;
           subtrees.reserve(config->trusted_subtrees.size());
@@ -558,6 +561,16 @@ TrustStoreChrome::TrustStoreChrome(
                 << "MTC Plants-07 lab CA ID conflicts with public trust anchor";
           } else if (!trust_store_.AddMTCTrustAnchor(std::move(mtc_anchor))) {
             LOG(ERROR) << "Unable to install MTC Plants-07 lab trust anchor";
+          } else if (config->trust_mode ==
+                     MtcPlants07LabTrustMode::kStandalone) {
+            Signer additional_cosigner;
+            additional_cosigner.base_id = config->additional_cosigner.id;
+            additional_cosigner.key = std::move(additional_cosigner_key);
+            additional_cosigner.signature_algorithm = *signature_algorithm;
+            lab_mtc_ca_id_ = config->ca_id;
+            lab_mtc_required_cosigner_id_ =
+                config->additional_cosigner.id;
+            lab_mtc_cosigner_ = std::move(additional_cosigner);
           }
         }
       }
@@ -862,6 +875,45 @@ TrustStoreChrome::GetMtcMirrorKey(base::span<const uint8_t> cosigner_id) const {
       it->second.signature_algorithm, bssl::UpRef(it->second.key.get())};
 }
 
+std::optional<bssl::VerifyCertificateChainDelegate::MTCCosigner>
+TrustStoreChrome::GetLabMtcCosignerKey(
+    base::span<const uint8_t> cosigner_id) const {
+  if (!lab_mtc_cosigner_ ||
+      !std::equal(lab_mtc_cosigner_->base_id.begin(),
+                  lab_mtc_cosigner_->base_id.end(), cosigner_id.begin(),
+                  cosigner_id.end())) {
+    return std::nullopt;
+  }
+  return bssl::VerifyCertificateChainDelegate::MTCCosigner{
+      lab_mtc_cosigner_->signature_algorithm,
+      bssl::UpRef(lab_mtc_cosigner_->key.get())};
+}
+
+bool TrustStoreChrome::IsLabMtcAnchor(
+    const bssl::MTCAnchor* anchor) const {
+  return anchor && lab_mtc_ca_id_ &&
+         anchor->ca_id().size() == lab_mtc_ca_id_->size() &&
+         std::equal(anchor->ca_id().begin(), anchor->ca_id().end(),
+                    lab_mtc_ca_id_->begin(), lab_mtc_ca_id_->end());
+}
+
+bool TrustStoreChrome::IsLabMtcCosignerPolicySatisfied(
+    const bssl::MTCAnchor* anchor,
+    base::span<const std::vector<uint8_t>> valid_additional_cosigners) const {
+  if (!IsLabMtcAnchor(anchor) || !lab_mtc_required_cosigner_id_) {
+    return false;
+  }
+  for (const auto& cosigner_id : valid_additional_cosigners) {
+    if (cosigner_id.size() == lab_mtc_required_cosigner_id_->size() &&
+        std::equal(cosigner_id.begin(), cosigner_id.end(),
+                   lab_mtc_required_cosigner_id_->begin(),
+                   lab_mtc_required_cosigner_id_->end())) {
+      return true;
+    }
+  }
+  return false;
+}
+
