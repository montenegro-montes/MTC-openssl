   // `mtc_anchor` and valid co-signatures from the mirrors with cosigner IDs
@@ -576,6 +585,10 @@ class NET_EXPORT TrustStoreChrome : public bssl::TrustStore {
       signer_set_mirrors_;
   bool disable_mtc_mirroring_requirements_ = false;
 
+  std::optional<std::vector<uint8_t>> lab_mtc_ca_id_;
+  std::optional<std::vector<uint8_t>> lab_mtc_required_cosigner_id_;
+  std::optional<Signer> lab_mtc_cosigner_;
+
   std::optional<base::Time> mtc_metadata_update_time_;
 };
 
