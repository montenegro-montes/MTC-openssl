+  uint64_t crypto_ns = 0;
+  uint64_t crypto_count = 0;
+  uint64_t cache_ns = 0;
+  uint64_t cache_hits = 0;
+  uint64_t cache_misses = 0;
+  bool crypto_overflow = false;
+  bool cache_overflow = false;
+};
