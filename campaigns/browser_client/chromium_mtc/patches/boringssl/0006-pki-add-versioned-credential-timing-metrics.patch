 namespace {
 
+class ScopedNanosecondTimer {
+ public:
+  explicit ScopedNanosecondTimer(std::optional<uint64_t> *result)
+      : result_(result), start_(std::chrono::steady_clock::now()) {}
+
+  ~ScopedNanosecondTimer() { Stop(); }
+
+  void Stop() {
+    if (!result_) {
+      return;
+    }
+    *result_ = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                   std::chrono::steady_clock::now() - start_)
+                   .count();
+    result_ = nullptr;
+  }
+
+ private:
+  std::optional<uint64_t> *result_;
+  std::chrono::steady_clock::time_point start_;
+};
