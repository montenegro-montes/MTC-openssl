 namespace {
 
+void AccumulateDuration(uint64_t elapsed_ns, uint64_t *total,
+                        bool *overflow) {
+  if (*overflow) {
+    return;
+  }
+  if (elapsed_ns > std::numeric_limits<uint64_t>::max() - *total) {
+    *overflow = true;
+    return;
+  }
+  *total += elapsed_ns;
+}
+
+void IncrementCounter(uint64_t *counter, bool *overflow) {
+  if (*overflow) {
+    return;
+  }
+  if (*counter == std::numeric_limits<uint64_t>::max()) {
+    *overflow = true;
+    return;
+  }
+  ++*counter;
+}
+
