From 93db006d6250626ac73e7dca6065b00a65cf8e4d Mon Sep 17 00:00:00 2001
From: Jose Antonio Montenegro Montes <jmmontes@uma.es>
Date: Thu, 15 Oct 2026 10:44:30 +0200
Subject: [PATCH 7/7] ssl: enable ECDSA P-521 signature verification by default

---
 ssl/extensions.cc                            |  1 +
 ssl/ssl_test.cc                              | 10 +++++-----
 ssl/test/runner/signature_algorithm_tests.go |  2 +-
 3 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index 954af18..d8a9a86 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -294,6 +294,7 @@ static const uint16_t kVerifySignatureAlgorithms[] = {
     SSL_SIGN_RSA_PSS_RSAE_SHA384,
     SSL_SIGN_RSA_PKCS1_SHA384,
 
+    SSL_SIGN_ECDSA_SECP521R1_SHA512,
     SSL_SIGN_RSA_PSS_RSAE_SHA512,
     SSL_SIGN_RSA_PKCS1_SHA512,
 
diff --git a/ssl/ssl_test.cc b/ssl/ssl_test.cc
index 5137d3a..e923268 100644
--- a/ssl/ssl_test.cc
+++ b/ssl/ssl_test.cc
@@ -4189,18 +4189,18 @@ TEST(SSLTest, ClientHello) {
         0x0a, 0x00, 0x08, 0x00, 0x06, 0x00, 0x1d, 0x00, 0x17, 0x00, 0x18, 0x00,
         0x0b, 0x00, 0x02, 0x01, 0x00, 0x00, 0x23, 0x00, 0x00}},
       {TLS1_2_VERSION,
-       {0x16, 0x03, 0x01, 0x00, 0x80, 0x01, 0x00, 0x00, 0x7c, 0x03, 0x03, 0x00,
+       {0x16, 0x03, 0x01, 0x00, 0x82, 0x01, 0x00, 0x00, 0x7e, 0x03, 0x03, 0x00,
         0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
         0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
         0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x1c, 0xcc, 0xa9,
         0xcc, 0xa8, 0xc0, 0x2b, 0xc0, 0x2f, 0xc0, 0x2c, 0xc0, 0x30, 0xc0, 0x09,
         0xc0, 0x13, 0xc0, 0x0a, 0xc0, 0x14, 0x00, 0x9c, 0x00, 0x9d, 0x00, 0x2f,
-        0x00, 0x35, 0x01, 0x00, 0x00, 0x37, 0x00, 0x17, 0x00, 0x00, 0xff, 0x01,
+        0x00, 0x35, 0x01, 0x00, 0x00, 0x39, 0x00, 0x17, 0x00, 0x00, 0xff, 0x01,
         0x00, 0x01, 0x00, 0x00, 0x0a, 0x00, 0x08, 0x00, 0x06, 0x00, 0x1d, 0x00,
         0x17, 0x00, 0x18, 0x00, 0x0b, 0x00, 0x02, 0x01, 0x00, 0x00, 0x23, 0x00,
-        0x00, 0x00, 0x0d, 0x00, 0x14, 0x00, 0x12, 0x04, 0x03, 0x08, 0x04, 0x04,
-        0x01, 0x05, 0x03, 0x08, 0x05, 0x05, 0x01, 0x08, 0x06, 0x06, 0x01, 0x02,
-        0x01}},
+        0x00, 0x00, 0x0d, 0x00, 0x16, 0x00, 0x14, 0x04, 0x03, 0x08, 0x04, 0x04,
+        0x01, 0x05, 0x03, 0x08, 0x05, 0x05, 0x01, 0x06, 0x03, 0x08, 0x06, 0x06,
+        0x01, 0x02, 0x01}},
       // TODO(davidben): Add a change detector for TLS 1.3 once the spec and our
       // implementation has settled enough that it won't change.
   };
diff --git a/ssl/test/runner/signature_algorithm_tests.go b/ssl/test/runner/signature_algorithm_tests.go
index bb93eb4..bccd118 100644
--- a/ssl/test/runner/signature_algorithm_tests.go
+++ b/ssl/test/runner/signature_algorithm_tests.go
@@ -124,7 +124,7 @@ func addSignatureAlgorithmTests() {
 
 				// By default, BoringSSL does not accept these algorithms.
 				verifyDefault := !shouldFail
-				if alg.id == signatureECDSAWithSHA1 || alg.id == signatureECDSAWithP521AndSHA512 || alg.id == signatureEd25519 || isTLS13PKCS1 || isMLDSA {
+				if alg.id == signatureECDSAWithSHA1 || alg.id == signatureEd25519 || isTLS13PKCS1 || isMLDSA {
 					verifyDefault = false
 				}
 
