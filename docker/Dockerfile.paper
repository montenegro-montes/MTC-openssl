ARG BASE_IMAGE=mt-tls-mtc:local
FROM ${BASE_IMAGE}
COPY campaigns/controlled_n16_campaign/patch_setup.py /opt/paper/
RUN cp -a /opt/src/openssl-mtc /opt/src/openssl-paper && \
    python3 /opt/paper/patch_setup.py /opt/src/openssl-paper && \
    cd /opt/src/openssl-paper && make -j2 apps/openssl && \
    mkdir -p /opt/openssl-paper/bin && cp apps/openssl /opt/openssl-paper/bin/openssl && \
    cp PAPER_MEASUREMENT_SHA256 /opt/openssl-paper/
COPY campaigns/controlled_n16_campaign /opt/paper
RUN chmod +x /opt/paper/openssl.sh
WORKDIR /work
