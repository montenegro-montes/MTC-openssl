FROM mt-tls-measurement:local

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       iproute2 iputils-ping iperf3 \
    && rm -rf /var/lib/apt/lists/*

COPY campaigns/historical_campaigns/network_latency /opt/network-latency
RUN chmod +x /opt/network-latency/client.sh
