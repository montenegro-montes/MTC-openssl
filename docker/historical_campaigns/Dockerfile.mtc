FROM mt-tls-profile:local
COPY src/mtc/mtc.c src/mtc/mtc.h src/mtc/tls.c src/mtc/openssl.sh /opt/mtc/
COPY src/mtc/patch_legacy_compact.py /opt/mtc/patch.py
RUN cp -a /opt/src/openssl-profile /opt/src/openssl-mtc && \
    python3 /opt/mtc/patch.py /opt/src/openssl-mtc && \
    cd /opt/src/openssl-mtc && perl configdata.pm --reconfigure && make -j2 apps/openssl && \
    mkdir -p /opt/openssl-mtc/bin && cp apps/openssl /opt/openssl-mtc/bin/ && \
    cp -a /opt/openssl-profile/lib /opt/openssl-mtc/lib && cp MTC_SHA256 /opt/openssl-mtc/
COPY src/mtc /opt/mtc
COPY src/mtc/patch_legacy_compact.py /opt/mtc/patch.py
RUN cc -Wall -Wextra -Werror -Wno-unused-parameter \
    -I/opt/openssl-profile/include /opt/mtc/retry_peer.c \
    -L/opt/openssl-mtc/lib -Wl,-rpath,/opt/openssl-mtc/lib \
    -lssl -lcrypto -o /opt/mtc/retry-peer
RUN chmod +x /opt/mtc/openssl.sh
WORKDIR /work
