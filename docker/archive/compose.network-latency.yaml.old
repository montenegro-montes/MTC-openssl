name: mtlatency
x-lab: &lab
  image: mt-tls-network:latency
  cap_add: [NET_ADMIN]
  volumes:
    - ./artifacts:/work:ro
    - ./artifacts/results:/work/results
  environment:
    COMPACT_BATCH: /work/compact/batch16
    MTC_BATCH: /work/mtc/batch16-v2
    PROFILE_DETAIL: "0"
    PAPER_RUN_ROOT: ${PAPER_RUN_ROOT:?Set PAPER_RUN_ROOT}
    PAPER_CAMPAIGN_ID: ${PAPER_CAMPAIGN_ID:?Set PAPER_CAMPAIGN_ID}
    PAPER_SEED: ${PAPER_SEED:?Set PAPER_SEED}
    NETWORK_HALF_DELAY_MS: ${NETWORK_HALF_DELAY_MS:-0}
services:
  server:
    <<: *lab
    command: ["python3", "/opt/paper/serve.py"]
    healthcheck:
      test: ["CMD", "test", "-f", "/tmp/paper-ready"]
      interval: 2s
      timeout: 2s
      retries: 30
  client:
    <<: *lab
    command: ["/opt/network-latency/client.sh"]
